{"3":{"siraj":[["ذِي الطَّوْلِ","صَاحِبِ الإِنْعَامِ وَالتَّفَضُّلِ."],["الْمَصِيرُ","المَرْجِعُ."]],"tibyan":[["ذِي الطَّوْلِ","أي النعم أو القدرة أو الغنى أو الخير أو المنّ أو الفضل، أقوال."]]},"4":{"siraj":[["فَلَا يَغْرُرْكَ","فَلَا يَخْدَعْكَ."],["تَقَلُّبُهُمْ","تَنَقُّلُهُمْ وَتَرَدُّدُهُمْ بِأَنْوَاعِ التِّجَارَاتِ وَالنَّعِيمِ."]],"tibyan":[["فَلا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلادِ","تصرّفهم فيها للتّجارة وأمنهم وخروجهم من بلد إلى بلد فإن الله- عز وجل- محيط بهم."]]},"5":{"siraj":[["وَالْأَحْزَابُ","الأُمَمُ المُتَحَزِّبَةُ عَلَى رُسُلِهِمْ، مُعْلِنِينَ الحَرْبَ عَلَيْهِمْ."],["لِيَاخُذُوهُ","لِيَقْتُلُوهُ."],["لِيُدْحِضُوا","لِيُبْطِلُوا."]],"tibyan":[["لِيُدْحِضُوا بِهِ الْحَقَّ","أي ليزيلوا به الحق ويذهبوا به. ودحض هو:أي زلّ. ويقال: مكان دحض: أي منزل مزلق لا يثبت فيه قدم ولا حافر."]]},"6":{"siraj":[["حَقَّتْ","وَجَبَتْ."]],"tibyan":[["حَقَّتْ","وجبت."]]},"7":{"siraj":[["سَبِيلَكَ","طَرِيقَكَ؛ وَهُوَ الإِسْلَامُ."],["وَقِهِمْ","جَنِّبْهُمْ."]]},"9":{"siraj":[["وَقِهِمُ السَّيِّئَاتِ","اصْرِفْ عَنْهُمْ سُوءَ عَاقِبَةِ سَيِّئَاتِهِمْ."]]},"10":{"siraj":[["يُنَادَوْنَ","يَدْعُوهُمْ خَزَنَةُ جَهَنَّمَ."],["لَمَقْتُ اللَّهِ","المَقْتُ: البُغْضُ الشَّدِيدُ."]]},"11":{"siraj":[["أَمَتَّنَا اثْنَتَيْنِ","مَرَّةً قَبْلَ نَفْخِ الأَرْوَاحِ فيِ الأَجِنَّةِ، وَمَرَّةً حِينَ انْقَضَى أَجَلُنَا."],["وَأَحْيَيْتَنَا اثْنَتَيْنِ","مَرَّةً فيِ الدُّنْيَا، وَمَرَّةً فيِ الآخِرَةِ."],["سَبِيلٍ","طَرِيقٍ نَخْرُجُ بِهِ مِنَ النَّارِ."]],"tibyan":[["أَمَتَّنَا اثْنَتَيْنِ وَأَحْيَيْتَنَا اثْنَتَيْنِ","مثل قوله: وَكُنْتُمْ أَمْواتاً فَأَحْياكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ فالموتة الأولى: كونهم نطفا في أصلاب آبائهم لأن النّطفة ميّتة. والحياة الأولى: إحياء الله إيّاهم من النّطفة. والموتة الثانية: إماتة الله إياهم بعد الحياة. والحياة الثانية: إحياء الله إياهم للبعث، فهاتان موتتان وحياتان.ويقال: الموتة الأولى التي تقع بهم في الدّنيا بعد الحياة، والحياة الأولى:إحياء الله- جلّت قدرته- إيّاهم في القبر لمساءلة منكر ونكير، والموتة الثانية: إماتةالله إياهم بعد المساءلة، والحياة الثانية: إحياء الله إيّاهم للبعث."]]},"13":{"siraj":[["رِزْقًا","مَطَرًا تُرْزَقُونَ بِهِ."],["يُنِيبُ","يَرْجِعُ إِلَى طَاعَةِ اللهِ."]]},"15":{"siraj":[["رَفِيعُ الدَّرَجَاتِ","ارْتَفَعَتْ دَرَجَاتُهُ ارْتِفَاعًا بَايَنَ بِهِ مَخْلُوقَاتِهِ، وَارْتَفَعَ بِهِ قَدْرُهُ."],["يُلْقِي الرُّوحَ","يُنْزِلُ الوَحْيَ."],["يَوْمَ التَّلَاقِ","اليَوْمَ الَّذِي يَلْتَقِي فِيهِ الأَوَّلُونَ وَالآخِرُونَ."]],"tibyan":[["يَوْمَ التَّلاقِ","يوم الالتقاء، أي يوم يلتقي أهل الأرض وأهل السماء."]]},"16":{"siraj":[["بَارِزُونَ","ظَاهِرُونَ أَمَامَ رَبِّهِمْ."]]},"18":{"siraj":[["يَوْمَ الْآزِفَةِ","يَوْمَ القِيَامَةِ القَرِيبَ."],["لَدَى الْحَنَاجِرِ","قُلُوبُهُمْ عِنْدَ حُلُوقِهِمْ مِنْ شِدَّةِ الكَرْبِ."],["كَاظِمِينَ","مُمْتَلِئِينَ غَمًّا، وَحُزْنًا."],["حَمِيمٍ","قَرِيبٍ، وَصَاحِبٍ."]],"tibyan":[["يَوْمَ الْآزِفَةِ","يوم القيامة. وأزف الشيء: دنا. وقيل: يوم الموت يوم خروج [الرّوح] ."]]},"19":{"siraj":[["خَائِنَةَ الْأَعْيُنِ","مَا تَخْتَلِسُهُ العُيُونُ مِنَ النَّظَرِ إِلَى مَا لَا يَحِلُّ."]]},"20":{"siraj":[["يَقْضِي بِالْحَقِّ","يَحْكُمُ بِالعَدْلِ."]]},"21":{"siraj":[["وَاقٍ","دَافِعٍ."]]},"23":{"siraj":[["وَسُلْطَانٍ مُّبِينٍ","حُجَّةٍ بَيِّنَةٍ عَلَى صِدْقِهِ."]]},"25":{"siraj":[["ضَلَالٍ","هَلَاكٍ، وَذَهَابٍ."]]},"27":{"siraj":[["عُذْتُ","اسْتَجَرْتُ."]]},"28":{"siraj":[["مُسْرِفٌ","مُتَجَاوِزٌ لِلْحَدِّ بِتَرْكِ الحَقِّ، وَاتِّبَاعِ البَاطِلِ."]]},"29":{"siraj":[["ظَاهِرِينَ","غَالِبِينَ عَالِينَ."],["بَاسِ اللَّهِ","عَذَابِ اللهِ."],["مَا أُرِيكُمْ","مَا أُشِيرُ عَلَيْكُمْ."],["أَهْدِيكُمْ","أَدْعُوكُمْ."],["سَبِيلَ الرَّشَادِ","طَرِيقَ الحَقِّ وَالصَّوَابِ."]]},"30":{"siraj":[["الْأَحْزَابِ","الأُمَمِ المُتَحَزِّبَةِ عَلَى أَنْبِيَائِهَا، المُعَادِيَةِ لِهُمْ."]]},"31":{"siraj":[["دَابِ قَوْمِ نُوحٍ","عَادَتِهِمْ فيِ الكُفْرِ وَالتَّكْذِيبِ."]]},"32":{"siraj":[["يَوْمَ التَّنَادِ","يَوْمَ القِيَامَةِ الَّذِي يُنَادِي النَّاسُ فِيهِ بَعْضُهُمْ بَعْضًا."]],"tibyan":[["يَوْمَ التَّنادِ","يوم يتنادى فيه أهل الجنّة وأهل النار وينادي أصحاب الأعراف رجالا يعرفونهم بسيماهم. والتَّنادِ بتشديد الدال، من ندّ البعير إذا مضى على وجهه."]]},"33":{"siraj":[["مُدْبِرِينَ","هَارِبِينَ."],["عَاصِمٍ","مَانِعٍ يَمْنَعُكُمْ."]]},"34":{"siraj":[["شَكٍّ","رِيبَةٍ."],["هَلَكَ","مَاتَ."],["مُسْرِفٌ","مُتَجَاوِزٌ لِلْحَدِّ فيِ الضَّلَالِ."],["مُّرْتَابٌ","شَاكٌّ فيِ اللهِ."]]},"35":{"siraj":[["سُلْطَانٍ","حُجَّةٍ."],["يَطْبَعُ","يَخْتِمُ."]]},"36":{"siraj":[["صَرْحًا","بِنَاءً عَظِيمًا."],["أَسْبَابَ السَّمَوَاتِ","أَبْوَابَ السَّمَوَاتِ، وَمَا يُوصِلُنِي إِلَيْهَا."]]},"37":{"siraj":[["السَّبِيلِ","طَرِيقِ الحَقِّ."],["كَيْدُ فِرْعَوْنَ","تَدْبِيرُهُ، وَاحْتِيَالُهُ."],["تَبَابٍ","خَسَارٍ، وَبَوَارٍ."]],"tibyan":[["أَسْبابَ السَّماواتِ","أبوابها."]]},"40":{"siraj":[["بِغَيْرِ حِسَابٍ","بِلَا نِهَايَةٍ، وَلَا تَبِعَةٍ."]]},"43":{"siraj":[["لَا جَرَمَ","حَقًّا."],["لَيْسَ لَهُ دَعْوَةٌ","لَا يَسْتَحِقُّ الدَّعْوَةَ إِلَى عِبَادَتِهِ، وَلَا يُلْجَأُ إِلَيْهِ؛ لِعَجْزِهِ."],["مَرَدَّنَا","مَرْجِعَنَا، وَمَصِيرَنَا."]]},"44":{"siraj":[["وَأُفَوِّضُ","أَعْتَصِمُ، وَأَلْجَأُ، وَأَتَوَكَّلُ."]]},"45":{"siraj":[["سَيِّئَاتِ مَا مَكَرُوا","عُقُوبَاتِ مَكْرِهِمْ مِنْ إِرَادَةِ إِهْلَاكِهِ."],["وَحَاقَ","نَزَلَ، وَأَحَاطَ."]]},"46":{"siraj":[["غُدُوًّا وَعَشِيًّا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]]},"47":{"siraj":[["يَتَحَاجُّونَ","يَتَخَاصَمُونَ."],["مُّغْنُونَ","دَافِعُونَ."]]},"50":{"siraj":[["ضَلَالٍ","ضَيَاعٍ؛ فَلَا يُقْبَلُ، وَلَا يُسْتَجَابُ."]]},"51":{"siraj":[["الْأَشْهَادُ","مَنْ يَشْهَدُونَ عَلَى المُكَذِّبِينَ؛ مِنَ المَلَائِكَةِ وَالأَنْبِيَاءِ وَالمُؤْمِنِينَ."]]},"52":{"siraj":[["مَعْذِرَتُهُمْ","عُذْرُهُمْ."],["اللَّعْنَةُ","الطَّرْدُ وَالإِبْعَادُ مِنْ رَحْمَةِ اللهِ."]]},"53":{"siraj":[["الْكِتَابَ","التَّوْرَاةَ."]]},"54":{"siraj":[["لِأُولِي الْأَلْبَابِ","لِأَصْحَابِ العُقُولِ السَّلِيمَةِ."]]},"55":{"siraj":[["وَسَبِّحْ بِحَمْدِ رَبِّكَ","نَزِّهْ رَبَّكَ وَاحْمَدْهُ."],["بِالْعَشِيِّ وَالْإِبْكَارِ","فِي آخِرِ النَّهَارِ، وَأَوَّلِهِ."]]},"56":{"siraj":[["سُلْطَانٍ","حُجَّةٍ بَيِّنَةٍ."],["إِنْ فِي","مَا فِي."],["مَّا هُم بِبَالِغِيهِ","لَيْسُوا بِوَاصِلِينَ لِلْعُلُوِّ عَلَيْكَ، وَلا لِلْفَضْلِ الَّذِي خَصَّكَ اللهُ بِهِ."],["فَاسْتَعِذْ","اعْتَصِمْ."]],"tibyan":[["إِنْ فِي صُدُورِهِمْ إِلَّا كِبْرٌ","أي تكبّر ."]]},"59":{"siraj":[["لَّا رَيْبَ فِيهَا","لَا شَكَّ فِيهَا."]]},"60":{"siraj":[["دَاخِرِينَ","صَاغِرِينَ، حَقِيرِينَ."]]},"61":{"siraj":[["لِتَسْكُنُوا","لِتَرْتَاحُوا."],["مُبْصِرًا","مُضِيئًا."]]},"62":{"siraj":[["فَأَنَّى تُؤْفَكُونَ","كَيْفَ تُصْرَفُونَ عَنِ الإِيمَانِ بِهِ؟!"]]},"63":{"siraj":[["يُؤْفَكُ","يُصْرَفُ."]]},"64":{"siraj":[["فَتَبَارَكَ","تَكَاثَرَ خَيْرُهُ وَفَضْلُهُ."]]},"66":{"siraj":[["أَنْ أُسْلِمَ","أَنْ أَخْضَعَ وَأَنْقَادَ بِالطَّاعَةِ."]]},"67":{"siraj":[["عَلَقَةٍ","الدَّمِ الغَلِيظِ؛ المُتَعَلِّقِ بِجِدَارِ الرَّحِمِ، وَهُوَ أَحَدُ أَطْوَارِ الجَنِينِ."],["لِتَبْلُغُوا أَشُدَّكُمْ","لِتَتَكَامَلَ قُوَّتُكُمْ."],["أَجَلًا مُّسَمًّى","مُدَّةً مُقَدَّرَةً تَنْتَهِي بِهَا أَعْمَارُكُمْ."]]},"69":{"siraj":[["أَنَّى يُصْرَفُونَ","كَيْفَ يَعْدِلُونَ عَنْهَا مَعْ صِحَّتِهَا؟!"]]},"70":{"siraj":[["بِالْكِتَابِ","بِالقُرْآنِ."]]},"71":{"siraj":[["وَالسَّلَاسِلُ","القُيُودُ فِي الأَرْجُلِ."]]},"72":{"siraj":[["الْحَمِيمِ","المَاءِ الَّذِي بَلَغَ غَايَةَ الحَرَارَةِ."],["يُسْجَرُونَ","يُوقَدُ عَلَيْهِمْ."]]},"74":{"siraj":[["ضَلُّوا عَنَّا","غَابُوا عَنْ عُيُونِنَا."]]},"75":{"siraj":[["تَمْرَحُونَ","تَتَوَسَّعُونَ فيِ الفَرَحِ أَشَرًا وَبَطَرًا."]],"tibyan":[["تَمْرَحُونَ","المرح: البطر. وقيل: العدوان. وقيل: الخيلاء والإعجاب."]]},"76":{"siraj":[["مَثْوَى","مَاوَى، وَمَسْكَنُ."]]},"78":{"siraj":[["قُضِيَ بِالْحَقِّ","حُكِمَ بِالعَدْلِ بَيْنَ الرُّسُلِ، وَمُكَذِّبِيهِمْ."]]},"80":{"siraj":[["حَاجَةً فِي صُدُورِكُمْ","أَمْرًا ذَا بَالٍ تَهْتَمُّونَ بِهِ."]]},"82":{"siraj":[["فَمَا أَغْنَى عَنْهُم","فَمَا دَفَعَ عَنْهُمْ."]]},"83":{"siraj":[["مِّنَ الْعِلْمِ","العِلْمِ بِالدُّنْيَا، وَبِمَا عِنْدَهُمْ مِنَ الأَبَاطِيلِ الَّتِي يّظُنُّونَهَا عِلْمًا."],["وَحَاقَ","نَزَلَ وَأَحَاطَ."]]},"84":{"siraj":[["بَاسَنَا","عَذَابَنَا."]]},"85":{"siraj":[["يَكُ","يَكُنْ."],["سُنَّتَ اللَّهِ","طَرِيَقَتَهُ فِي عَدَمِ قَبُولِ تَوْبَةِ مَنْ عَايَنَ العَذَابَ."],["خَلَتْ","مَضَتْ."]]}}