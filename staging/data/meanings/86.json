{"1":{"siraj":[["وَالطَّارِقِ","النَّجْمِ الَّذِي يَطْلُعُ لَيْلًا."]],"tibyan":[["الطَّارِقِ","هو النّجم، سمّي بذلك لأنه يطرق، أي يطلع ليلا."]]},"3":{"siraj":[["الثَّاقِبُ","المُضِيءُ المُتَوَهِّجُ."]],"tibyan":[["الثَّاقِبُ","المضيء [زه] بلغة قريش ."]]},"4":{"siraj":[["إِنْ كُلُّ نَفْسٍ لَّمَّا","مَا كُلُّ نَفْسٍ إِلَّا."],["حَافِظٌ","مَلَكٌ يَحْفَظُ أَعْمَالَهَا."]]},"6":{"siraj":[["دَافِقٍ","مُنْصَبٍّ بِسُرْعَةٍ فِي الرَّحِمِ."]]},"7":{"siraj":[["الصُّلْبِ","الظَّهْرِ."],["وَالتَّرَائِبِ","عِظَامِ الصَّدْرِ."]],"tibyan":[["التَّرائِبِ","جمع تريبة، وهي موضع القلادة من الصّدر."]]},"8":{"siraj":[["رَجْعِهِ","رَدِّهِ حَيًّا بَعْدَ المَوْتِ."]]},"9":{"siraj":[["تُبْلَى السَّرَائِرُ","تُخْتَبَرُ، وَتُكْشَفُ ضَمَائِرُ القُلُوبِ."]]},"11":{"siraj":[["ذَاتِ الرَّجْعِ","صَاحِبَةِ المَطَرِ المُتَكَرِّرِ."]],"tibyan":[["وَالسَّماءِ ذاتِ الرَّجْعِ","أي تبتدئ بالمطر، ثم ترجع به في كل عام. وقال أبو عبيدة : الرّجع: الماء، وأنشد للمتنخّل يصف السيف:أبيض كالرّجع رسوب إذا ما ثاخ في محتفل يختلي"]]},"12":{"siraj":[["ذَاتِ الصَّدْعِ","ذَاتِ التَّشَقُّقِ بِالنَّبَاتِ."],["يَصْلَى النَّارَ","يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."]],"tibyan":[["ذاتِ الصَّدْعِ","تصدع بالنّبات."]]},"13":{"siraj":[["فَصْلٌ","فَاصِلٌ بَيْنَ الحَقِّ، وَالبَاطِلِ."]]},"14":{"siraj":[["أَفْلَحَ","فَازَ، وَظَفِرَ بِالمَطْلُوبِ."],["تَزَكَّى","طَهَّرَ نَفْسَهُ مِنَ المَعَاصِي، وَحَلَّاهَا بِالطَّاعَةِ."]],"tibyan":[["بِالْهَزْلِ","أي باللّعب."],["مَنْ تَزَكَّى","تطهّر من الذّنوب بالعمل الصالح."]]},"15":{"tibyan":[["يَكِيدُونَ كَيْداً","."]]},"17":{"siraj":[["رُوَيْدًا","قَلِيلًا."]],"tibyan":[["رُوَيْداً","أي إمهالا قليلا."]]}}