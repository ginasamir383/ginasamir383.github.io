{"1":{"siraj":[["وَيْلٌ","عَذَابٌ شَدِيدٌ."],["لِّلْمُطَفِّفِينَ","الَّذِينَ يَبْخَسُونَ المِكْيَالَ، وَالمِيزَانَ."]],"tibyan":[["لِلْمُطَفِّفِينَ","الذين لا يوفّون الكيل والوزن."]]},"3":{"siraj":[["يُخْسِرُونَ","يَنْقُصُونَ فيِ المِكْيَالِ، وَالمِيزَانَ."]],"tibyan":[["كالُوهُمْ أَوْ وَزَنُوهُمْ","أي كالوا لهم ووزنوا لهم."],["يُخْسِرُونَ","أي ينقصون."]]},"4":{"siraj":[["يَظُنُّ","يَعتَقِدُ."]]},"7":{"siraj":[["كِتَابَ الفُجَّارِ","كِتَابَ أَعْمَالِهِمْ، أَوْ مَصِيرَهُمِ."],["سِجِّينٍ","سِجْنٍ، وَضِيقٍ."]],"tibyan":[["سِجِّينٍ","حبس، فعّيل من السّجن. ويقال: سجّين: صخرة تحت الأرض السابعة. يعني أنّ أعمالهم لا تصعد إلى السّماء."]]},"9":{"siraj":[["مَّرْقُومٌ","مَكْتُوبٌ كَالرَّقْمِ فِي الثَّوْبِ لَا يُمْحَى."]]},"12":{"siraj":[["مُعْتَدٍ","ظَالِمِ مُتَجَاوِزٍ لِلْحَدِّ."],["أَثِيمٍ","كَثِيرِ الإِثْمِ."]]},"13":{"siraj":[["أَسَاطِيرُ","أَبَاطِيلُ"]]},"14":{"siraj":[["رَانَ","غَطَّى."]],"tibyan":[["بَلْ رانَ عَلى قُلُوبِهِمْ ما كانُوا يَكْسِبُونَ","أي غلب على قلوبهم كسب الذّنوب كما ترين الخمر على عقل السّكران. ويقال: ران عليه النّعاس، وران به: إذا غلب عليه."]]},"15":{"siraj":[["لَّمَحْجُوبُونَ","مَحْرُومُونَ مِنْ رُؤْيَةِ رَبِّهِمْ."]]},"16":{"siraj":[["لَصَالُوا الْجَحِيمِ","لَدَاخِلُو النَّارِ يُقَاسُونَ حَرَّهَا."]]},"18":{"siraj":[["لَفِي عِلِّيِّينَ","لَفِي مَرْتَبَةٍ، وَمَكَانٍ عَالٍ."]],"tibyan":[["لَفِي عِلِّيِّينَ","أي في السّماء السابعة."]]},"20":{"tibyan":[["كِتابٌ مَرْقُومٌ","أي مكتوب [زه] أو مختوم، بلغة حمير ."]]},"23":{"siraj":[["الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِالسُّتُورِ، وَالثِّيَابِ."]]},"24":{"siraj":[["نَضْرَةَ","بَهْجَةَ."]],"tibyan":[["نَضْرَةَ النَّعِيمِ","بريق النّعيم ونداه، ومنه وُجُوهٌ يَوْمَئِذٍ ناضِرَةٌ : أي مشرقة."]]},"25":{"siraj":[["رَّحِيقٍ","خَمْرٍ صَافِيَةٍ."],["غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."]],"tibyan":[["رَحِيقٍ","الرّحيق: الخالص من الشّراب. ويقال: العتيق من الشراب."],["مَخْتُومٍ","له ختام، أي عاقبة ريح كما قال عز وجل."]]},"26":{"siraj":[["خِتَامُهُ مِسْكٌ","آخِرُهُ رَائِحَةُ المِسْكِ."]],"tibyan":[["خِتامُهُ مِسْكٌ","أي آخر طعمه وعاقبته إذا شرب أن يوجد في آخره طعم المسك ورائحته، يقال للعطّار إذا اشتري منه الطّيب: اجعل خاتمه مسكا."]]},"27":{"siraj":[["وَمِزَاجُهُ","خَلْطُهُ."],["تَسْنِيمٍ","عَيْنٍ فيِ أَعْلَى الجَنَّةِ."]],"tibyan":[["مِنْ تَسْنِيمٍ","يقال: هو أرفع شراب أهل الجنّة. ويقال: تسنيم:عين تجري من فوقهم تسنّمهم في منازلهم تنزل عليهم من عال، يقال: تسنّم الفحل الناقة إذا علاها."]]},"28":{"siraj":[["يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."]]},"30":{"siraj":[["يَتَغَامَزُونَ","يَغْمِزُ بَعْضُهُمْ بَعْضًا بِأَعْيُنِهِمُ اسْتِهْزَاءً."]]},"31":{"siraj":[["انقَلَبُوا","رَجَعُوا."],["فَكِهِينَ","مُتَلَذِّذِينَ بِسُخْرِيَتِهِمْ مِنَ المَؤْمِنِينَ."]]},"33":{"siraj":[["حَافِظِينَ","رُقَبَاءَ يُحْصُونَ أَعْمَالَهُمْ."]]},"36":{"siraj":[["ثُوِّبَ","جُوزِيَ."]],"tibyan":[["ثُوِّبَ الْكُفَّارُ","أي جوزوا."]]}}