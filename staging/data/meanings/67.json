{"1":{"siraj":[["تَبَارَكَ","تَعَالَى، وَتَعاظَمَ، وَتَكَاثَرَ خَيْرُهُ وَبِرُّهُ."]]},"2":{"siraj":[["لِيَبْلُوَكُمْ","لِيَخْتَبِرَكُمْ."],["أَحْسَنُ عَمَلًا","أَخْلَصُهُ، وَأَصْوَبُهُ."]]},"3":{"siraj":[["طِبَاقًا","بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ غَيْرِ مُمَاسَّةٍ."],["تَفَاوُتٍ","اخْتِلَافٍ، وَتَبَايُنٍ."],["فُطُورٍ","شُقُوقٍ، وَصُدُوعٍ."]],"tibyan":[["ما تَرى فِي خَلْقِ الرَّحْمنِ مِنْ تَفاوُتٍ","أي اضطراب، أو من عيب بلغة هذيل أو اختلاف. وأصله من الفوت، وهو أن يفوت شيء شيئا فيقع الخلل."],["مِنْ فُطُورٍ","أي صدوع."]]},"4":{"siraj":[["ثُمَّ ارْجِعِ الْبَصَرَ كَرَّتَيْنِ","أَعِدِ النَّظَرَ مَرَّةً بَعْدَ مَرَّةٍ."],["يَنقَلِبْ","يَرْجِعْ."],["خَاسِئًا","ذَلِيلًا صَاغِرًا."],["حَسِيرٌ","مُتْعَبٌ، كَلِيلٌ."]],"tibyan":[["حَسِيرٌ","أي كليل معي."]]},"5":{"siraj":[["رُجُومًا لِّلشَّيَاطِينِ","شُهُبًا مُحْرِقَةً لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّيَاطِينِ."],["وَأَعْتَدْنَا","أَعْدَدْنَا."]]},"6":{"siraj":[["الْمَصِيرُ","المَرْجِعُ، وَالمَآلُ."]],"tibyan":[["بِأَيِّكُمُ الْمَفْتُونُ","أي الفتنة، كما يقال: ليس له معقول، أي عقل، ويقال: معناه: أيّكم المفتون والباء زائدة كقوله:نضرب بالسّيف ونرجو بالفرج"]]},"7":{"siraj":[["شَهِيقًا","صَوْتًا مُنْكَرًا."],["تَفُورُ","تَغْلِي غَلَيَانًا شَدِيدًا."]]},"8":{"siraj":[["تَمَيَّزُ مِنَ الْغَيْظِ","تَتَمَزَّقُ مِنْ شِدَّةِ غَضَبِهَا عَلَى الكُفَّارِ."],["فَوْجٌ","جَمَاعَةٌ."],["نَذِيرٌ","رَسُولٌ يُحَذِّرُكُمْ هَذَا العَذَابَ."]],"tibyan":[["تَمَيَّزُ مِنَ الْغَيْظِ","تنشقّ، وتتميّز غيظا على الكفّار."],["فَوْجٌ","جماعة."]]},"9":{"siraj":[["إِنْ أَنتُمْ","مَا أَنْتُمْ."]]},"11":{"siraj":[["فَسُحْقًا","بَعْدًا."]],"tibyan":[["فَسُحْقاً","أي بعدا ."]]},"12":{"siraj":[["بِالْغَيْبِ","يَخْشَوْنَهُ وَهُمْ غَائِبُونَ عَنْ أَعْيُنِ النَّاسِ، وَيَخْشَوْنَ العَذَابَ قَبْلَ مُعَايَنَتِهِ."]]},"15":{"siraj":[["ذَلُولًا","سَهْلَةً، مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيْهَا."],["مَنَاكِبِهَا","نَوَاحِيهَا، وَجَوَانِبِهَا."],["وَإِلَيْهِ النُّشُورُ","إِلَيْهِ تُبْعَثُونَ مِنْ قُبُورِكُمْ لِلْجَزَاءِ وَالحِسَابِ."]]},"16":{"siraj":[["مَّن فِي السَّمَاء","اللهَ الَّذِي فِي العُلُوِّ."],["تَمُورُ","تَضْطَرِبُ بِكُمْ حَتَّى تَهْلِكُوا."]]},"17":{"siraj":[["حَاصِبًا","رِيحًا تَرْجُمُكُمْ بِالحِجَارَةِ الصَّغِيرَةِ."],["نَذِيرِ","تَحْذِيرِي لَكُمْ."]]},"18":{"siraj":[["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَتَغْيِيرُ مَا بِهِمْ مِنَ النِّعْمَةِ."]]},"19":{"siraj":[["صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهَا عِنْدَ طَيَرَانِهَا فِي الهَوَاءِ."],["وَيَقْبِضْنَ","يَضْمُمْنَهَا إِلَى جُنُوبِهَا أَحْيانًا."]],"tibyan":[["صافَّاتٍ وَيَقْبِضْنَ","أي باسطات أجنحتهنّ وقابضاتها."]]},"20":{"siraj":[["غُرُورٍ","خِدَاعٍ وَضَلَالٍ مِنَ الشَّيْطَانِ."]]},"21":{"siraj":[["لَّجُّوا","اسْتَمَرُّوا، وَتَمَادَوْا."],["عُتُوٍّ","مُعَانَدَةٍ، وَاسْتِكْبَارٍ."],["وَنُفُورٍ","شُرُودٍ وَتَبَاعُدٍ عَنِ الحَقِّ."]]},"22":{"siraj":[["مُكِبًّا","مُنَكَّسًا."],["سَوِيًّا","مُسْتَوِيًا، مُنْتَصِبَ القَامَةِ سَالِمًا."],["صِرَاطٍ مُّسْتَقِيمٍ","طَرِيقٍ وَاضِحٍ لَا اعْوِجَاجَ فِيهِ."]]},"23":{"siraj":[["أَنشَأَكُمْ","أَوْجَدَكُمْ."]]},"24":{"siraj":[["ذَرَأَكُمْ","خَلَقَكُمْ، وَنَشَرَكُمْ فِي الأَرْضِ."]]},"27":{"siraj":[["رَأَوْهُ زُلْفَةً","رَأَوْا عَذَابَ اللهِ قَرِيبًا."],["سِيئَتْ","ذَلَّتْ، وَاسْوَدَّتْ."],["تَدَّعُونَ","تَطْلُبُونَ أَنْ يُعَجَّلَ لَكُمْ مِنَ العَذَابِ اسْتِهْزَاءً."]]},"28":{"siraj":[["يُجِيرُ","يَحْمِي."]]},"30":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["غَوْرًا","ذَاهِبًا فِي الأَرْضِ لَا تَصِلُونَ إِلَيْهِ بِوَسِيلَةٍ."],["مَّعِينٍ","جَارٍ عَلَى وَجْهِ الأَرْضِ، ظَاهِرٍ لِلْعُيُونِ."]],"tibyan":[["بِماءٍ مَعِينٍ","أي جار ظاهر."]]}}