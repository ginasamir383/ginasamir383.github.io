{"5":{"siraj":[["يَتَفَطَّرْنَ","يَتَشَقَّقْنَ."]]},"6":{"siraj":[["أَولِيَاءَ","آلِهَةً يَتَوَلَّوْنَهَا، وَيَعْبُدُونَهَا."],["حَفِيظٌ","رَقِيبٌ عَتِيدٌ."]],"tibyan":[["بِوَكِيلٍ","كفيل، ويقال: كاف."]]},"7":{"siraj":[["أُمَّ الْقُرَى","مَكَّةَ؛ وَالمُرَادُ أَهْلُهَا."],["لَا رَيْبَ فِيهِ","لَا شَكَّ فيِ مَجِيئِهِ."]]},"8":{"siraj":[["أُمَّةً وَاحِدَةً","مُجْتَمِعِينَ عَلَى الهُدَى."]]},"10":{"siraj":[["وَإِلَيْهِ أُنِيبُ","إِلَيْهِ أَرْجِعُ فِي كُلِّ الأُمُورِ."]]},"11":{"siraj":[["فَاطِرُ","خَالِقُ، وَمُبْدِعُ."],["وَمِنَ الْأَنْعَامِ أَزْوَاجًا","أَنْوَاعًا؛ ذُكُورًا، وَإِنَاثًا."],["يَذْرَؤُكُمْ فِيهِ","يُكَثِّرُكُمْ؛ بِسَبَبِ التَّزْوِيجِ."]],"tibyan":[["يَذْرَؤُكُمْ","يخلقكم."],["لَيْسَ كَمِثْلِهِ شَيْءٌ","أي ليس مثله شيء. والعرب تقيم المثل مقام النفس فتقول: مثلي لا يقال له هذا، أي أنا لا يقال لي هذا."]]},"12":{"siraj":[["مَقَالِيدُ السَّمَوَاتِ","مِلْكُهَا، وَمَفَاتِيحُ خَزَائِنِهَا."],["يَبْسُطُ","يُوسِعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]]},"13":{"siraj":[["كَبُرَ","عَظُمَ."],["يَجْتَبِي إِلَيْهِ","يَصْطَفِي لِتَوْحِيدِهِ، وَدِينِهِ."],["يُنِيبُ","يَرْجعُ إِلَيْهِ بِالطَّاعَةِ."]],"tibyan":[["شَرَعَ لَكُمْ مِنَ الدِّينِ","أي فتح لكم الدين وعرّفكم طريقه."]]},"14":{"siraj":[["بَغْيًا","عِنَادًا، وَظُلْمًا."],["كَلِمَةٌ سَبَقَتْ","بِتَاخِيرِ العَذَابِ."],["الْكِتَابَ","التَّوْرَاةَ، وَالإِنْجِيلَ."],["مُرِيبٍ","مُوقِعٍ فِي الرِّيبَةِ، وَالاِخْتِلَافِ المَذْمُومِ."]]},"15":{"siraj":[["فَلِذَلِكَ فَادْعُ","قُمْ بِالدَّعْوَةِ إِلَى ذَلِكَ الدِّينِ."],["لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ","لَا جِدَالَ بَيْنَنَا وَبَيْنَكُمْ؛ بَعْدَمَا تَبَيَّنَ الحَقُّ."],["الْمَصِيرُ","المَرْجِعُ."]]},"16":{"siraj":[["يُحَاجُّونَ فِي اللَّهِ","يُخَاصِمُونَ فِي دِينِ اللهِ."],["دَاحِضَةٌ","ذَاهِبَةٌ بَاطِلَةٌ."]]},"17":{"siraj":[["بِالْحَقِّ","بِالصِّدْقِ."],["وَالْمِيزَانَ","العَدْلَ."]]},"18":{"siraj":[["مُشْفِقُونَ مِنْهَا","خَائِفُونَ مِنْ قِيَامِهَا."],["يُمَارُونَ","يُجَادِلُونَ."]]},"20":{"siraj":[["حَرْثَ الْآخِرَةِ","ثَوَابَهَا."]],"tibyan":[["حَرْثَ الْآخِرَةِ","عمل الآخرة. والحرث: الزّرع أيضا."]]},"21":{"siraj":[["كَلِمَةُ الْفَصْلِ","قَضَاؤُهُ بِإِمْهَالِهِمْ وَعَدَمِ مُعَاجَلَتِهِمْ بِالعُقُوبَةِ."]]},"23":{"siraj":[["إِلَّا الْمَوَدَّةَ فِي الْقُرْبَى","لَا تُؤْذُونِي فِي تَبْلِيغِ الدَّعْوَةِ؛ لِمَا بَيْنِي وَبَيْنَكُمْ مِنَ القَرَابَةِ."],["يَقْتَرِفْ حَسَنَةً","يَكْتَسِبْ طَاعَةً."]],"tibyan":[["يُبَشِّرُ","وو يبشر واحد."],["يَقْتَرِفْ","يكتسب."]]},"24":{"siraj":[["افْتَرَى","اخْتَلَقَ."],["يَخْتِمْ","يَطْبَعْ."]]},"27":{"siraj":[["لَبَغَوْا","لَطَغَوْا وَتَجَبَّرُوا."]]},"28":{"siraj":[["قَنَطُوا","يَئِسُوا مِنْ نُزُولِهِ."],["وَيَنشُرُ رَحْمَتَهُ","يَبْسُطُ مَطَرَهُ."],["الْوَلِيُّ","الَّذِي يَتَوَلَّى عِبَادَهُ بِإِحْسَانِهِ."]]},"29":{"siraj":[["بَثَّ","فَرَّقَ، وَنَشَرَ."],["دَابَّةٍ","مَا يَدُبُّ عَلَى الأَرْضِ؛ مِنْ إِنْسٍ، وَحَيَوَانٍ، وَغَيْرِهِمَا."]]},"31":{"siraj":[["بِمُعْجِزِينَ","بِفَائِتِينَ مِنَ العَذَابِ."]]},"32":{"siraj":[["الْجَوَارِ","السُّفُنُ الجَارِيَةُ."],["كَالْأَعْلَامِ","كَالجِبَالِ فِي عِظَمِهَا."]],"tibyan":[["الْجَوارِ فِي الْبَحْرِ كَالْأَعْلامِ","أي سفن فيه كالجبال، الواحدة جارية."]]},"33":{"siraj":[["فَيَظْلَلْنَ","يَصِرْنَ وَيَبْقَيْنَ."],["رَوَاكِدَ","ثَوَابِتَ لَا تَجْرِي."]],"tibyan":[["رَواكِدَ","سواكن."]]},"34":{"siraj":[["يُوبِقْهُنَّ","يُهْلِكِ السُّفُنَ بِالغَرَقِ."]],"tibyan":[["أَوْ يُوبِقْهُنَّ","يهلكهنّ."]]},"35":{"siraj":[["مَّحِيصٍ","مَهْرَبٍ، وَمَلْجَأٍ."]]},"37":{"siraj":[["وَالْفَوَاحِشَ","مَا عَظُمَ قُبْحُهُ مِنَ المَعَاصِي."]]},"38":{"tibyan":[["شُورى بَيْنَهُمْ","أي يتشاورون فيه."]]},"39":{"siraj":[["الْبَغْيُ","الظُّلْمُ، وَالعُدْوَانُ."],["يَنتَصِرُونَ","يَنْتَقِمُونَ مِمَّنْ بَغَى عَلَيْهِمْ؛ لِشَجَاعَتِهِمْ، وَلَا يَعْتَدُونَ."]]},"40":{"siraj":[["وَأَصْلَحَ","وَضَعَ عَفْوَهُ فِيمَنْ يُصْلِحُهُ العَفْوُ."]]},"41":{"siraj":[["سَبِيلٍ","مُؤَاخَذَةٍ."]]},"42":{"siraj":[["السَّبِيلُ","المُؤَاخَذَةُ."],["وَيَبْغُونَ","يَعْتَدُونَ."]]},"43":{"siraj":[["عَزْمِ الْأُمُورِ","الأَفْعَالِ الحَمِيدَةِ، وَالخِصَالِ المَشْكُورَةِ."]]},"44":{"siraj":[["يُضْلِلِ اللَّهُ","يَصْرِفْهُ عَنِ الهُدَى."],["مَرَدٍّ","مَرْجِعٍ إِلَى الدُّنْيَا."],["سَبِيلٍ","طَرِيقٍ."]]},"45":{"siraj":[["خَاشِعِينَ","خَاضِعِينَ مُتَضَائِلِينَ."],["يَنظُرُونَ مِن طَرْفٍ خَفِيٍّ","يُسَارِقُونَ النَّظَرَ، وَلَا يَنْظُرُونَ بِمِلْءِ أَعْيُنِهمْ."]],"tibyan":[["مِنْ طَرْفٍ خَفِيٍّ","أي لا يرفع عينيه. إنما ينظر ببعضها، أي يغضّون استكانة وذلّا."]]},"46":{"siraj":[["فَمَا لَهُ مِن سَبِيلٍ","مَا لَهُ مِنْ طَرِيقٍ يَصِلُ بِهِ إِلَى الحَقِّ فِي الدُّنْيَا."]]},"47":{"siraj":[["لَّا مَرَدَّ لَهُ","لَا يُمْكِنُ رَدُّهُ."],["نَّكِيرٍ","لَا تُنْكِرُونَ ذُنُوبَكُمْ، وَلَيْسَ لَكُمْ مَكَانٌ تَسْتَخْفُونَ وَتَتَنَكَّرُونَ فِيهِ."]]},"48":{"siraj":[["حَفِيظًا","حَافِظًا لِأَعْمَالِهِمْ."],["كَفُورٌ","جَحُودٌ؛ يُعَدِّدُ المَصَائِبَ، وَيَنْسَى النِّعَمَ."]]},"50":{"siraj":[["يُزَوِّجُهُمْ","يَجْمَعُ لَهُ النَّوْعَيْنِ."],["عَقِيمًا","لَا يُولَدُ لَهُ."]]},"51":{"siraj":[["وَحْيًا","إِعْلَامًا فِي المَنَام، أَوْ بِالإِلْهَامِ."],["مِن وَرَاءِ حِجَابٍ","كَمَا كَلَّمَ مُوسَى - عليه السلام -."],["رَسُولًا","هُوَ: جِبْرِيلُ - عليه السلام -."]]},"52":{"siraj":[["رُوحًا","قُرْآنًا، سُمِّيَ القُرْآنُ رُوحًا؛ لِأَنَّهُ حَيَاةُ القُلُوبِ."],["صِرَاطٍ مُّسْتَقِيمٍ","هُوَ: الإِسْلَامُ."]]},"53":{"siraj":[["تَصِيرُ","تَرْجِعُ إِلَيْهِ، فَيُجَازِيكُمْ عَلَيْهَا."]]}}