{"1":{"siraj":[["مُنفَكِّينَ","تَارِكِينَ كُفْرَهُمْ."],["الْبَيِّنَةُ","العَلَامَةُ الَّتِي وُعِدُوا بِهَا فِي الكُتُبِ السَّابِقَةِ."]],"tibyan":[["لَمْ يَكُنِ الَّذِينَ","يعني يزل الذين، بلغة قريش ."],["مُنْفَكِّينَ","زائلين."]]},"2":{"siraj":[["رَسُولٌ مِّنَ اللَّهِ","أَيْ: وَالبَيِّنَةُ رَسُولٌ مِنَ اللهِ."],["يَتْلُو","يَقْرَأُ."],["مُّطَهَّرَةً","مُنَزَّهَةً مِنَ البَاطِلِ، مَحْفُوظَةً مِنَ الشَّيَاطِينِ."]]},"3":{"siraj":[["كُتُبٌ قَيِّمَةٌ","أَخْبَارٌ صَادِقَةٌ، وَأَوَامِرُ عَادِلَةٌ."]]},"4":{"siraj":[["تَفَرَّقَ","اخْتَلَفَ."],["أُوتُوا الْكِتَابَ","اليَهُودُ وَالنَّصَارَى."],["الْبَيِّنَةُ","مِنْ بَعْدِ مَا تَبَيَّنُوا أَنَّهُ نَبِيٌّ حَقًّا، تَفَرَّقُوا، وَكَانُوا مُجْتَمِعِينَ عَلَى صِحَّةِ نُبُوَّتِهِ قَبْلَ ذَلِكَ."]]},"5":{"siraj":[["مُخْلِصِينَ","قَاصِدِينَ وَجْهَ اللهِ وَحْدَهُ."],["حُنَفَاءَ","مَائِلِينَ عَنِ الشِّرْكِ إِلَى الإِيمَانِ."],["الْقَيِّمَةِ","الاِسْتِقَامَةِ."]]},"6":{"siraj":[["لَكَنُودٌ","لَجَحُودٌ."]],"tibyan":[["لَكَنُودٌ","أي: لكفور بالنّعم يذكر المصائب وينسى النّعم، بلغة كنانة يقال: كند النّعمة إذا كفرها وجحدها."]]},"7":{"siraj":[["لَشَهِيدٌ","لَمُقِرٌّ عَلَى جُحُودِهِ."]]},"8":{"siraj":[["عَدْنٍ","إِقَامَةٍ، وَاسْتِقْرَارٍ."],["الْخَيْرِ","المَالِ."]]}}