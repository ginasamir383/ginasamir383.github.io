{"1":{"siraj":[["أَمْرُ اللهِ","قِيَامُ السَّاعَةِ."]]},"2":{"siraj":[["بِالْرُّوحِ","بِالوَحْيِ."]],"tibyan":[["بِالرُّوحِ","قيل: بالوحي، وقيل: النّبوة، وقيل: القرآن لما فيهما من حياة الدين وحياة النفوس والإرشاد إلى أمر الله. وقيل: هم حفظة على الملائكة لا تراهم الملائكة، كما أن الملائكة حفظة علينا لا نراهم، وقيل: اسم ملك، وقيل: هي التي تحيا بها الأجسام. وقال أبو عبيدة: أي مع الرّوح، وهو جبريل عليه السلام ."]]},"4":{"siraj":[["خَصِيمٌ","شَدِيدُ الخُصُومَةِ."]]},"5":{"tibyan":[["دِفْءٌ","ما استدفئ به من الأكسية والأخبية وغير ذلك."]]},"6":{"siraj":[["تُرِيحُونَ","تَرُدُّونَهَا إِلَى مَبَارِكِهَا وَحَظَائِرِهَا فِي المَسَاءِ."],["تَسْرَحُونَ","تُخْرِجُونَهَا لِلْمَرْعَى فِي الصَّبَاحِ."]],"tibyan":[["حِينَ تُرِيحُونَ وَحِينَ تَسْرَحُونَ","تسرحون: أي ترسلون الإبل بالغداة إلى المرعى. وتريحون: تردّونها عشيّا إلى مراحها."]]},"7":{"siraj":[["أَثْقَالَكُمْ","أَمْتِعَتَكُمُ الثَّقِيلَةَ."]],"tibyan":[["بِشِقِّ الْأَنْفُسِ","أي مشقّتها."]]},"9":{"siraj":[["قَصْدُ السَّبِيلِ","بَيَانُ الطَّرِيقِ الُمسْتَقِيمِ."],["جَائِرٌ","مَائِلٌ عَنِ الحَقِّ."]],"tibyan":[["وَعَلَى اللَّهِ قَصْدُ السَّبِيلِ","بيان طريق الحكم لكم. والقصد: الطّريق المستقيم ."],["وَمِنْها جائِرٌ","ومن السّبل جائر عن الاستقامة إلى معوج، وقيل فيهما غير ذلك."]]},"10":{"siraj":[["فِيهِ تُسِيمُونَ","فِي الشَّجَرِ تَرْعَوْنَ دَوَابَّكُمْ."]],"tibyan":[["فِيهِ تُسِيمُونَ","ترعون إبلكم."]]},"13":{"siraj":[["ذَرَأَ","خَلَقَ."]]},"14":{"siraj":[["لَحْمًا طَرِيًّا","هُوَ: السَّمَكُ."],["مَوَاخِرَ فِيهِ","السُّفُنُ الجَوَارِيَ فِيهِ تَشُقُّ وَجْهَ المَاءِ."]]},"15":{"siraj":[["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["أَنْ تَمِيدَ","لِئَلَّا تَمِيلَ، وَتَضْطَرِبَ."]],"tibyan":[["رَواسِيَ أَنْ تَمِيدَ بِكُمْ","أي تتحرّك. وقيل: لئلا تميد بكم."]]},"16":{"siraj":[["وَعَلامَاتٍ","مَعَالِمَ مِنْ جِبَالٍ كِبَارٍ وَصِغَارٍ، تَسْتَدِلُّونَ بِهَا عَلَى الطَّرِيقِ نَهَارًا."]]},"21":{"siraj":[["أَيَّانَ","وَقْتَ."]]},"23":{"siraj":[["لَا جَرَمَ","حَقًّا."]],"tibyan":[["لا جَرَمَ","يعني حقّا."]]},"24":{"siraj":[["أَسَاطِيرُ","قِصَصُ، وَأَبَاطِيلُ."]]},"25":{"siraj":[["أَوْزَارَهُمْ","آثًامَهُمْ."]]},"26":{"siraj":[["فَخَرَّ","فَسَقَطَ."]]},"27":{"siraj":[["يُخْزِيهِمْ","يَفْضَحُهُمْ، وَيُذِلُّهُمْ بِالعَذَابِ."],["تُشَاقُّونَ فِيهِمْ","تُحَارِبُونَ، وَتُجَادِلُونَ الأَنْبِيَاءَ لِأَجْلِهِمْ."]]},"28":{"siraj":[["فَأَلْقَوُا السَّلَمَ","فَاسْتَسْلَمُوا لِأَمْرِ اللهِ."]]},"29":{"siraj":[["مَثْوَى","مَقَرُّ."]]},"33":{"siraj":[["يَنظُرُونَ","يَنْتَظِرُونَ."]]},"34":{"siraj":[["وَحَاقَ","وَأَحَاطَ."]]},"36":{"siraj":[["الطَّاغُوتَ","مَا يُعْبَدُ مِنْ دُونِ اللهِ."]]},"38":{"siraj":[["جَهْدَ أَيْمَانِهِمْ","مُجْتَهِدِينَ بِالحَلِفِ بِأَغْلَظِ الأَيْمَانِ."]]},"41":{"siraj":[["لَنُبَوِّئَنَّهُمْ","لَنُسْكِنَنَّهُمْ."],["حَسَنَةً","دَارًا طَيِّبَةً."]]},"44":{"siraj":[["وَالزُّبُرِ","الكُتُبِ السَّمَاوِيَّةِ."]]},"45":{"siraj":[["مَكَرُوا السَّيِّئَاتِ","دَبَّرُوا المَكَايِدَ."]]},"46":{"siraj":[["تَقَلُّبِهِمْ","أَسْفَارِهِمْ، وَتَصَرُّفَاتِهِمْ."]]},"47":{"siraj":[["تَخَوُّفٍ","حَالِ خَوْفٍ، وَنَقْصٍ فِي الأَمْوَالِ وَالأَنْفُسِ."]],"tibyan":[["عَلى تَخَوُّفٍ","أي تنقّص."]]},"48":{"siraj":[["يَتَفَيَّأُ","يَمِيلُ."],["دَاخِرُونَ","خَاضِعُونَ لِعَظَمَةِ اللهِ."]],"tibyan":[["تتفيّئوا ظلاله","ترجع من جانب إلى جانب."],["داخِرُونَ","صاغرون أذلّاء."]]},"51":{"siraj":[["فَارْهَبُونِ","فَخَافُونِي."]]},"52":{"siraj":[["وَلَهُ الدِّينُ","لَهُ العِبَادَةُ وَالطَّاعَةُ وَحْدَهُ."],["وَاصِبًا","دَائِمًا."]],"tibyan":[["وَلَهُ الدِّينُ واصِباً","أي دائما."]]},"53":{"siraj":[["تَجْأَرُونَ","تَضِجُّونَ بِالدُّعَاءِ."]],"tibyan":[["فَإِلَيْهِ تَجْئَرُونَ","ترفعون أصواتكم بالدّعاء. وأصله جؤار البقر، وهو صوته إذا رفعه لألم يلحقه."]]},"56":{"siraj":[["تَفْتَرُونَ","تَخْتَلِقُونَ مِنَ الكَذِبِ."]]},"58":{"siraj":[["كَظِيمٌ","مُمْتَلِئٌ غَمًّا وَحُزْنًا."]]},"59":{"siraj":[["يَتَوَارَى","يَسْتَخْفِي."],["أَيُمْسِكُهُ","أَيُبْقِيهِ؟"],["هُونٍ","ذُلٍّ، وَهَوَانٍ."],["يَدُسُّهُ","يَدْفِنُهُ."]],"tibyan":[["يَدُسُّهُ فِي التُّرابِ","يئده: أي يدفنه حيّا."]]},"60":{"siraj":[["مَثَلُ السَّوْءِ","الصِّفَةُ القَبِيحَةُ."],["الْمَثَلُ الأَعْلَىَ","الصِّفَاتُ العُلْيَا."]]},"62":{"siraj":[["وَتَصِفُ","تَقُولُ."],["الْحُسْنَى","حُسْنُ العَاقِبَةِ."],["لَا جَرَمَ","حَقًّا."],["مُّفْرَطُونَ","مَتْرُوكُونَ فِي النَّارِ، مَنْسِيُّونَ."]],"tibyan":[["مُفْرَطُونَ","مضيّعون مقصّرون."]]},"66":{"siraj":[["لَعِبْرَةً","لَعِظَةً."],["فَرْثٍ","مَا فِي الكَرِشِ."],["سَائِغًا","لَذِيذًا لَا يَغَصُّ بِهِ شَارِبُهُ."]],"tibyan":[["مِنْ بَيْنِ فَرْثٍ وَدَمٍ","الفرث: ما في الكرش من السّرجين."],["سائِغاً لِلشَّارِبِينَ","أي سهلا في الشّرب، لا يشجى به شارب ولا يغصّ."]]},"67":{"siraj":[["سَكَرًا","خَمْرًا مُسْكِرًا."]],"tibyan":[["سَكَراً","أي خمرا. ونزل هذا قبل تحريم الخمر. والسّكر:الطّعم، يقال: قد جعلت لك هذا سكرا: أي طعما، قال الشاعر:جعلت عيب الأكرمين سكرا أي طعما."]]},"68":{"siraj":[["يَعْرِشُونَ","يَبْنُوُن مِنَ البُيُوتِ وَالسُّقُوفِ لِلنَّحْلِ."]]},"69":{"siraj":[["فَاسْلُكِي","فَادْخُلِي."],["سُبُلَ","طُرُقَ."],["ذُلُلًا","مُذَلَّلَةً، مُسَخَّرَةً."]],"tibyan":[["ذُلُلًا","أي منقادة بالتّسخير. والذّلل: جمع ذلول، وهو السّهل اللّيّن الذي ليس بصعب."]]},"70":{"siraj":[["أَرْذَلِ الْعُمُرِ","أَرْدَأِ أَعْمَارِكُمْ، وَهُوَ الهَرَمُ."]],"tibyan":[["أَرْذَلِ الْعُمُرِ","الهرم الذي ينقص قوّته وعقله، ويصيّره إلى الخرف ونحوه."]]},"71":{"tibyan":[["يَجْحَدُونَ","ينكرون بألسنتهم ما تستيقنه نفوسهم."]]},"72":{"siraj":[["وَحَفَدَةً","أَوْلَادَ الأَوْلَادِ."]],"tibyan":[["حَفَدَةً","الخدم، وقيل: الأختان ، وقيل: الأصهار، وقيل:الأعوان. وقيل: بنو المرأة من زوجها الأوّل، أي عياله بلغة قريش ."]]},"74":{"siraj":[["الأَمْثَالَ","الأَشْبَاهَ الَّذِينَ تُشْرِكُونَهُمْ مَعَ اللهِ تَعَالَى."]]},"76":{"siraj":[["أَبْكَمُ","أَخْرَسُ لَا يَتَكَلَّمُ خِلْقَةً."],["كَلٌّ","عِبْءٌ، ثَقِيلٌ."],["مَوْلاهُ","سَيِّدُهُ الَّذِي يَلِي أُمُورَهُ، وَيَعُولُهُ."]],"tibyan":[["كَلٌّ عَلى مَوْلاهُ","أي ثقيل على وليّه وقرابته."]]},"77":{"siraj":[["كَلَمْحِ الْبَصَرِ","كَخَطْفَةٍ بِالبَصَرِ، وَنَظْرَةٍ سَرِيعَةٍ."]]},"79":{"siraj":[["مُسَخَّرَاتٍ","مُذّلَّلَاتٍ لِلطَّيَرَانِ."]]},"80":{"siraj":[["سَكَنًا","رَاحَةً، وَاسْتِقْرَارًا."],["تَسْتَخِفُّونَهَا","يَخِفُّ عَلَيْكُمْ حَمْلُهَا وَهِيَ الخِيَامُ."],["ظَعْنِكُمْ","تَرْحَالِكُمْ."],["أَصْوَافِهَا","الأَصْوَافِ مِنَ الضَّانِ."],["وَأَوْبَارِهَا","الأَوْبَارِ مِنَ الإِبِلِ."],["وَأَشْعَارِهَا","الأَشْعَارِ مِنَ المَعْزِ."]],"tibyan":[["أَثاثاً","الأثاث: متاع البيت، واحدها أثاثة."]]},"81":{"siraj":[["ظِلَالًا","أَشْيَاءَ تَسْتَظِلُّونَ بِهَا؛ كَالأَشْجَارِ."],["أَكْنَانًا","مَوَاضِعَ تَسْتَكِنُّونَ بِهَا مِثْلَ الكُهُوفِ."],["سَرَابِيلَ","ثِيَابًا."],["بَاسَكُمْ","حَرْبَكُمْ."]],"tibyan":[["أَكْناناً","جمع كنّ، وهو ما ستر ووقى من الحرّ والبرد."],["سَرابِيلَ تَقِيكُمُ الْحَرَّ","يعني القمص، بلغة تميم . وَسَرابِيلَ تَقِيكُمْ بَأْسَكُمْ [81] : يعني الدّروع بلغة كنانة وقيل: هي كلّ ما يلبس من ثوب أو درع، فهو سربال. وخصّ الحرّ في الأوّل بالذّكر وهي تقي البرد أيضا اكتفاء بأحد الضّدين. وقيل غير ذلك."]]},"84":{"siraj":[["شَهِيدًا","رَسُولًا شَاهِدًا عَلَيْهَا."],["وَلَا هُمْ يُسْتَعْتَبُونَ","لَا يُطْلَبُ مِنْهُمْ إِرْضَاءُ رَبِّهِمْ بِالتَّوْبَةِ."]]},"85":{"siraj":[["يُنظَرُونَ","يُؤَخَّرُونَ، وَيُمْهَلُونَ."]]},"87":{"siraj":[["السَّلَمَ","الاِسْتِسْلَامَ، وَالخُضُوعَ."],["وَضَلَّ","غَابَ."],["يَفْتَرُونَ","يَخْتَلِقُونَهُ مِنَ الأَنْدَادِ وَالآلِهَةِ."]]},"89":{"tibyan":[["تِبْياناً","التّفعال من البيان."]]},"90":{"siraj":[["الْفَحْشَاءِ","مَا قَبُحَ مِنَ الأَكَاذِيبِ."],["وَالْبَغْيِ","الظُّلْمِ وَالتَّعَدِّي."]]},"91":{"siraj":[["كَفِيلًا","ضَامِنًا وَشَاهِدًا."]]},"92":{"siraj":[["أَنكَاثًا","أَنْقَاضًا بَعْدَ فَتْلِهَا."],["تَتَّخِذُونَ","تَجْعَلُونَ."],["دَخَلًا","خَدِيعَةً وَمَكْرًا، وَالدَّخَلُ: مَا يَدْخُلُ فِي الشَّيْءِ لِلفَسَادِ."],["أَرْبَى","أَكْثَرَ مَالًا وَمَنْفَعَةً."]],"tibyan":[["أَنْكاثاً","هي جمع نكث، وهو ما نقض من غزل الشّعر وغيره."],["دَخَلًا بَيْنَكُمْ","أي دغلا وخيانة."],["أَنْ تَكُونَ أُمَّةٌ هِيَ أَرْبى مِنْ أُمَّةٍ","أي أزيد عددا، ومن هذا سمّي الرّبا."]]},"93":{"siraj":[["أُمَّةً وَاحِدَةً","أَهْلَ دِينٍ وَاحِدٍ، وَهُوَ الإِسْلَامُ."]]},"96":{"siraj":[["يَنفَدُ","يَذْهَبُ وَيَفْنَى."]],"tibyan":[["يَنْفَدُ","يفنى ."]]},"98":{"siraj":[["الرَّجِيمِ","المَطْرُودِ مِنْ رَحْمَةِ اللهِ."]]},"99":{"siraj":[["سُلْطَانٌ","تَسَلُّطٌ."]]},"100":{"siraj":[["يَتَوَلَّوْنَهُ","يَتَّخِذُونَهُ وَلِيًّا مُطَاعًا."]]},"101":{"siraj":[["مُفْتَرٍ","كَاذِبٌ، مُخْتَلِقٌ عَلَى اللهِ."]]},"102":{"siraj":[["رُوحُ الْقُدُسِ","الرُّوحُ المُطَهَّرُ: جِبْرِيلُ - عليه السلام -."]],"tibyan":[["رُوحُ الْقُدُسِ","جبريل عليه السلام."]]},"103":{"siraj":[["يُلْحِدُونَ إِلَيْهِ","يَنْسُبُونَ إِلَيْهِ أَنَّهُ عَلَّمَ النَّبِيَّ - صلى الله عليه وسلم -."]]},"108":{"siraj":[["طَبَعَ","خَتَمَ."]]},"109":{"siraj":[["لَا جَرَمَ","حَقًّا."]]},"110":{"siraj":[["فُتِنُوا","عُذِّبُوا، وَابْتُلُوا."]]},"111":{"siraj":[["وَتُوَفَّى","تُعْطَى الجَزَاءَ وَافِيًا."]]},"112":{"siraj":[["رَغَدًا","هَنِيئًا سَهْلًا."]]},"115":{"siraj":[["الْمَيْتَةَ","مَا مَاتَ بِغَيْرِ تَذْكِيَةٍ شَرْعِيَّةٍ."],["وَالْدَّمَ","هُوَ الدَّمُ المَسْفُوحُ مِنَ الذَّبِيحَةِ عِنْدَ الذَّبْحِ."],["أُهِلَّ لِغَيْرِ اللهِ بِهِ","ذُكِرَ عِنْدَ الذَّبْحِ اسْمُ غَيْرِ اللهِ."],["غَيْرَ بَاغٍ","غَيْرَ مُرِيدٍ وَلَا طَالِبٍ لِلْمُحَرَّمِ."],["وَلَا عَادٍ","وَغَيْرَ مُتَجَاوِزٍ حَدَّ الضَّرُورَةِ مِمَّا يَسُدُّ الرَّمَقَ."]]},"116":{"siraj":[["لِّتَفْتَرُوا","لِتَخْتَلِقُوا."]]},"119":{"siraj":[["بِجَهَالَةٍ","بِسَفَهٍ، وَجَهْلٍ لِعَاقِبَتِهَا، وَكُلُّ مَنْ عَصَى اللهَ فَهُوَ جَاهِلٌ."]]},"120":{"siraj":[["أُمَّةً","إِمَامًا، جَامِعًا لِخِصَالِ الخَيْرِ."],["قَانِتًا","خَاضِعًا، مُدَاوِمًا عَلَى الطَّاعَةِ."],["حَنِيفًا","مَائِلًا عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ قَصْدًا."]]},"121":{"siraj":[["اجْتَبَاهُ","اخْتَارَهُ."]]},"125":{"siraj":[["سَبِيلِ رَبِّكَ","دِينِ رَبِّكَ، وَطَرِيقِهِ المُسْتَقِيم"]]},"127":{"tibyan":[["وَلا تَكُ فِي ضَيْقٍ","مخفّف ضيّق، مثل: ميت وهين ولين تخفيف ميّت وهيّن وليّن، وجائز أن يكون مصدرا، كقولك: ضاق الشيء يضيق ضيقا وضيقة."]]}}