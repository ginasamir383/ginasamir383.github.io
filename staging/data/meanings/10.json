{"2":{"siraj":[["قَدَمَ صِدْقٍ","أَجْرًا حَسَنًا بِمَا قَدَّمُوا مِنْ صَالِحِ الأَعْمَالِ."]],"tibyan":[["قَدَمَ صِدْقٍ عِنْدَ رَبِّهِمْ","يعني عملا صالحا قدّموه. وقيل:محمد- صلّى الله عليه وسلّم- يشفع لهم عند ربّهم."]]},"3":{"siraj":[["اسْتَوَى عَلَى الْعَرْشِ","عَلَا عَلَى الْعَرْشِ عُلُوًّا يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."]]},"4":{"siraj":[["بِالْقِسْطِ","بِالعَدْلِ."],["حَمِيمٍ","مَاءٍ بَالِغٍ غَايَةَ الحَرَارَةِ."]],"tibyan":[["حَمِيمٍ","ماء حار."]]},"5":{"siraj":[["وَقَدَّرَهُ مَنَازِلَ","صَيَّرَ القَمَرَ ذَا مَنَازِلَ يَسِيرُ فِيهَا."]]},"6":{"siraj":[["اخْتِلَافِ","تَعَاقُبِ."]]},"10":{"siraj":[["دَعْوَاهُمْ","دُعَاؤُهُمْ."]],"tibyan":[["دَعْواهُمْ فِيها","دعاؤهم، أي قولهم وكلامهم. والدّعوى: الادّعاء."]]},"11":{"siraj":[["يَعْمَهُونَ","يَتَرَدَّدُونَ حَائِرِينَ."]]},"12":{"siraj":[["لِجَنْبِهِ","مُضْطَجِعًا."],["مَرَّ","اسْتَمَرَّ عَلَى كُفْرِهِ."]]},"13":{"siraj":[["الْقُرُونَ","الأُمَمَ الُمكَذِّبَةَ."]]},"14":{"siraj":[["جَعَلْنَاكُمْ خَلَائِفَ","اسْتَخْلَفْنَاكُمْ مِنْ بَعْدِ إِهْلَاكِهِمْ."]]},"15":{"siraj":[["تِلْقَاءَ نَفْسِي","مِنْ قِبَلِ نَفْسِي."]]},"16":{"siraj":[["أَدْرَاكُم","أَعْلَمَكُمْ."]]},"22":{"siraj":[["الْفُلْكِ","السُّفُنِ."],["عَاصِفٌ","شَدِيدَةُ الهُبُوبِ."]]},"23":{"siraj":[["يَبْغُونَ","يُفْسِدُونَ."]]},"24":{"siraj":[["زُخْرُفَهَا","بَهْجَتَهَا وَنَضَارَتَهَا."],["حَصِيدًا","مَحْصُودَةً، مَقْطُوعَةً."],["لَّمْ تَغْنَ بِالأَمْسِ","لَمْ تَكُنْ قَائِمَةً بِالأَمْسِ."]]},"25":{"siraj":[["دَارِ السَّلَامِ","الجَنَّةِ."]],"tibyan":[["دارِ السَّلامِ","الجنّة. ويقال: السّلام: الله. ويقال: دار السّلامة."]]},"26":{"siraj":[["الْحُسْنَى","الجَنَّةُ."],["وَزِيَادَةٌ","زَائِدَةٌ عَلَى الجَنَّةِ وَهِيَ: النَّظَرُ إِلَى وَجْهِ اللهِ الكَرِيمِ."],["يَرْهَقُ","يَغْشَى."],["قَتَرٌ","غُبَارٌ."]],"tibyan":[["وَلا يَرْهَقُ وُجُوهَهُمْ قَتَرٌ","أي غبار.ويَرْهَقُ: يغشى [زه] ومنه قولهم: غلام مراهق: أي قد غشي الاحتلام."]]},"27":{"siraj":[["عَاصِمٍ","مَانِع يَمْنَعُ عَذَابَ اللهِ."],["أُغْشِيَتْ","أُلْبِسَتْ."]],"tibyan":[["قِطَعاً مِنَ اللَّيْلِ مُظْلِماً","جمع قطعة، ومن قرأ قِطَعاً بتسكين الطاء، أراد اسم ما قطع، يقال: قطعت الشيء قطعا بفتح القاف في المصدر، واسم ما قطعت فسقط قطع. والجمع أقطاع."]]},"28":{"siraj":[["مَكَانَكُمْ","الْزَمُوا مَكَانَكُمْ."],["فَزَيَّلْنَا","فَرَّقْنَا."]],"tibyan":[["فَزَيَّلْنا بَيْنَهُمْ","أي فرّقنا [زه] وميّزنا بلغة حمير ."]]},"30":{"siraj":[["تَبْلُو","تُعَايِنُ، وَتَتَفَقَّدُ."],["الْحَقُّ","اللهُ الَّذِي لَا رَيْبَ فِي رُبُوبِيَّتِهِ وَأُلُوهِيَّتِهِ."]],"tibyan":[["تَبْلُوا","تختبر."],["أَسْلَفَتْ","قدّمت."]]},"33":{"siraj":[["حَقَّتْ","ثَبَتَتْ، وَوَجَبَتْ."]]},"34":{"siraj":[["فَأَنَّى تُؤْفَكُونَ","فَكَيْفَ تُصْرَفُونَ؟!"]]},"35":{"siraj":[["لَّا يَهِدِّي","لَا يَهْتَدِي."]],"tibyan":[["أَمَّنْ لا يَهِدِّي","أصله يهتدي فأدغمت التاء في الدّال."]]},"39":{"siraj":[["وَلَمَّا يَاتِهِمْ تَاوِيلُهُ","وَلَمْ يَاتِهِمْ بَعْدُ حَقِيقَةُ مَا وُعِدُوا بهِ فِي الكِتَابِ."]]},"43":{"siraj":[["يَنظُرُ إِلَيْكَ","يُبْصِرُكَ، وَيُعَايِنُ أَدِلَّةَ نُبُوَّتِكَ الصَّادِقَةِ."]]},"50":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["بَيَاتًا","لَيْلًا."]]},"51":{"siraj":[["أَثُمَّ","أَبَعْدَمَا؟"]],"tibyan":[["آلْآنَ","أي في هذا الوقت. والآن: هو الوقت الذي أنت فيه."]]},"53":{"siraj":[["وَيَسْتَنبِئُونَكَ","يَسْتَخْبِرُونَكَ."]],"tibyan":[["يَسْتَنْبِئُونَكَ","يستخبرونك."],["إِي وَرَبِّي","توكيد للأقسام، والمعنى: نعم وربي."]]},"54":{"siraj":[["بِالْقِسْطِ","بِالعَدْلِ."]]},"59":{"siraj":[["تَفْتَرُونَ","تَكْذِبُونَ."]]},"61":{"siraj":[["شَانٍ","أَمْرٍ مِنْ أُمُورِكَ."],["تُفِيضُونَ","تَشْرَعُونَ فِيهِ، وَتَعْمَلُونَهُ."],["يَعْزُبُ","يَغِيبُ."],["مِّثْقَالِ ذَرَّةٍ","زِنَةُ نَمْلَةٍ صَغِيرَةٍ."]],"tibyan":[["وَما تَتْلُوا","تقرأ، وتَتْلُوا: تتبع أيضا."],["تُفِيضُونَ فِيهِ","أي تدفعون فيه بكثرة."]]},"64":{"tibyan":[["تَبْدِيلَ لِكَلِماتِ اللَّهِ","أي لا تغيير. والتّبديل: تغيير الشيء عن حاله. والإبدال: جعل الشيء مكان شيء."]]},"66":{"tibyan":[["يَخْرُصُونَ","يحدسون [زه] ويحزرون."]]},"68":{"siraj":[["سُبْحَانَهُ","تَنَزَّهَ، وَتَقَدَّسَ."],["سُلْطَانٍ","حُجَّةٍ، وَدَلِيلٍ."]]},"71":{"siraj":[["كَبُرَ","عَظُمَ."],["فَأَجْمِعُوا","اعْزِمُوا، وَأَعِدُّوا."],["غُمَّةً","مُسْتَتِيرًا."],["اقْضُوا إِلَيَّ","اقْضُوا عَلَيَّ بِالعُقُوبَةِ."],["تُنظِرُونِ","تُمْهِلُونِ."]],"tibyan":[["غُمَّةً","أي ظلمة [زه] أو شبهة بلغة هذيل . يقال: غمّ وغمّة واحد، كما يقال: كرب وكربة."],["اقْضُوا إِلَيَّ وَلا تُنْظِرُونِ","امضوا ما في أنفسكم ولا تؤخّروه، كقوله فَاقْضِ ما أَنْتَ قاضٍ : أي فامض ما أنت ممض."]]},"73":{"siraj":[["الْفُلْكِ","السَّفِينَةِ."],["خَلَائِفَ","يَخْلُفُونَ الُمَكَذِّبِينَ فِي الأَرْضِ."]]},"74":{"siraj":[["نَطْبَعُ","نَخْتِمُ."]]},"75":{"siraj":[["وَمَلَئِهِ","أَشْرَافِ قَوْمِهِ."]]},"78":{"siraj":[["لِتَلْفِتَنَا","لِتَصْرِفَنَا."],["الْكِبْرِيَاءُ","العَظَمَةُ، وَالسُّلْطَانُ."]],"tibyan":[["لِتَلْفِتَنا","لتصرفنا. والالتفات: الانصراف."],["وَتَكُونَ لَكُمَا الْكِبْرِياءُ فِي الْأَرْضِ","يسمى [الملك] الكبرياء لأنه أكبر ما يطلب من أمر الدّنيا."]]},"82":{"siraj":[["وَيُحِقُّ","يُثْبِتُ وَيُعْلِي."]]},"83":{"siraj":[["لَعَالٍ","لَجَبَّارٌ، مُسْتَكْبِرٌ."],["الْمُسْرِفِينَ","المُتَجَاوِزِينَ الحَدَّ فِي الكُفْرِ وَالفَسَادِ."]]},"84":{"siraj":[["مُّسْلِمِينَ","مُذْعِنِينَ لَهُ بِالطَّاعَةِ."]]},"85":{"siraj":[["لَا تَجْعَلْنَا فِتْنَةً لِّلْقَوْمِ الظَّالِمِينَ","لَا تَنْصُرْهُمْ عَلَيْنَا، فَيَظُنُّوا أَنَّهُمْ عَلَى الحَقِّ؛ فَيَفْتَتِنُوا، أَوْ يَفْتِنوُنَا عَنِ الدِّينِ."]]},"87":{"siraj":[["تَبَوَّءَا","اتَّخِذَا."],["قِبْلَةً","مَسَاجِدَ تُصَلُّونَ فِيهَا عِنْدَ الخَوْفِ."]]},"88":{"siraj":[["اطْمِسْ عَلَى أَمْوَالِهِمْ","أَتْلِفْهَا."],["وَاشْدُدْ عَلَى قُلُوبِهِمْ","اخْتِمْ عَلَيْهَا حَتَّى لَا تُؤْمِنَ."]],"tibyan":[["اطْمِسْ","امح: أذهبه، من قولك: طمس الطريق، إذا عفا ودرس."]]},"89":{"siraj":[["فَاسْتَقِيمَا","فاثْبُتَا عَلَى الدِّينِ، واسْتَمِرَّا علَى الدَّعْوَةِ."],["وَلَا تَتَّبِعَانِّ","لَا تَسْلُكَانِّ."]]},"90":{"siraj":[["وَجَاوَزْنَا","قَطَعْنَا."],["بَغْيًا وَعَدْوًا","ظُلْمًا، وَعُدْوَانًا."]]},"92":{"siraj":[["نُنَجِّيكَ","نُخْرِجُكَ مِنَ البَحْرِ، وَنَجْعَلُكَ عَلَى مُرْتَفِعٍ مِنَ الأَرْضِ."],["آيَةً","عِبْرَةً."]],"tibyan":[["نُنَجِّيكَ بِبَدَنِكَ","أي وحدك. ويقال: إنما ذكر البدن دلالة على خروج الرّوح منه، أي ننجيك ببدن لا روح فيه. ويقال: ببدنك أي بدرعك. والبدن:الدّرع."]]},"93":{"siraj":[["بَوَّانَا","أَنْزَلْنَا."],["مُبَوَّأَ صِدْقٍ","مَنْزِلًا صَالِحًا بِالشَّامِ وَمِصْرَ."]],"tibyan":[["بَوَّأْنا بَنِي إِسْرائِيلَ مُبَوَّأَ صِدْقٍ","أنزلناهم. ويقال: جعلنا لهم مبوّأ، وهو المنزل الملزوم."]]},"94":{"siraj":[["الْمُمْتَرِينَ","الشَّاكِّينَ."]]},"96":{"siraj":[["حَقَّتْ","وَجَبَتْ."]]},"98":{"siraj":[["فَلَوْلَا","فَهَلَّا."],["الخِزْيِ","الذُّلِّ وَالهَوَانِ."]]},"100":{"siraj":[["الرِّجْسَ","العَذَابَ."]]},"101":{"siraj":[["وَمَا تُغْنِي","لَا تَنْفَعُ."]]},"102":{"siraj":[["خَلَوْا","مَضَوْا."]]},"105":{"siraj":[["أَقِمْ وَجْهَكَ لِلدِّينِ","أَقِمْ نَفْسَكَ عَلَى الإِسْلَامِ مُسْتَقِيمًا عَلَيْهِ."],["حَنِيفًا","مَائِلًا عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ."]]}}