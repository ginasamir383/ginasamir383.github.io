{"1":{"siraj":[["الْقَارِعَةُ","القِيَامَةُ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا."]],"tibyan":[["الْقارِعَةُ","القيامة، وهي الداهية أيضا."]]},"4":{"siraj":[["الْمَبْثُوثِ","المُنْتَشِرِ."]],"tibyan":[["كَالْفَراشِ","هو شبيه بالبعوض يتهافت في النار."]]},"5":{"siraj":[["كَالْعِهْنِ","كَالصُّوفِ المَصْبُوغِ بِأَلْوَانٍ مُخْتَلِفَةٍ."],["الْمَنفُوشِ","الَّذِي مُزِّقَ، وَنُفِشَ، فَتَفَرَّقَتْ أَجْزَاؤُهُ."]],"tibyan":[["كَالْعِهْنِ","الصّوف المصبوغ."]]},"6":{"siraj":[["ثَقُلَتْ مَوَازِينُهُ","رَجَحَتْ مَوَازِينُ حَسَنَاتِهِ."]]},"7":{"tibyan":[["عِيشَةٍ راضِيَةٍ","أي مرضية."]]},"9":{"siraj":[["فَأُمُّهُ هَاوِيَةٌ","مَاوَاهُ إِلَى جَهَنَّمَ يَهْوِي عَلَى رَاسِهِ."]],"tibyan":[["فَأُمُّهُ هاوِيَةٌ","أي يأوي إليها فصارت الأصل له."]]},"11":{"siraj":[["حَامِيَةٌ","حَارَّةٌ قَدِ اشْتَدَّ إِيقَادُهَا."]]}}