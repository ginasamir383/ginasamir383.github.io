{"1":{"siraj":[["تُجَادِلُكَ","تُرَاجِعُكَ، وَهِيَ: خَوْلَةُ بِنْتُ ثَعْلَبَةَ."],["زَوْجِهَا","أَوْسِ بْنِ الصَّامِتِ."]],"tibyan":[["وَتَشْتَكِي","أي تشكو."],["تَحاوُرَكُما","محاورتهما، أي مراجعتهما القول."]]},"2":{"siraj":[["يُظَاهِرُونَ","يَقُولُ الرَّجُلُ لِامْرَأَتِهِ: أَنْتِ عَلَيَّ كَظَهْرِ أُمِّي."],["إِنْ أُمَّهَاتُهُمْ","مَا أُمَّهَاتُهُمْ."],["مُنكَرًا","فَظِيعًا."],["وَزُورًا","كَذِبًا."],["يَا أُولِي الْأَبْصَارِ","يَا أَصْحَابَ البَصَائِرِ السَّلِيمَةِ."]],"tibyan":[["الَّذِينَ يُظاهِرُونَ مِنْكُمْ مِنْ نِسائِهِمْ","يحرّمونهنّ تحريم ظهور الأمّهات. وروي أن هذه نزلت في رجل ظاهر، فذكر الله قصّته، ثم تبع هذا كل ما كان من الأمّ محرّما على الابن أن يراه كالبطن والفخذين وأشباه ذلك."]]},"3":{"siraj":[["يَعُودُونَ","يَرْجِعُونَ عَنْ قَوْلِهِمْ، وَيَعْزِمُونَ عَلَى وَطْءِ نِسَائِهِمْ."],["فَتَحْرِيرُ رَقَبَةٍ","عِتْقُ رَقَبَةٍ مُؤْمِنَةٍ؛ عَبْدٍ، أَوْ أَمَةٍ."],["يَتَمَاسَّا","يَسْتَمْتِعَا بِالجِمَاعِ."]],"tibyan":[["فَتَحْرِيرُ رَقَبَةٍ","عتق رقبة، يقال: حرّرت المملوك فحرّ أي أعتقته فعتق. والرّقبة ترجمة عن الإنسان."],["يَتَمَاسَّا","كناية عن الجماع."]]},"5":{"siraj":[["يُحَادُّونَ","يُشَاقُّونَ وَيُخَالِفُونَ."],["كُبِتُوا","خُذِلُوا، وَأُهِينُوا."]],"tibyan":[["كُبِتُوا","أهلكوا [زه] وقيل: لعنوا، بلغة مذحج ."]]},"7":{"siraj":[["نَّجْوَى ثَلَاثَةٍ","تَنَاجِي ثَلَاثَةٍ بِحَدِيثِ سِرٍّ."]],"tibyan":[["مِنْ نَجْوى","أي سرار، نجوى يقال: قوم يتناجون، أي يسار بعضهم بعضا."]]},"8":{"siraj":[["بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ","قَالُوا لَكَ: السَّامُ عَلَيْكُمْ، أَيِ: المَوْتُ لَكَ."],["لَوْلَا","هَلَّا."],["حَسْبُهُمْ","كَافِيَتُهُمْ."],["الْمَصِيرُ","المَرْجِعُ، وَالمَآلُ."]]},"10":{"siraj":[["إِنَّمَا النَّجْوَى","التَّحَدُّثُ بِخُفْيَةٍ بِالإِثْمِ وَالعُدْوَانِ."]]},"11":{"siraj":[["تَفَسَّحُوا","لِيُوسِعْ بَعْضُكُمْ لِبَعْضٍ فيِ المَجَالِسِ."],["انشُزُوا","قُومُوا مِنْ مَجَالِسِكُمْ لِأَمْرٍ فِيه خَيْرٌ لَكُمْ."]],"tibyan":[["تَفَسَّحُوا","توسّعوا."],["انْشُزُوا","ارتفعوا، يقال: قعد على نشز من الأرض، أي مكان مرتفع، ويقال: معنى انْشُزُوا: ارتفعوا عن مواضعكم حتى توسعوا لغيركم."]]},"13":{"siraj":[["أَأَشْفَقْتُمْ","أَخَشِيتُمُ الفَقْرَ؟"]]},"14":{"siraj":[["الَّذِينَ تَوَلَّوْا قَوْمًا","المُنَافِقِينَ اتَّخَذُوا اليَهُودَ أَصْدِقَاءَ، وَوَالَوْهُمْ."]]},"16":{"siraj":[["جُنَّةً","وِقَايَةً لَهُمْ مِنَ القَتْلِ."]],"tibyan":[["اتَّخَذُوا أَيْمانَهُمْ جُنَّةً","الجنّة: التّرس وما أشبهه مما يستر."]]},"18":{"siraj":[["وَيَحْسَبُونَ","يَعْتَقِدُونَ."]]},"19":{"siraj":[["اسْتَحْوَذَ","غَلَبَ، وَاسْتَوْلَى."]],"tibyan":[["اسْتَحْوَذَ عَلَيْهِمُ الشَّيْطانُ","غلب عليهم واستولى. واستحوذ مما أخرج على الأصل ولم يعلّ، ومثله: استروح واستنوق الجمل، واستصوب رأيه."]]},"20":{"siraj":[["يُحَادُّونَ","يُخَالِفُونَ، وَيُشَاقُّونَ."],["الأَذَلِّينَ","الأَذِلَّاءِ المَغْلُوبِينَ المُهَانِينَ."]]},"21":{"siraj":[["لَأَغْلِبَنَّ","لَأَنْتَصِرَنَّ."],["عَزِيزٌ","غَالِبٌ لَا يُغْلَبُ."]]},"22":{"siraj":[["يُوَادُّونَ","يُحِبُّونَ."],["حَادَّ","عَادَى."],["عَشِيرَتَهُمْ","أَقْرِبَاءَهُمْ."],["وَأَيَّدَهُم","قَوَّاهُمْ."],["بِرُوحٍ مِّنْهُ","بِنَصْرٍ، وَتَايِيدٍ."]],"tibyan":[["حَادَّ اللَّهَ","عاداه وخالفه. ويقال المحادّة: الممانعة ."]]}}