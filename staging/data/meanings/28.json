{"4":{"siraj":[["عَلَا","تَكَبَّرَ، وَطَغَى."],["شِيَعًا","طَوَائِفَ مُتَفَرِّقَةً."]],"tibyan":[["شِيَعاً","فرقا."]]},"5":{"siraj":[["نَّمُنَّ","نَتَفَضَّلَ."]]},"7":{"siraj":[["الْيَمِّ","النَّهْرِ، وَهُوَ نَهْرُ النِّيلِ."]]},"8":{"siraj":[["خَاطِئِينَ","آثِمِينَ."]]},"9":{"siraj":[["قُرَّتُ عَيْنٍ لِّي","مَصْدَرُ سُرُورٍ لِي."]],"tibyan":[["قُرَّتُ عَيْنٍ لِي وَلَكَ","مشتقّ من القرور، وهو الماء البارد، ومعنى قولهم: أقرّ الله عينك: أبرد الله دمعتك لأنّ دمعة السّرور باردة، ودمع الحزن حارّ."]]},"10":{"siraj":[["فَارِغًا","خَالِيًا مِنْ كُلِّ شَيْءٍ إِلَّا هَمَّ مُوسَى - عليه السلام -."],["لَتُبْدِي بِهِ","فَتُصَرِّحُ بِأَنَّهُ ابْنُهَا."]]},"11":{"siraj":[["قُصِّيهِ","تَتَبَّعِي أَثَرَهُ."],["عَن جُنُبٍ","عَنْ بُعْدٍ."]],"tibyan":[["قُصِّيهِ","اتّبعي أثره حتى تنظري من يأخذه ."],["فَبَصُرَتْ بِهِ عَنْ جُنُبٍ","أي أبصرته عن مكان جنب. وقيل: عن جانب لأنها كانت تمشي على الشّطّ."]]},"12":{"siraj":[["يَكْفُلُونَهُ لَكُمْ","يَقُومُونَ بِتَرْبِيَتِهِ وَإِرْضَاعِهِ."]],"tibyan":[["الْمَراضِعَ","جمع مرضع."],["يَكْفُلُونَهُ","يضمونه إليهم."]]},"14":{"siraj":[["بَلَغَ أَشُدَّهُ","قَوِيَ بَدَنُهُ."],["وَاسْتَوَى","تَكَامَلَ عَقْلُهُ."]],"tibyan":[["بَلَغَ أَشُدَّهُ","قال مجاهد: بلغ ثلاثا وثلاثين سنة ."],["وَاسْتَوى","قال : أربعين سنة."]]},"15":{"siraj":[["مِن شِيعَتِهِ","مِنْ قَوْمِ مُوسَى - عليه السلام -، وَهُمْ بَنُو إِسْرَائِيلَ."],["فَوَكَزَهُ","ضَرَبَهُ بِجُمْعِ كَفِّهِ."]],"tibyan":[["مِنْ شِيعَتِهِ","أي من أتباعه."],["فَوَكَزَهُ","ضرب صدره بجمع كفّه، ومثله لكزه ولهزه ونهزه ."]]},"17":{"siraj":[["ظَهِيرًا","نَصِيرًا."]]},"18":{"siraj":[["يَتَرَقَّبُ","يَتَوَقَّعُ المَكْرُوهَ."],["يَسْتَصْرِخُهُ","يَطْلُبُ مِنْهُ النَّصْرَ."],["لَغَوِيٌّ","كَثِيرُ الغَوَايَةِ، ضَالٌّ عَنِ الرُّشْدِ."]],"tibyan":[["يَسْتَصْرِخُهُ","يستغيثه."]]},"20":{"tibyan":[["يَأْتَمِرُونَ بِكَ","يتآمرون في قتلك."]]},"22":{"siraj":[["تِلْقَاءَ مَدْيَنَ","جِهَتَهَا."],["سَوَاءَ السَّبِيلِ","الطَّرِيقَ الأَحْسَنَ إِلَى مَدْيَنَ."]],"tibyan":[["تِلْقاءَ مَدْيَنَ","تجاه مدين ونحوها، وقولهم: فعل هذا من تلقاء نفسه، أي من عند نفسه."],["سَواءَ السَّبِيلِ","وسط الطريق وقصده."]]},"23":{"siraj":[["تَذُودَانِ","تَحْبِسَانِ غَنَمَهُمَا عَنِ المَاءِ."],["مَا خَطْبُكُمَا","مَا شَانُكُمَا؟"],["يُصْدِرَ الرِّعَاءُ","يَنْصَرِفَ الرُّعَاةُ بِأَغْنَامِهِمْ عَنِ المَاءِ."],["شَيْخٌ كَبِيرٌ","رَجُلٌ مُسِنٌّ وَلَيْسَ هُوَ شُعَيبًا، خِلَافًا لِلمَشْهُورِ."]],"tibyan":[["تَذُودانِ","تكفان غنمهما. وأكثر ما يستعمل في الغنم والإبل.وربما استعمل في غيرهما، فيقال: سنذودكم عن الجهل علينا، أي نكفّكم ونمنعكم."],["الرِّعاءُ","جمع راع ."]]},"25":{"tibyan":[["الْقَصَصَ","اسم مصدر قصّ عليه الخبر قصّا، قال الجوهري:وضع موضع المصدر حتى صار أغلب عليه."]]},"27":{"siraj":[["تَاجُرَنِي","تَكُونَ أَجِيرًا لِي فِي رَعْيِ مَاشِيَتِي."],["حِجَجٍ","سِنِينَ."]],"tibyan":[["تَأْجُرَنِي","تكون لي أجيرا ."],["حِجَجٍ","جمع حجّة، أي سنة."]]},"28":{"siraj":[["الْأَجَلَيْنِ","المُدَّتَيْنِ، الثَّمَانِ أَوِ العَشْرِ."],["فَلَا عُدْوَانَ عَلَيَّ","فَلَا أُطَالَبُ بِزِيَادَةٍ فيِ المُدَّةِ."],["وَكِيلٌ","حَافِظٌ يُرَاقِبُنَا."]]},"29":{"siraj":[["آنَسَ","أَبْصَرَ."],["جَذْوَةٍ","شُعْلَةٍ مِنَ النَّارِ."],["تَصْطَلُونَ","تَسْتَدْفِئُونَ."]],"tibyan":[["جَذْوَةٍ مِنَ النَّارِ","هي بتثليث الجيم : قطعة غليظة من الحطب فيها نار لا لهب فيها."],["تَصْطَلُونَ","تسخنون والصّلا: النّار العظيمة."]]},"30":{"siraj":[["شَاطِئِ","جَانِبِ."]],"tibyan":[["شاطِئِ الْوادِ","شطّه."]]},"31":{"siraj":[["تَهْتَزُّ","تَتَحَرَّكُ، وَتَضْطَرِبُ."],["جَانٌّ","حَيَّةٌ خَفِيفَةٌ فيِ سُرْعَةِ حَرَكَتِهَا."],["مُدْبِرًا","هَارِبًا جَاعِلًا النَّارَ خَلْفَ ظَهْرِهِ."],["وَلَمْ يُعَقِّبْ","لَمْ يَلْتَفِتْ."]]},"32":{"siraj":[["اسْلُكْ","أَدْخِلْ."],["جَيْبِكَ","فَتْحَةِ قَمِيصِكَ."],["مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ، وَلَا مَرَضٍ."],["وَاضْمُمْ إِلَيْكَ جَنَاحَكَ","ضُمَّ يَدَكَ إِلَى صَدْرِكَ."],["مِنَ الرَّهْبِ","لِتَامَنَ مِنَ الخَوْفِ."],["فَذَانِكَ","هَاتَانِ."],["بُرْهَانَانِ","آيَتَانِ."]],"tibyan":[["اسْلُكْ يَدَكَ فِي جَيْبِكَ","أدخلها فيه، ويقال الجيب هنا:القميص."],["جَناحَكَ","أي يدك، ويقال العصا."],["والرَّهْبِ","الكمّ، بلغة بني حنيفة ."]]},"34":{"siraj":[["رِدْءًا","عَوْنًا."]],"tibyan":[["رِدْءاً","أي معينا على عدوه، يقال: ردأته على عدوّه، أيأعنته عليه ."]]},"35":{"siraj":[["سَنَشُدُّ عَضُدَكَ","سَنُقَوِّيكَ، وَنُعِينُكَ."],["سُلْطَانًا","حُجَّةً، أَوْ تَسَلُّطًا، وَغَلَبَةً."],["فَلَا يَصِلُونَ إِلَيْكُمَا","فَلَا يُصِيبُكُمَا مِنْهُمْ سُوءٌ."],["بِآيَاتِنَا","بِسَبَبِ آيَاتِنَا."]]},"36":{"siraj":[["مُّفْتَرًى","مُخْتَلَقٌ، تَنْسُبُهُ إِلَى اللهِ كَذِبًا."]]},"37":{"siraj":[["عَاقِبَةُ الدَّارِ","النِّهَايَةُ المَحْمُودَةُ فِي الآخِرَةِ."]]},"38":{"siraj":[["صَرْحًا","بِنَاءً عَالِيًا."]]},"40":{"siraj":[["فَنَبَذْنَاهُمْ فِي الْيَمِّ","فَأَلْقَيْنَاهُمْ وَأَغْرَقْنَاهُمْ فيِ البَحْرِ."]]},"41":{"siraj":[["أَئِمَّةً","قَادَةً إِلَى النَّارِ."]]},"42":{"siraj":[["وَأَتْبَعْنَاهُمْ","أَلْحَقْنَاهُمْ."],["لَعْنَةً","طَرْدًا وَإِبْعَادًا مِنَ الرَّحْمَةِ."],["الْمَقْبُوحِينَ","المُبْعَدِينَ المُسْتَقْذَرَةِ أَفْعَالُهُمْ."]],"tibyan":[["مِنَ الْمَقْبُوحِينَ","أي المشوهين بسواد الوجوه وزرقة العيون، يقال: قبّح الله وجهه، وقبح بالتّخفيف والتّشديد."]]},"43":{"siraj":[["الْقُرُونَ الْأُولَى","الأُمَمَ المَاضِيَةَ المُكَذِّبَةَ."],["بَصَائِرَ لِلنَّاسِ","نُورًا لِقُلُوبِهِمْ يُبْصِرُونَ بِهِ الحَقَائِقَ."]]},"44":{"siraj":[["الْغَرْبِيِّ","الجَبَلِ الغَرْبِيِّ مِنْ مُوسَى - عليه السلام -."],["قَضَيْنَا","عَهِدْنَا."]]},"45":{"siraj":[["أَنشَانَا","خَلَقْنَا."],["قُرُونًا","أُمَمًا."],["فَتَطَاوَلَ عَلَيْهِمُ الْعُمُرُ","فَمَكَثُوا زَمَنًا طَوِيلًا."],["ثَاوِيًا","مُقِيمًا."],["أَهْلِ مَدْيَنَ","هُمْ قُوْمُ شُعَيْبٍ - عليه السلام -."]],"tibyan":[["ثاوِياً","مقيما."]]},"46":{"siraj":[["الطُّورِ","جَبَلٍ بِسَيْنَاءَ كَلَّمَ اللهُ مُوسَى - عليه السلام - بِجَانِبِهِ."]]},"47":{"siraj":[["تُصِيبَهُم مُّصِيبَةٌ","يَنْزِلَ بِهِمْ عَذَابٌ."]]},"48":{"siraj":[["سِحْرَانِ تَظَاهَرَا","تَعَاوَنَا، يَقْصِدُونَ التَّوْرَاةَ وَالقُرْآنَ."]]},"51":{"siraj":[["وَصَّلْنَا","فَصَّلْنَا وَبَيَّنَّا."]],"tibyan":[["وَصَّلْنا لَهُمُ الْقَوْلَ","أي أتبعنا بعضهم بعضا فاتصل عنده، يعني القرآن."]]},"54":{"siraj":[["مَّرَّتَيْنِ","لِإِيمَانِهِمْ بِكِتَابِهِمْ وَبِالقُرْآنِ."],["وَيَدْرَؤُونَ","يَدْفَعُونَ."]]},"55":{"siraj":[["اللَّغْوَ","البَاطِلَ."],["أَعْرَضُوا عَنْهُ","لَمْ يُصْغُوا إِلَيْهِ."],["سَلَامٌ عَلَيْكُمْ","لَا تَسْمَعُونَ مِنَّا إِلَّا الخَيْرَ؛ قَدْ سَلِمْتُمْ مِنَّا."],["لَا نَبْتَغِي الْجَاهِلِينَ","لَا نُرِيدُ طَرِيقَةَ الغَافِلينَ عَنِ الحَلَمَةِ وَالحِلْمِ."]]},"57":{"siraj":[["نُتَخَطَّفْ","نُنْتَزَعْ بِسُرْعَةٍ بِالقَتْلِ، وَالأَسْرِ."],["يُجْبَى","يُجْلَبُ إِلَيْهِ."]],"tibyan":[["أَوَلَمْ نُمَكِّنْ لَهُمْ حَرَماً آمِناً","أي نسكنهم فيه، ونجعله مكانا لهم."],["يُجْبى إِلَيْهِ","يجمع ."]]},"58":{"siraj":[["وَكَمْ","كَثِيرًا!"],["بَطِرَتْ مَعِيشَتَهَا","طَغَتْ وَتَمَرَّدَتْ فِي حَيَاتِهَا."]],"tibyan":[["بَطِرَتْ مَعِيشَتَها","أي في معيشتها. والبطر: سوء احتمال الغنى."]]},"59":{"siraj":[["أُمِّهَا","أَعْظَمِهَا، وَهِيَ مَكَّةُ."]]},"61":{"siraj":[["الْمُحْضَرِينَ","مِمَّنْ أُحْضِرُوا لِلنَّارِ."]]},"63":{"siraj":[["أَغْوَيْنَا","دَعَوْنَاهُمْ لِلْغَوَايَةِ فَاتَّبَعُونَا."]],"tibyan":[["حَقَّ عَلَيْهِمُ الْقَوْلُ","وجبت عليهم الحجّة فوجب العذاب."]]},"66":{"siraj":[["فَعَمِيَتْ","فَخَفِيَتْ."],["الْأَنبَاءُ","الحُجَجُ."]],"tibyan":[["فَعَمِيَتْ عَلَيْهِمُ الْأَنْباءُ","أي خفيت عليهم الحجج، وقيل:التبست."]]},"68":{"siraj":[["وَيَخْتَارُ","يَصْطَفِي."],["الْخِيَرَةُ","الاِخْتِيَارُ."]],"tibyan":[["ما كانَ لَهُمُ الْخِيَرَةُ","الاختيار."]]},"69":{"siraj":[["تُكِنُّ","تُخْفِي."]]},"71":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["سَرْمَدًا","دَائِمًا بَاقِيًا."]],"tibyan":[["سَرْمَداً","أي دائما."]]},"75":{"siraj":[["شَهِيدًا","رَسُولًا شَاهِدًا يَشْهَدُ عَلَى قَوْمِهِ بِشِرْكِهِمْ."],["وَضَلَّ","ذَهَبَ."],["يَفْتَرُونَ","يَخْتَلِقُونَهُ مِنَ الكَذِبِ."]]},"76":{"siraj":[["فَبَغَى عَلَيْهِمْ","تَجَاوَزَ حَدَّهُ فِي الكِبْرِ وَالتَّجَبُّرِ عَلَيْهِمْ."],["الْكُنُوزِ","خَزَائِنِ الأَمْوَالِ."],["مَفَاتِحَهُ","مَفَاتِيحَ خَزَائِنِ مَالِهِ وَصَنَادِيقِهُ المُقْفَلَةِ."],["لَتَنُوءُ بِالْعُصْبَةِ","لَيَثْقُلُ حَمْلُهَا عَلَى الجَمَاعَةِ الكَثِيرَةِ."],["لَا تَفْرَحْ","لَا تَبْطَرْ."]],"tibyan":[["فَبَغى عَلَيْهِمْ","أي ترفّع وجاوز المقدار."],["لَتَنُوأُ بِالْعُصْبَةِ","أي تنهض بها. وهو من المقلوب. معناه أنّ العصبة تنوء بمفاتحه، أي ينهضون بها، ويقال: ناء بحمله، إذا نهض بحمله متثاقلا.وقال الفرّاء : ليس هذا بمقلوب إنما معناه: ما إنّ مفاتحه لتنيء العصبة ، أي تميلهم بثقلها، فلما انفتحت التاء دخلت الباء [كما] قالوا: هو يذهب بالبؤس،ويذهب البؤس، واختصاره: تنوء بالعصبة بمعنى تجعل العصبة تنوء أي تنهض متثاقلة، كقولك: قم بنا، أي: اجعلنا نقوم."],["لا تَفْرَحْ","لا تأشر."],["إِنَّ اللَّهَ لا يُحِبُّ الْفَرِحِينَ","أي الأشرين البطرين. وأما الفرح بمعنى السرور فليس بمكروه."]]},"77":{"siraj":[["وَابْتَغِ","الْتَمِسْ وَاطْلُبْ."],["وَلَا تَنسَ نَصِيبَكَ","لَا تَتْرُكْ حَظَّكَ."]]},"78":{"siraj":[["القُرُونِ","الأُمَمِ."],["وَلَا يُسْأَلُ","أَيْ: لَا يُسْأَلُونَ سُؤَالَ اسْتِعْلَامٍ؛ بَلْ سُؤَالَ تَوْبِيخٍ وَتَقْرِيرٍ."]]},"80":{"siraj":[["يُلَقَّاهَا","يَتَقَبَّلُ النَّصِيحَةَ، وَيُوَفَّقُ لِلْعَمَلِ بِهَا."]]},"81":{"siraj":[["فِئَةٍ","جُنْدٍ، وَجَمَاعَةٍ."]]},"82":{"siraj":[["وَيْكَأَنَّ","كَلِمَةُ تَوَجُّعٍ، وَتَأَسُّفٍ، وَتَعَجُّبٍ."],["وَيَقْدِرُ","يُضَيِّقُ."],["وَيْكَأَنَّهُ","أَلَمْ تَعْلَمْ أَنَّهُ؟"]],"tibyan":[["وَيْكَأَنَّ اللَّهَ","معناه: ألم تر أنّ الله. ويقال: «ويك» بمعنى «ويلك» فحذفت منه اللام كما قال عنترة:ويك عنتر أقدم أراد: ويلك، وأنّ منصوبة بإضمار: أعلم أن الله. ويقال: «وي» مفصولة من «كأنّ» ومعناها التعجّب ، كما تقول: وي، لم فعلت ذلك؟ و «كأنّ» معناها: أظنّ ذلك، وأقدّره، كما تقول: كأنّ الفرج قد أتاك، أي أظنّ ذلك وأقدّره."]]},"83":{"siraj":[["عُلُوًّا","تَكَبُّرًا."]]},"85":{"siraj":[["فَرَضَ","أَنْزَلَ."],["لَرَادُّكَ إِلَى مَعَادٍ","لَمُرْجِعُكَ إِلَى المَوْضِعِ الَّذِي خَرَجْتَ مِنَهُ، وَهُوَ مَكَّةُ."]],"tibyan":[["فَرَضَ عَلَيْكَ الْقُرْآنَ","أي أوجب عليك العمل به. ويقال:أصل الفرض: الحزّ، يقال: لكلّ حزّ فرض. فمعناه أنّ الله- عز وجل- ألزمهم ذلك فثبت عليهم كما ثبت الحزّ في العود إذا حزّ فتبقى علاماته."],["إِلى مَعادٍ","أي مرجع. وقيل: إلى مكّة، وقيل: معاده الجنّة."]]},"86":{"siraj":[["تَرْجُو","تُؤَمِّلُ."],["يُلْقَى","يُنَزَّلَ."],["ظَهِيرًا","عَوْنًا."]]}}