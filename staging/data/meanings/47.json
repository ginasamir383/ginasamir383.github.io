{"1":{"siraj":[["أَضَلَّ أَعْمَالَهُمْ","أَحْبَطَهَا، وَأَبْطَلَهَا."]],"tibyan":[["أَضَلَّ أَعْمالَهُمْ","أبطلها."]]},"2":{"siraj":[["كَفَّرَ","أَزَالَ، وَمَحَا."],["بَالَهُمْ","حَالَهُمْ وَشَانَهُمْ فِي الدُّنْيَا وَالآخِرَةِ."]],"tibyan":[["بالَهُمْ","أي أمر معاشهم في الدّنيا. وقيل: حالهم، وهو لغة هذيل في النعيم."]]},"3":{"siraj":[["الْبَاطِلَ","الشَّيْطَانَ."]]},"4":{"siraj":[["فَضَرْبَ الرِّقَابِ","اضْرِبُوا مِنْهُمُ الأَعْنَاقَ."],["أَثْخَنتُمُوهُمْ","أَضْعَفْتُمُوهُمْ بِكَثْرَةِ القِتَالِ، وَكَسَرْتُمْ شَوْكَتَهُمْ."],["فَشُدُّوا الْوَثَاقَ","أَحْكِمُوا قَيْدَ الأَسْرَى."],["مَنًّا","تَمُنُّونَ عَلَيْهِمْ بِإِطْلَاقِ الأَسْرَى مِنْ غَيْرِ عِوَضٍ."],["فِدَاءً","تَطْلُبُونَ مِنْهُمْ فِدْيَةً تُخَلِّصُهُمْ مِنَ الأَسْرِ."],["حَتَّى تَضَعَ الْحَرْبُ أَوْزَارَهَا","أَثْقَالَها؛ وَالمُرَادُ: حَتَّى تَنْتَهِيَ الحَرْبُ."],["لِّيَبْلُوَ","لِيَخْتَبِرَ."],["يُضِلَّ أَعْمَالَهُمْ","يُبْطِلَ ثَوَابَ أَعْمَالِهِمْ."]],"tibyan":[["أَثْخَنْتُمُوهُمْ","أكثرتم فيهم القتل ."]]},"5":{"siraj":[["بَالَهُمْ","شَانَهُمْ فِي الدُّنْيَا وَالآخِرَةِ."]]},"6":{"siraj":[["عَرَّفَهَا لَهُمْ","بَيَّنَهَا لَهُمْ؛ فَيَهْتَدُونَ إِلَى مَسَاكِنِهِمْ فِيهَا مِنْ غَيْرِ اسْتِدْلَالٍ."]],"tibyan":[["عَرَّفَها لَهُمْ","أي عرّفهم منازلهم فيها. وقيل: طيّبها، يقال:طعام معرّف أي مطيّب."]]},"7":{"siraj":[["وَيُثَبِّتْ أَقْدَامَكُمْ","يُثَبِّتْكُمْ عِنْدَ القِتَالِ، وَيُقَوِّ قُلُوبَكُمْ."]]},"8":{"siraj":[["فَتَعْسًا","هَلَاكًا، وَخَيْبَةً."],["وَأَضَلَّ أَعْمَالَهُمْ","أَذْهَبَ ثَوَابَ أَعْمَالِهِمْ."]],"tibyan":[["فَتَعْساً لَهُمْ","أي عثارا وسقوطا. وقيل: التّعس: أن يخرّ على وجهه، والنّكس: أن يخرّ على رأسه."]]},"9":{"siraj":[["فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ أَعْمَالَهُمْ."]]},"10":{"siraj":[["أَمْثَالُهَا","عُقُوبَاتٌ مُمَاثِلَةٌ."]]},"11":{"siraj":[["مَوْلَى","وَلِيُّ، وَنَاصِرُ."]]},"12":{"siraj":[["مَثْوًى","مَاوًى، وَمسْكَنٌ."]],"tibyan":[["مَثْوىً لَهُمْ","منزل."]]},"13":{"siraj":[["وَكَأَيِّن مِّن قَرْيَةٍ","كَثِيرٌ مِنَ القُرَى."]]},"15":{"siraj":[["مَثَلُ","صِفَةُ."],["غَيْرِ آسِنٍ","غَيْرِ مُتَغَيِّرٍ، وَلَا مُنْتِنٍ."],["حَمِيمًا","بَالِغَ الغَايَةِ فِي الحَرَارَةِ."]],"tibyan":[["آسِنٍ وأسن","منتن بلغة تميم : متغير الرّيح والطّعم."],["لَذَّةٍ","أي لذيذة."]]},"16":{"siraj":[["وَمِنْهُم","مِنَ المُنَافِقِينَ."],["آنِفًا","الآنَ."]],"tibyan":[["آنِفاً","أي السّاعة، من قولك: استأنفت الشيء: ابتدأته.وقوله: ماذا قالَ آنِفاً أي الساعة في أوّل وقت يقرب منها."]]},"18":{"siraj":[["يَنظُرُونَ","يَنْتَظِرُونَ."],["بَغْتَةً","فَجْأَةً."],["جَاءَ أَشْرَاطُهَا","ظَهَرَتْ عَلَامَاتُهَا."],["فَأَنَّى","مِنْ أَيْنَ لَهُمْ؟!"],["ذِكْرَاهُمْ","تَذَكُّرُهُمْ."]],"tibyan":[["أَشْراطُها","علاماتها، ويقال: أشرط نفسه للأمر، إذا جعل نفسه علما فيه ولهذا سمّي أصحاب الشّرط للبسهم لباسا يكون علامة لهم. والشّرط في البيع علامة بين المتبايعين."]]},"19":{"siraj":[["مُتَقَلَّبَكُمْ","تَصَرُّفَكُمْ فِي يَقَظَتِكُمْ نَهَارًا."],["وَمَثْوَاكُمْ","مُسْتَقَرَّكُمْ فيِ نَوْمِكُمْ لَيْلًا."]]},"20":{"siraj":[["مَّرَضٌ","شَكٌّ، وَنِفَاقٌ."],["الْمَغْشِيِّ عَلَيْهِ","المُغْمَى عَلَيْهِ مِنْ شِدَّةِ الخَوْفِ."]],"tibyan":[["فَأَوْلى لَهُمْ","تهديد ووعيد : أي قد وليك شرّ فاحذره."]]},"21":{"siraj":[["عَزَمَ الْأَمْرُ","وَجَبَ القِتَالُ."]]},"22":{"siraj":[["فَهَلْ عَسَيْتُمْ","لَعَلَّكُمْ."],["تَوَلَّيْتُمْ","أَعْرَضْتُمْ عَنِ الإِيمَانِ."]]},"24":{"siraj":[["أَمْ","بَلْ."],["أَقْفَالُهَا","مُغْلَقَةٌ؛ فَلَا تَفْهَمُ القُرْآنَ."]],"tibyan":[["أَفَلا يَتَدَبَّرُونَ الْقُرْآنَ","يقال: تدبّرت الأمر، أي نظرت في عاقبته. والتّدبير: قيس دبر الكلام بقبله لينظر هل يختلف؟ ثم جعل كلّ تمييز تدبّرا ."]]},"25":{"siraj":[["ارْتَدُّوا عَلَى أَدْبَارِهِم","رَجَعُوا كُفَّارًا."],["سَوَّلَ لَهُمْ","زَيَّنَ لَهُمْ خَطَايَاهُمْ."],["وَأَمْلَى لَهُمْ","مَدَّ لَهُمْ فِي الأَمِلِ."]],"tibyan":[["سَوَّلَ لَهُمْ","أي زيّن."],["وَأَمْلى لَهُمْ","أطال لهم المدّة، مأخوذ من الملاوة، وهي الحين، أي تركهم حينا."]]},"26":{"siraj":[["لِلَّذِينَ كَرِهُوا","هُمُ اليَهُودُ."],["إِسْرَارَهُمْ","مَا يُخْفُونَهُ، وَيُسِرُّونَهُ."]]},"27":{"tibyan":[["فَكَيْفَ إِذا تَوَفَّتْهُمُ الْمَلائِكَةُ","أي كيف يفعلون عند ذلك، والعرب تكتفي ب «كيف» عن ذكر الفعل معها لكثرة دورها."]]},"28":{"siraj":[["فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ ثَوَابَ أَعْمَالِهِمْ."]]},"29":{"siraj":[["أَمْ حَسِبَ","بَلْ ظَنَّ."],["مَّرَضٌ","نِفَاقٌ، وَشَكٌّ."],["أَضْغَانَهُمْ","أَحْقَادَهُمْ."]],"tibyan":[["أَضْغانَهُمْ","أحقادهم، واحدها ضغن، وهو ما في القلب مستكنّ من العداوة."]]},"30":{"siraj":[["بِسِيمَاهُمْ","عَلَامَاتِهِمُ الظَّاهِرَةِ."],["لَحْنِ الْقَوْلِ","مَا يَبْدُو مِنْ كَلَامِهِمُ الَّذِي يَدُلُّ عَلَى مَقَاصِدِهِمْ."]],"tibyan":[["فِي لَحْنِ الْقَوْلِ","أي نحوه، ومعناه، وفحواه."]]},"31":{"siraj":[["وَلَنَبْلُوَنَّكُمْ","لَنَخْتَبِرَنَّكُمْ."],["وَنَبْلُوَ أَخْبَارَكُمْ","نَخْتَبِرَ أَقْوَالَكُمْ وَأَفْعَالَكُمْ."]]},"32":{"siraj":[["وَشَاقُّوا","خَالَفُوهُ، وَحَارَبُوهُ."]]},"35":{"siraj":[["فَلَا تَهِنُوا","لَا تَضْعُفُوا، وَتَجْبُنُوا عَنْ مُقَاتَلَةِ الكُفَّارِ."],["السَّلْمِ","الصُّلْحِ، وَالمُسَالَمَةِ."],["يَتِرَكُمْ أَعْمَالَكُمْ","يَنْقُصَكُمْ ثَوَابَ أَعْمَالِكُمْ."]],"tibyan":[["وَلَنْ يَتِرَكُمْ أَعْمالَكُمْ","أي لن ينقصكم ويظلمكم، بلغة حمير . يقال: وترني حقّي: أي ظلمني حقّي، والمعنى: لن ينقصكم شيئا من ثوابكم، ويقال: وترت الرجل، إذا قتلت له قتيلا، أو أخذت له مالا بغير حقّ، وفي الحديث: «من فاتته صلاة العصر فكأنما وتر أهله وماله» ."]]},"37":{"siraj":[["فَيُحْفِكُمْ","يُلِحَّ عَلَيْكُمْ، وَيُجْهِدْكُمْ."],["أَضْغَانَكُمْ","أَحْقَادَكُمْ."]],"tibyan":[["فَيُحْفِكُمْ تَبْخَلُوا","أي يلح عليكم، يقال: أحفى بالمسألة وألحف وألحّ ، بمعنى واحد."]]}}