{"2":{"siraj":[["لَا يُفْتَنُونَ","لَا يُخْتَبَرُونَ بِالشَّدَائِدِ؛ لِيَتَبَيَّنَ المُؤْمِنُ مِنَ المُنَافِقِ."]]},"4":{"siraj":[["يَسْبِقُونَا","يُعْجِزُونَا، وَيَفُوتُونَا بِأَنْفُسِهِمْ."]]},"5":{"siraj":[["أَجَلَ اللَّهِ","الوَقْتَ الَّذِي حَدَّدَهُ اللهُ لِلْبَعْثِ."]]},"10":{"siraj":[["فِتْنَةَ النَّاسِ","عَذَابَ النَّاسِ لَهُ، وَأَذَاهُمْ."]]},"12":{"siraj":[["سَبِيلَنَا","دِينَنَا."]]},"13":{"siraj":[["أَثْقَالَهُمْ","أَوْزَارَهُمْ."],["يَفْتَرُونَ","يَخْتَلِقُونَ مِنَ الكَذِبِ."]]},"17":{"siraj":[["وَتَخْلُقُونَ إِفْكًا","تَفْتَرُونَ كَذِبًا."],["فَابْتَغُوا","الْتَمِسُوا وَاطْلُبُوا."]],"tibyan":[["وَتَخْلُقُونَ إِفْكاً","أي تختلقون كذبا."]]},"20":{"siraj":[["بَدَأَ الْخَلْقَ","أَنْشَأَهُ."]]},"21":{"siraj":[["تُقْلَبُونَ","تُرَدُّونَ، وَتُرْجَعُونَ."]],"tibyan":[["وَإِلَيْهِ تُقْلَبُونَ","أي ترجعون أي إلى حكمه في دار الجزاء تردون."]]},"22":{"siraj":[["بِمُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِهِ بِالهَرَبِ وَغَيْرِهِ."]]},"25":{"siraj":[["مَّوَدَّةَ بَيْنِكُمْ","تَتَحَابُّونَ عَلَى عِبَادَتِها، وتَتَوَادُّونَ عَلَى خِدْمَتِهَا."],["يَكْفُرُ","يَتَبَرَّأُ."],["وَمَاوَاكُمُ","مَصِيرُكُمْ."]]},"26":{"siraj":[["مُهَاجِرٌ","تَارِكٌ دَارَ قَوْمِي إِلَى أَرْضِ الشَّامِ المُبَارَكَةِ."]]},"27":{"siraj":[["أَجْرَهُ فِي الدُّنْيَا","باِلذِّكْرِ الحَسَنِ، وَالوَلَدِ الصَّالِحِ وَالنُّبُوَّةِ فيِ ذُرِّيَّتِه."]]},"29":{"siraj":[["وَتَقْطَعُونَ السَّبِيلَ","تَقْطَعُونَ طُرُقَ المُسَافِرِينَ بِفِعْلِكُمُ الفَاحِشَةَ بِهِمْ."],["نَادِيكُمُ","مَجْلِسِكُمُ الَّذِي تَجْتَمِعُونَ فِيهِ."],["الْمُنكَرَ","الأَعْمَالَ المُنْكَرَةَ؛ كَالسُّخْرِيَةِ مِنَ النَّاسِ، وَقَذْفِ المَارَّةِ."]],"tibyan":[["تَأْتُونَ فِي نادِيكُمُ الْمُنْكَرَ","أي في مجلسكم."]]},"31":{"siraj":[["بِالْبُشْرَى","بِالخَبَرِ السَّارِّ، وَهُوَ: البِشَارَةُ بِإِسْحَاقَ - عليه السلام -."]]},"32":{"siraj":[["الْغَابِرِينَ","البَاقِينَ فيِ العَذَابِ."]]},"33":{"siraj":[["سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ أَنْ يَفْعَلُوا بِهِمُ الفَاحِشَةَ."],["وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهُ، وَحَزِنَ خَوْفًا عَلَيْهِمْ."]]},"34":{"siraj":[["رِجْزًا","عَذَابًا شَدِيدًا."]]},"35":{"siraj":[["تَّرَكْنَا مِنْهَا","أَبْقَيْنَا مِنْ دِيَارِهِمُ."],["آيَةً بَيِّنَةً","آثَارًا وَاضِحَةً."]]},"36":{"siraj":[["وَارْجُوا الْيَوْمَ الْآخِرَ","اطْلُبُوا بِعِبَادَتِكُمْ جَزَاءَ الآخِرَةِ."],["وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."]]},"37":{"siraj":[["الرَّجْفَةُ","الزَّلْزَلَةُ الشَّدِيدَةُ."],["جَاثِمِينَ","صَرْعَى هَالِكِينَ."]]},"38":{"siraj":[["مُسْتَبْصِرِينَ","عَارِفِينَ بِكُفْرِهِمْ مُعْجَبِينَ بِهِ."]],"tibyan":[["مُسْتَبْصِرِينَ","ذوي بصائر تمكّنهم [من] تمييز الحقّ من الباطل.وقيل: مستبصرين عند أنفسهم بزعمهم."]]},"39":{"siraj":[["وَمَا كَانُوا سَابِقِينَ","فَائِتِينَ مِنْ عَذَابِ اللهِ."]]},"40":{"siraj":[["أَخَذْنَا بِذَنبِهِ","أَخَذْنَا المَذْكُورِينَ بِعَذَابِنَا بِسَبَبِ ذُنُوبِهِمْ."],["حَاصِبًا","حِجَارَةً مِنْ طِينٍ مَنْضُودٍ."],["الصَّيْحَةُ","صَوْتٌ مِنَ السَّمَاءِ مُهْلِكٌ."]]},"41":{"siraj":[["أَوْهَنَ","أَضْعَفَ."]],"tibyan":[["وَإِنَّ أَوْهَنَ الْبُيُوتِ لَبَيْتُ الْعَنْكَبُوتِ","أي لا بيت أوهى ولا أقلّ وقاية للحرّ والبرد من بيت العنكبوت."]]},"43":{"siraj":[["وَمَا يَعْقِلُهَا","يَتَدَبَّرُهَا، وَيَفْهَمُهَا."]]},"45":{"siraj":[["أَكْبَرُ","أَعْظَمُ وَأَفْضَلُ مِنْ كُلِّ شَيْءٍ."]]},"46":{"siraj":[["ظَلَمُوا مِنْهُمْ","عَانَدُوا الحَقَّ، وَأَعْلَنُوا الحَرْبَ."],["مُسْلِمُونَ","خَاضِعُونَ مُتَذَلِّلُونَ بِالطَّاعَةِ."]]},"47":{"siraj":[["وَمِنْ هَؤُلَاءِ","العَرَبِ مِنْ قُرَيْشٍ."]]},"50":{"siraj":[["لَوْلَا","هَلَّا."],["آيَاتٌ","حُجَجٌ وَبَرَاهِينُ نُشَاهِدُهَا؛ كَنَاقَةِ صَالِحٍ - عليه السلام -."]]},"53":{"siraj":[["أَجَلٌ مُّسَمًّى","وَقْتُ عَذَابِهِمُ المُقَدَّرُ عِنْدَ اللهِ."],["بَغْتَةً","فَجْأَةً."]]},"55":{"siraj":[["يَغْشَاهُمُ","يُحِيطُ بِهِمْ وَيَعْلُوهُمْ."]]},"58":{"siraj":[["لَنُبَوِّئَنَّهُم","لِنُنْزِلَنَّهُمْ."],["غُرَفًا","مَنَازِلَ عَالِيَةً."]]},"60":{"siraj":[["وَكَأَيِّن مِّن","وَكَمْ مِنْ؟"],["لَا تَحْمِلُ رِزْقَهَا","لَا تَدَّخِرُهُ لِغَدٍ."]]},"61":{"siraj":[["فَأَنَّى يُؤْفَكُونَ","فَكَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ؟"]]},"62":{"siraj":[["يَبْسُطُ","يُوَسِّعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]]},"64":{"siraj":[["الْحَيَوَانُ","الحَيَاةُ الحَقِيقِيَّةُ الكَامِلَةُ الدَّائِمَةُ."]],"tibyan":[["لَهِيَ الْحَيَوانُ","أي الحياة، والحيوان أيضا: كلّ ذي روح."]]},"65":{"siraj":[["الْفُلْكِ","السُّفُنِ."]]},"67":{"siraj":[["حَرَمًا آمِنًا","هِيَ: مَكَّةُ."],["وَيُتَخَطَّفُ النَّاسُ","يُسْتَلَبُونَ بِسُرْعَةٍ قَتْلًا وَأَسْرًا."]]},"68":{"siraj":[["مَثْوًى","مَسْكَنٌ وَمُسْتَقَرٌّ."]]}}