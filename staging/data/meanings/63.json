{"2":{"siraj":[["جُنَّةً","وِقَايَةً وَسُتْرَةً لَهُمْ مِنَ المُؤَاخَذَةِ وَالعَذَابِ."]]},"3":{"siraj":[["آمَنُوا","أَيْ: فِي الظَّاهِرِ لَا غَيْرُ."],["فَطُبِعَ","خُتِمَ."],["لَا يَفْقَهُونَ","لَا يَفْهَمُونَ مَا فِيهِ صَلَاحُهُمْ."]]},"4":{"siraj":[["تَسْمَعْ لِقَوْلِهِمْ","تَسْمَعْ لِحَدِيثِهِمْ؛ لِفَصَاحَتِهِمْ."],["كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ","كَأَنَّهُمْ لِخُلُوِّ قُلُوبِهِمْ مِنَ الإِيمَانِ، وَعُقُولِهِمْ مِنَ الفَهْمِ: أَخْشَابٌ مُلْقَاةٌ عَلَى حَائِطٍ."],["يَحْسَبُونَ","يَظُنُّونَ."],["كُلَّ صَيْحَةٍ عَلَيْهِمْ","كُلَّ صَوْتٍ عَالٍ وَاقِعًا عَلَيْهِمْ؛ لِعِلْمِهِمْ بِحَقِيقَةِ حَالِهِمْ، وَلِخَوْفِهِمْ."],["قَاتَلَهُمُ اللَّهُ","أَخْزَاهُمْ، وَطَرَدَهُمْ مِنَ رَحْمَتِهِ."],["أَنَّى يُؤْفَكُونَ","كَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ بَعْدَ قِيَامِ البُرْهَانِ؟!"]],"tibyan":[["كَأَنَّهُمْ خُشُبٌ","جمع خشبة."],["مُسَنَّدَةٌ","منصوبة."]]},"5":{"siraj":[["لَوَّوْا رُؤُوسَهُمْ","عَطَفُوهَا إِعْرَاضًا، وِاسْتِهْزَاءً."],["يَصُدُّونَ","يُعْرِضُونَ."]]},"7":{"siraj":[["يَنفَضُّوا","يَتَفَرَّقُوا عَنْهُ."]]},"8":{"siraj":[["رَّجَعْنَا","مِنْ غَزْوَةِ بَنِي المُصْطَلِقِ."],["الْأَعَزُّ","الأَقْوَى؛ يَعْنُونَ: أَنْفُسَهُمْ."],["الْأَذَلَّ","الأَضْعَفَ وَالأَهْوَنَ؛ يَعْنُونَ: رَسُولَ اللهِ - صلى الله عليه وسلم -، وَمَنْ مَعَهُ."],["الْعِزَّةُ","القُوَّةُ، وَالغَلَبَةُ."]]},"9":{"siraj":[["لَا تُلْهِكُمْ","لَا تَشْغَلْكُمْ."]]},"10":{"siraj":[["لَوْلَا أَخَّرْتَنِي","هَلَّا أَمْهَلْتَنِي، وَأَخَّرْتَ أَجَلِي."]]},"11":{"siraj":[["أَجَلُهَا","وَقْتُ مَوْتِهَا."]]}}