{"4":{"siraj":[["يَعْمَهُونَ","يَتَرَدَّدُونَ فِي أَعْمَالِهِمُ القَبِيحَةِ مُتَحَيِّرِينَ."]]},"6":{"siraj":[["لَتُلَقَّى","لَتَتَلَقَّى."],["مِن لَّدُنْ","من عِنْدِ."]]},"7":{"siraj":[["آنَسْتُ","أَبْصَرْتُ."],["بِشِهَابٍ قَبَسٍ","بِشُعْلَةِ نَارٍ."],["تَصْطَلُونَ","تَسْتَدْفِئُونَ بِهَا مِنَ البَرْدِ."]],"tibyan":[["بِشِهابٍ قَبَسٍ","بشعلة نار في عود."]]},"8":{"siraj":[["بُورِكَ","قُدِّسَ وَطُهِّرَ."],["وَسُبْحَانَ اللَّهِ","تَنْزِيهًا للِه عَمَّا لَا يَلِيقُ بِهِ."]]},"10":{"siraj":[["تَهْتَزُّ","تَتَحَرَّكُ فِي خِفَّةٍ."],["جَانٌّ","حَيَّةٌ خَفِيفَةٌ."],["مُدْبِرًا","هَارِبًا."],["يُعَقِّبْ","يَرْجِعْ عَلَى عَقِبِهِ."]],"tibyan":[["يُعَقِّبْ","يرجع، ويقال: يلتفت ."],["كَأَنَّها جَانٌّ","الجانّ: جنس من الحيّات. والجان: واحد الجنّ أيضا."]]},"11":{"siraj":[["إِلَّا مَنْ ظَلَمَ","لَكِنْ مَنْ ظَلَمَ نَفْسَهُ."]]},"12":{"siraj":[["جَيْبِكَ","فَتْحَةِ القَمِيصِ الَّتِي يَدْخُلُ مِنْهَا الرَّاسُ."],["مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ وَلَا مَرَضٍ."]],"tibyan":[["فِي جَيْبِكَ","أي قميصك [زه] لأنه يجاب: أي يقطع. وقيل غير ذلك."]]},"13":{"siraj":[["آيَاتُنَا","مُعْجِزَاتُنَا."],["مُبْصِرَةً","ظَاهِرَةً بَيِّنَةً."],["مُّبِينٌ","وَاضِحٌ بَيِّنٌ."]]},"14":{"siraj":[["وَعُلُوًّا","تَكَبُّرًا."]]},"16":{"siraj":[["وَوَرِثَ سُلَيْمَانُ دَاوُودَ","خَلَفَ سُلَيْمَانُ أَبَاهُ فِي النُّبُوَّةِ، وَالعِلْمِ، وَالمُلْكِ."]],"tibyan":[["مَنْطِقَ الطَّيْرِ","نطقه."]]},"17":{"siraj":[["وَحُشِرَ","جُمِعَ."],["يُوزَعُونَ","يُرَدُّ أَوَّلُ كُلِّ جِنْسٍ عَلَى آخِرِهِمْ لِيَقِفُوا جَمِيعًا مُنْتَظِمِينَ."]],"tibyan":[["يُوزَعُونَ","يكفّون ويحبسون، وجاء في التفسير: يحبس أوّلهم على آخرهم حتى يدخلوا النار، ومنه قول الحسن لمّا ولي القضاء وكثر الناس عليه:«لا بدّ للناس من وزعة» أي من شرط يكفّونهم عن القاضي."]]},"18":{"siraj":[["لَا يَحْطِمَنَّكُمْ","لَا يُهْلِكَنَّكُمْ."]]},"19":{"siraj":[["أَوْزِعْنِي","أَلْهِمْنِي."]],"tibyan":[["فَتَبَسَّمَ","التّبسّم: أوّل الضّحك، وهو الذي لا صوت له."],["أَوْزِعْنِي","ألهمني. يقال: فلان موزع بكذا ومولع به ومغرى به بمعنى واحد."]]},"21":{"siraj":[["بِسُلْطَانٍ مُّبِينٍ","حُجَّةٍ ظَاهِرَةٍ."]]},"22":{"siraj":[["فَمَكَثَ غَيْرَ بَعِيدٍ","بَقِيَ زَمَنًا غَيْرَ طَوِيلٍ."],["سَبَإٍ","مَدِينَةٍ بِاليَمَنِ."],["بِنَبَإٍ","خَبَرٍ خَطِيرٍ."]],"tibyan":[["سَبَإٍ","اسم أرض، ويقال: اسم رجل. [زه] وقيل: اسم مدينة تعرف بمأرب من اليمن وبينها وبين صنعاء ثلاثة أيام. وقيل: حيّ من اليمن."]]},"23":{"siraj":[["عَرْشٌ","سَرِيرٌ."]]},"25":{"siraj":[["أَلَّا يَسْجُدُوا","زَيَّنَ لَهُمُ الشَّيْطَانُ ذَلِكَ لِئَلَّا يَسْجُدُوا."],["الْخَبْءَ","المَخْبُوءَ المَسْتُورَ عَنِ الأَعْيُنِ."]],"tibyan":[["يُخْرِجُ الْخَبْءَ","المستتر. ويقال: خبء السموات: المطر، وخبء الأرض: النّبات."]]},"28":{"siraj":[["تَوَلَّ عَنْهُمْ","تَنَحَّ عَنْهُمْ قَرِيبًا مِنْهُمْ."],["فَانظُرْ","تَأَمَّلْ، وَاسْمَعْ."],["مَاذَا يَرْجِعُونَ","مَا يَتَرَدَّدُ بَيْنَهُمْ مِنَ الكَلَامِ."]]},"29":{"siraj":[["المَلَأُ","أَشْرَافُ النَّاسِ."],["كَرِيمٌ","جَلِيلُ القَدْرِ."]]},"31":{"siraj":[["تَعْلُوا عَلَيَّ","تَتَكَبَّرُوا عَلَيَّ."]]},"32":{"siraj":[["أَفْتُونِي","أَشِيرُوا عَلَيَّ."],["قَاطِعَةً أَمْرًا","قَاضِيَةً حُكْمًا وَفَاصِلَةً فِيهِ."],["تَشْهَدُونِ","تَحْضُرُونِي."]]},"33":{"siraj":[["أُوْلُوا","أَصْحَابُ."]]},"35":{"siraj":[["فَنَاظِرَةٌ","مُنْتَظِرَةٌ."]]},"37":{"siraj":[["لَّا قِبَلَ لَهُم بِهَا","لَا طَاقَةَ لَهُمْ بِمُقَاوَمَةِ الجُنُودِ."],["صَاغِرُونَ","مُهَانُونَ."]],"tibyan":[["لا قِبَلَ لَهُمْ بِها","أي لا طاقة."]]},"38":{"siraj":[["المَلَأُ","مَنْ سَخَّرَهُمُ اللهُ لَهُ مِنَ الجِنِّ وَالإِنْسِ."]]},"39":{"siraj":[["عِفْريتٌ","مَارِدٌ قَوِيٌّ شَدِيدٌ."],["مَّقَامِكَ","مَجْلِسِكَ."]],"tibyan":[["عِفْرِيتٌ مِنَ الْجِنِّ","العفريت من الجنّ والإنس والشّياطين:الفائق المبالغ الرّئيس [زه] وقيل: هو الناقد في الأمر المبالغ فيه مع خبث ودهاء، قال الحسن: ولا يكون العفريت إلا كافرا ولكن كان مسخّرا. قيل: وكان يضع قدمه حيث ينال بصره."]]},"40":{"siraj":[["يَرْتَدَّ إِلَيْكَ طَرْفُكَ","قَبْلَ ارْتِدَادِ أَجْفَانِكَ إِذَا نَظَرْتَ إِلَى شَيْءٍ."],["مُسْتَقِرًّا عِندَهُ","حَاضِرًا لَدَيْهِ ثَابِتًا عِنْدَهُ."]],"tibyan":[["طَرْفُكَ","بصرك."]]},"41":{"siraj":[["نَكِّرُوا","غَيِّرُوا."]],"tibyan":[["عَرْشَها","العرش: سرير الملك."]]},"44":{"siraj":[["الصَّرْحَ","القَصْرَ، وَكَانَ صَحْنُهُ مِنْ زُجَاجٍ تَحْتَهُ مَاءٌ."],["حَسِبَتْهُ لُجَّةً","ظَنَّتْهُ مَاءً غَزِيرًا."],["مُّمَرَّدٌ","مُمَلَّسٌ مُسَوًّى."],["مِّن قَوَارِيرَ","مِنْ زُجَاجٍ صَافٍ."]],"tibyan":[["صَّرْحَ","هو القصر، كل بناء مشرف من قصر أو غيره فهو صرح."],["مَرَّدٌ","مملّس، ومنه الأمرد: الذي لا شعر على وجهه.وشجرة مرداء: لا ورق عليها ."],["نْ قَوارِيرَ","أي من الزجاج."]]},"47":{"siraj":[["اطَّيَّرْنَا","تَشَاءَمْنَا."],["طَائِرُكُمْ عِندَ اللَّهِ","مَا أَصَابَكُمْ مِنْ خَيْرٍ، أَوْ شَرٍّ، فَاللهُ مُقَدِّرُهُ عَلَيْكُمْ."],["تُفْتَنُونَ","تُخْتَبَرُونَ بِالسَّرَّاءِ، وَالضَّرَّاءِ."]],"tibyan":[["اطَّيَّرْنا","أصله تطيّرنا، أي تشاء منا."],["قالَ طائِرُكُمْ عِنْدَ اللَّهِ","تقدم تفسيره في سورة الإسراء ."]]},"48":{"siraj":[["الْمَدِينَةِ","مَدِينَةِ صَالِحٍ - عليه السلام -، وَهِيَ الحِجْرُ شَمَالَ غَرْبِ الجَزِيرَةِ العَرَبِيَّةِ."]]},"49":{"siraj":[["تَقَاسَمُوا","حَلَفَ كُلُّ وَاحِدٍ مِنْهُمْ لِلآخَرِ."],["لَنُبَيِّتَنَّهُ","لَنَاتِيَنَّهُ بِاللَّيْلِ بَغْتَةً فَنَقْتُلُهُ."],["لِوَلِيِّهِ","قَرِيبِهِ الَّذِي يُطَالِبُ بِدَمِهِ."]],"tibyan":[["تَقاسَمُوا بِاللَّهِ لَنُبَيِّتَنَّهُ","تحالفوا لنهلكنّه ليلا."]]},"52":{"siraj":[["خَاوِيَةً","خَالِيَةً."]]},"54":{"siraj":[["الْفَاحِشَةَ","الفَعْلَةَ المُتَنَاهِيَةَ فِي القُبْحِ."],["تُبْصِرُونَ","تَعْلَمُونَ قُبْحَهَا."]]},"56":{"siraj":[["يَتَطَهَّرُونَ","يَتَنَزَّهُونَ عَنْ إِتْيَانِ الذُّكْرَانِ."]]},"57":{"siraj":[["قَدَّرْنَاهَا","جَعَلْنَا امْرَأَةَ لُوطٍ."],["الْغَابِرِينَ","البَاقِينَ فِي العَذَابِ."]]},"58":{"siraj":[["مَّطَرًا","حِجَارَةً مِنَ السَّمَاءِ."],["فَسَاءَ","قَبُحَ."]]},"60":{"siraj":[["ذَاتَ بَهْجَةٍ","ذَاتَ مَنْظَرٍ حَسَنٍ."],["يَعْدِلُونَ","يَجْعَلُونَ للهِ عِدْلًا وَنَظِيرًا."]],"tibyan":[["حَدائِقَ","بساتين، واحدتها حديقة، والحديقة: كلّ بستان عليه حائط، وما لم يكن عليه حائط لم يقل فيه حديقة."],["ذاتَ بَهْجَةٍ","البهجة: الحسن، وهي أيضا السّرور."]]},"61":{"siraj":[["خِلَالَهَا","وَسَطَهَا."],["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["الْبَحْرَيْنِ","العَذْبِ، وَالمَالِحِ."]]},"62":{"siraj":[["وَيَكْشِفُ السُّوءَ","يُزِيلُ المَكْرُوهَ."],["خُلَفَاءَ الْأَرْضِ","تَخْلُفُونَ مَنْ سَبَقَكُمْ فِي الأَرْضِ."]]},"63":{"siraj":[["يَهْدِيكُمْ","يُرْشِدُكُمْ."],["بُشْرًا","مُبَشِّرَاتٍ بِالمَطَرِ."]]},"65":{"siraj":[["وَمَا يَشْعُرُونَ","مَا يَعْلَمُونَ."],["وَمَا يَشْعُرُونَ أَيَّانَ","مَتَى؟"]]},"66":{"siraj":[["ادَّارَكَ","تَكَامَلَ أَوِ انْتَهَى عِلْمُهُمْ وَعَجَزَ عَنْ مَعْرِفَةِ وَقْتِهَا."],["عَمِونَ","عَمِيَتْ بَصَائِرُهُمْ عَنْهَا."]]},"68":{"siraj":[["أَسَاطِيرُ الْأَوَّلِينَ","مَا سَطَّرَ القُدَمَاءُ مِنَ الأَكَاذِيبِ."]]},"72":{"siraj":[["رَدِفَ لَكُم","اقْتَرَبَ لَكُمْ."]],"tibyan":[["رَدِفَ لَكُمْ","هو وردفكم بمعنى تبعكم وجاء بعدكم."]]},"74":{"siraj":[["تُكِنُّ","تُخْفِي."]],"tibyan":[["تُكِنُّ صُدُورُهُمْ","تخفي."]]},"75":{"siraj":[["غَائِبَةٍ","شَيْءٍ غَائِبٍ عَنِ الأَبْصَارِ."],["كِتَابٍ مُّبِينٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]]},"80":{"siraj":[["وَلَّوْا مُدْبِرِينَ","أَعْرَضُوا عَنْكَ."]]},"82":{"siraj":[["وَقَعَ الْقَوْلُ","وَجَبَ العَذَابُ."],["دَابَّةً","الدَّابَّةُ: عَلَامَةٌ مِنْ عَلَامَاتِ السَّاعَةِ الكُبْرَى تَخْرُجُ، وَتُحَدِّثُ النَّاسَ، وَتَسِمُهُمْ عَلَى وُجُوهِهِمْ."],["تُكَلِّمُهُمْ","تُحَدِّثُهُمْ فَتَقُولُ: إِنَّ النَّاسَ ..."]]},"83":{"siraj":[["نَحْشُرُ","نَجْمَعُ."],["فَوْجًا","جَمَاعَةً."],["يُوزَعُونَ","يُدْفَعُونَ أَوْ يُحْبَسُ أَوَّلُ المُكَذِّبِينَ مِنْ كُلِّ أُمَّةٍ عَلَى آخِرِهِمْ؛ لِيَجْتَمِعُوا، ثُمَّ يُسَاقُونَ إِلَى الحِسَابِ."]]},"85":{"siraj":[["وَوَقَعَ الْقَوْلُ عَلَيْهِم","حَقَّتْ عَلَيْهِمْ كَلِمَةُ العَذَابِ."],["لَا يَنطِقُونَ","لَا يَتَكَلَّمُونَ بِحُجَّةٍ تَدْفَعُ العَذَابَ عَنْهُمْ."]]},"86":{"siraj":[["مُبْصِرًا","يُبْصِرُونَ فِيهِ."]]},"87":{"siraj":[["الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],["دَاخِرِينَ","صَاغِرِينَ أَذِلَّاءَ."]],"tibyan":[["داخِرِينَ","صاغرين أذلّاء."]]},"88":{"siraj":[["وَتَرَى الْجِبَالَ","تُبْصِرُ الجِبَالَ يَوْمَ القِيَامَةِ."],["جَامِدَةً","وَاقِفَةً مُسْتَقِرَّةً."],["تَمُرُّ","تَسِيرُ."]],"tibyan":[["صُنْعَ اللَّهِ","فعل الله."]]},"89":{"siraj":[["بِالْحَسَنَةِ","بِالتَّوْحِيدِ، وَالإِيمَانِ، وَالعِبَادَةِ."]]},"90":{"siraj":[["بِالسَّيِّئَةِ","بِالشِّرْكِ وَالكُفْرِ."]]},"91":{"siraj":[["الْبَلْدَةِ","مَكَّةَ."],["حَرَّمَهَا","جَعَلَهَا حَرَامًا؛ فَلَا يُسْفَكُ فِيهَا دَمٌ، أَوْ يُصَادُ صَيْدٌ، أَوْ يُقْطَعُ شَجَرٌ."]]}}