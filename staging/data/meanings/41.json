{"3":{"siraj":[["فُصِّلَتْ","بُيِّنَتْ آيَاتُهُ، وَوُضِّحَتْ مَعَانِيهِ."]]},"5":{"siraj":[["أَكِنَّةٍ","أَغْطِيَةٍ مَانِعَةٍ مِنْ فَهْمِ مَا تَدْعُونَا إِلَيْهِ."],["وَقْرٌ","صَمَمٌ، وَثِقَلٌ."]],"tibyan":[["وَقْرٌ","صمم ."]]},"6":{"siraj":[["فَاسْتَقِيمُوا إِلَيْهِ","اسْلُكُوا الطَّرِيقَ المُوصِلَ إِلَيْهِ."],["وَوَيْلٌ","هَلَاكٌ، وَعَذَابٌ."]]},"8":{"siraj":[["غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَمْنُوعٍ."]]},"9":{"siraj":[["أَندَادًا","شُرَكَاءَ، وَنُظَرَاءَ."]]},"10":{"siraj":[["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["أَقْوَاتَهَا","أَرْزَاقَ أَهْلِهَا."],["فِي أَرْبَعَةِ أَيَّامٍ","يَوْمَانِ لِخَلْقِ الأَرْضِ، وَيَوَمْانِ لِخَلْقِ الرَّوَاسِي، وَتَقْدِيرِ الأَقْوَاتِ."],["سَوَاءً","فِي تَمَامِ أَرْبَعَةِ أَيَّامٍ مُسْتَوِيَةٍ؛ بِلَا زِيَادة، وَلَا نُقْصَانٍ."]],"tibyan":[["أَقْواتَها","أرزاق بقدر ما يحتاج إليه، واحدها قوت."]]},"11":{"siraj":[["اسْتَوَى","قَصَدَ."]]},"12":{"siraj":[["فَقَضَاهُنَّ","فَخَلَقَهُنَّ، وَأَبْدَعَهُنَّ."],["بِمَصَابِيحَ","بِنُجُومٍ مُضِيئَةٍ."],["وَحِفْظًا","حَرَسًا مِنَ الشَّيَاطِينِ."]]},"13":{"siraj":[["أَنذَرْتُكُمْ","خَوَّفْتُكُمْ."],["صَاعِقَةً","عَذَابًا هَائِلًا."]]},"16":{"siraj":[["صَرْصَرًا","شَدِيدَةَ البُرُودَةِ، عَالِيَةَ الصَّوْتِ."],["نَّحِسَاتٍ","مَشْؤُومَاتٍ."],["الْخِزْيِ","الذُّلِّ وَالهَوَانِ."]],"tibyan":[["صَرْصَراً","أي باردة ذات صوت."],["نَحِساتٍ","أي مشؤومات."]]},"17":{"siraj":[["فَهَدَيْنَاهُمْ","فَبَيَّنَّا لَهُمْ سَبِيلَ الحَقِّ."],["فَاسْتَحَبُّوا","فَاخْتَارُوا."],["الْهُونِ","المُهِينِ."]]},"19":{"siraj":[["يُوزَعُونَ","يُرَدُّ أَوَّلُهُمْ عَلَى آخِرِهِمْ."]]},"22":{"siraj":[["تَسْتَتِرُونَ","تَسْتَخْفُونَ عِنْدَ ارْتِكَابِكُمُ المَعَاصِيَ."],["أَنْ يَشْهَدَ","خَوْفًا مِنْ أَنْ يَشْهَدَ."]]},"23":{"siraj":[["أَرْدَاكُمْ","أَهْلَكَكُمْ."]],"tibyan":[["أَرْداكُمْ","أهلككم."]]},"24":{"siraj":[["مَثْوًى","مَاوًى وَمَسْكَنٌ."],["يَسْتَعْتِبُوا","يَطْلُبُوا العُتْبَى وَهِيَ المَغْفِرَةُ."],["فَمَا هُم مِّنَ الْمُعْتَبِينَ","مَا هُمْ مِنَ المُجَابِينَ إِلَى مَا طَلَبُوا."]]},"25":{"siraj":[["وَقَيَّضْنَا","هَيَّانَا."],["قُرَنَاءَ","مُصَاحِبِينَ مِنْ شَيَاطِينِ الإِنْسِ وَالجِنِّ."],["وَحَقَّ عَلَيْهِمُ الْقَوْلُ","وَجَبَ عَلَيْهِمُ الوَعِيدُ بِالعَذَابِ."],["خَلَتْ","مَضَتْ."]],"tibyan":[["وَقَيَّضْنا لَهُمْ قُرَناءَ","أي سبّبنا لهم من حيث لا يعلمون ولا يحتسبون."]]},"26":{"siraj":[["وَالْغَوْا فِيهِ","ائْتُوا بِاللَّغوِ؛ مِنَ الصَّفِيرِ، وَالصِّيَاحِ، وَالجَلَبَةِ، عِنْدَ قِرَاءَتِهِ."]],"tibyan":[["وَالْغَوْا فِيهِ","هو من اللّغا، وهو الهجر من الكلام الذي لا نفع فيه."]]},"29":{"siraj":[["الْأَسْفَلِينَ","فِي الدَّرْكِ الأَسْفَلِ مِنَ النَّارِ."]]},"30":{"siraj":[["اسْتَقَامُوا","ثَبَتُوا عَلَى الحَقِّ عِلْمًا، وَعَمَلًا."],["تَتَنَزَّلُ عَلَيْهِمُ","تَنْزِلُ عِنْدَ المَوْتِ."]]},"31":{"siraj":[["أَوْلِيَاؤُكُمْ","أَنْصَارُكُمْ."],["تَدَّعُونَ","تَطْلُبُونَ."]]},"32":{"siraj":[["نُزُلًا","ضِيَافَةً، وَإِنْعَامًا."]]},"33":{"siraj":[["وَمَنْ أَحْسَنُ","لَا أَحَدَ أَفْضَلُ."]]},"34":{"siraj":[["وَلِيٌّ حَمِيمٌ","قَرِيبٌ لَكَ، شَفِيقٌ عَلَيْكَ."]]},"35":{"siraj":[["وَمَا يُلَقَّاهَا","مَا يُوَفَّقُ لَهَا."],["ذُو حَظٍّ عَظِيمٍ","صَاحِبُ نَصِيبٍ وَافِرٍ؛ مِنَ السَّعَادَةِ، وَالخُلُقِ، وَالخَيْرِ."]]},"36":{"siraj":[["يَنزَغَنَّكَ","يُلْقِيَنَّ فيِ نَفْسِكَ وَسْوَسَةً، وَيَصْرِفَنَّكَ عَنِ الخَيْرِ."],["فَاسْتَعِذْ بِاللَّهِ","اسْتَجِرْ، وَاعْتَصِمْ بِاللِه قَائِلًا: أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ."]]},"38":{"siraj":[["لَا يَسْأَمُونَ","لَا يَفْتُرُونَ، وَلَا يَمَلُّونَ."]],"tibyan":[["يَسْأَمُونَ","يملّون."]]},"39":{"siraj":[["خَاشِعَةً","يَابِسَةً لَا نَبَاتَ فِيهَا."],["اهْتَزَّتْ","دَبَّتْ فِيهَا الحَيَاةُ، وَتَحَرَّكَتْ بِالنَّبَاتِ."],["وَرَبَتْ","انْتَفَخَتْ، وَعَلَتْ."]],"tibyan":[["خاشِعَةً","أي ساكنة مطمئنة."]]},"40":{"siraj":[["يُلْحِدُونَ","يَمِيلُونَ عَنِ الحَقِّ."]]},"41":{"siraj":[["بِالذِّكْرِ","بِالقُرْآنِ."],["عَزِيزٌ","مُمْتَنِعٌ عَلَى كُلِّ مَنْ أَرَادَهُ بِتَحْرِيفٍ، أَوْ سُوءٍ."],["إِنَّ الَّذِينَ كَفَرُوا بِالذِّكْرِ","إِنَّ الجَاحِدِينَ بِالقُرْآنِ، وَالخَبَرُ مَحْذُوفٌ، تَقْدِيرُهُ: هَالِكُونَ."]]},"42":{"siraj":[["لَا يَاتِيهِ الْبَاطِلُ","لَا يَقْرَبُهُ شَيْطَانٌ، وَلَا يُبْطِلُهُ شَيْءٌ؛ مَحْفُوظٌ مِنْ كُلِّ زِيَادَةٍ، وَنَقْصٍ، وَتَحْرِيفٍ."],["مِن بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِ","فَي أَيِّ نَاحِيَةٍ مِنْ نَوَاحِيهِ."]]},"44":{"siraj":[["أَعْجَمِيًّا","غَيْرَ عَرَبِيٍّ."],["لَوْلَا فُصِّلَتْ","هَلَّا بُيِّنَتْ آيَاتُهُ؟!"],["أَأَعْجَمِيٌّ وَعَرَبِيٌّ","لَقَالُوا: كَيْفَ يَكُونُ القُرْآنُ أَعْجَمِيًّا، وَلِسَانُ الَّذِي أُنْزِلَ عَلَيْهِ القُرْآنُ عَرَبِيٌّ؟!"],["وَقْرٌ","صَمَمٌ."],["يُنَادَوْنَ","كَمَنْ يُنَادَى."],["مِن مَّكَانٍ بَعِيدٍ","فَلَا يَسْمَعُ دَاعِيًا، وَلَا يُجِيبُ مُنَادِيًا."]]},"45":{"siraj":[["كَلِمَةٌ","بِتَاجِيلِ العَذَابِ."],["مُرِيبٍ","شَدِيدِ الرِّيبَةِ مُقْلِقٍ."]]},"47":{"siraj":[["أَكْمَامِهَا","أَوْعِيَتِهَا."],["آذَنَّاكَ","أَعْلَمْنَاكَ."]],"tibyan":[["مِنْ أَكْمامِها","أي أوعيتها التي كانت فيها مستترة قبل تفطّرها، واحدها كمّ."],["آذَنَّاكَ","أعلمناك"]]},"48":{"siraj":[["وَضَلَّ","ذَهَبَ، وَغَابَ."],["وَظَنُّوا","أَيْقَنُوا."],["مَّحِيصٍ","مَلَجَأٍ، وَمَهْرَبٍ."]]},"49":{"siraj":[["لَا يَسْأَمُ","لَا يَمَلُّ."],["مِن دُعَاء الْخَيْرِ","طَلَبِ الزِّيَادَةِ فِي الدُّنْيَا."],["الشَّرُّ","الفَقْرُ، وَالمَرَضُ، وَالخَوْفُ."]]},"50":{"siraj":[["وَمَا أَظُنُّ","مَا أَعْتَقِدُ."],["غَلِيظٍ","شَدِيدٍ."]]},"51":{"siraj":[["وَنَأى بِجَانِبِهِ","تَبَاعَدَ عَنْ شُكْرِ النِّعْمَةِ، وَاتِّبَاعِ الحَقِّ؛ تَكَبُّرًا."],["فَذُو دُعَاء عَرِيضٍ","صَاحِبُ دُعَاءٍ بِكَشْفِ الضُّرِّ كَثِيرٍ."]],"tibyan":[["عَرِيضٍ","أي كثير، وقيل: طويل. والوصف بالعرض أبلغ من الوصف بالطّول لأن الشيء إذا كان عريضا فهو طويل."]]},"52":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["مَنْ أَضَلُّ","لَا أَحَدَ أَضَلُّ."],["شِقَاقٍ بَعِيدٍ","خِلَافٍ بَعِيدٍ عَنِ الحَقِّ."]]},"53":{"siraj":[["الْآفَاقِ","أَقْطَارِ السَّمَوَاتِ، وَالأَرْضِ."],["أَنَّهُ الْحَقُّ","أَنَّ القُرْآنَ حَقٌّ لَا رَيْبَ فِيهِ."],["أَوَلَمْ يَكْفِ بِرَبِّكَ","أَلَا يَكْفِيهِمْ دَلَالَةً عَلَى أَنَّ القُرْآنَ حَقٌّ: شَهَادَةُ اللهِ لَهُ بِذَلِكَ؟!"]]},"54":{"siraj":[["مِرْيَةٍ","شَكٍّ عَظِيمٍ."]]}}