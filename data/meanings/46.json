{"3":{"siraj":[["وَأَجَلٍ مُّسَمًّى","هُوَ: وَقْتُ فَنَائِهِمَا إَذَا قَامَتِ القِيَامَةُ."]]},"4":{"siraj":[["لَهُمْ شِرْكٌ","شِرْكَةٌ وَنَصِيبٌ مَعَ اللهِ تَعَالَى فِي خَلْقِ السَّمَوَاتِ."],["أَثَارَةٍ","بَقِيَّةٍ."]],"tibyan":[["أَثارَةٍ مِنْ عِلْمٍ","أي بقيّة من علم يؤثر عن الأوّلين، أي يسند إليهم [زه] وكذلك الأثرة ."]]},"5":{"siraj":[["وَمَنْ أَضَلُّ","لَا أَحَدَ أَضَلُّ، وَأَجْهَلُ."]]},"8":{"siraj":[["افْتَرَاهُ","اخْتَلَقَهُ."],["تُفِيضُونَ فِيهِ","تَقُولُونَ فيِ القُرْآنِ."]]},"9":{"siraj":[["بِدْعًا مِّنْ الرُّسُلِ","أَوَّلَ رُسُلِ اللهِ إِلَى خَلْقِهِ."]],"tibyan":[["بِدْعاً مِنَ الرُّسُلِ","أي بدءا، أي ما كنت أوّل من بعث من الرسل، قد كان قبلي رسل."]]},"10":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["وَشَهِدَ شَاهِدٌ","كَعَبْدِ اللهِ بْنِ سَلَامٍ - رضي الله عنه -."]]},"11":{"siraj":[["إِفْكٌ قَدِيمٌ","كَذِبٌ مَاثُورٌ عَنِ النَّاسِ الأَقْدَمِينَ."]]},"12":{"siraj":[["إِمَامًا","هَادِيًا يَاتَمُّونَ بِهِ، وَيَعْمَلُونَ."],["مُّصَدِّقٌ","لِكُتُبٍ قَبْلَهُ."]]},"13":{"siraj":[["اسْتَقَامُوا","ثَبَتُوا عَلَى الإِيمَانِ وَالطَّاعَةِ."]]},"15":{"siraj":[["وَوَصَّيْنَا","أَمَرْنَاهُ، وَأَلْزَمْنَاهُ."],["كُرْهًا","عَلَى مَشَقَّةٍ، وَتَعَبٍ."],["وَفِصَالُهُ","فِطَامُهُ."],["بَلَغَ أَشُدَّهُ","نِهَايَةَ قُوَّتِهِ البَدَنِيَّةِ وَالعَقْلِيَّةِ."],["أَوْزِعْنِي","أَلْهِمْنِي."]]},"17":{"siraj":[["أُفٍّ لَّكُمَا","قُبْحًا لَكُمَا."],["أَنْ أُخْرَجَ","أُبْعَثَ مِنْ قَبْرِي حَيًّا."],["خَلَتِ الْقُرُونُ","مَضَتِ الأُمَمُ السَّابِقَةُ."],["يَسْتَغِيثَانِ اللَّهَ","يَسْأَلَانِ اللهَ هِدَايَتَهُ."],["وَيْلَكَ","هَلَكْتَ."],["أَسَاطِيرُ الْأَوَّلِينَ","مَا سَطَّرَهُ الأَوَّلُونَ مِنَ الأَكَاذِيبِ فيِ كُتُبِهِمْ."]]},"18":{"siraj":[["حَقَّ عَلَيْهِمُ الْقَوْلُ","وَجَبَ عَلَيْهِمُ العَذَابُ."],["فِي أُمَمٍ","فِي جُمْلَةِ أُمَمٍ كَافِرَةٍ."],["خَلَتْ","مَضَتْ."]]},"19":{"siraj":[["وَلِكُلٍّ دَرَجَاتٌ","وَلِكُلِّ فَرِيقٍ مِنَ الأَعْدَاءِ وَالأَشْقِيَاءِ مَنَازِلُ فيِ القِيَامَةِ بِأَعْمَالِهِمْ."]]},"20":{"siraj":[["عَذَابَ الْهُونِ","عَذَابَ الخِزْيِ وَالهَوَانِ."]],"tibyan":[["عَذابَ الْهُونِ","أي الهوان."]]},"21":{"siraj":[["أَخَا عَادٍ","هُوَ: هُودٌ - عليه السلام -."],["بِالْأَحْقَافِ","اسْمُ مَوْقِعِهِمْ؛ وَهُوَ فِي جَنُوبِ جَزِيرَةِ العَرَبِ."],["خَلَتِ النُّذُرُ","مَضَتِ الرُّسُلُ."]],"tibyan":[["بِالْأَحْقافِ","رمال مفترقة مشرفة معوجّة، واحدها حقف [زه] بلغة حضر موت وتغلب ."]]},"22":{"siraj":[["لِتَافِكَنَا","لِتَصْرِفَنَا."]],"tibyan":[["لِتَأْفِكَنا عَنْ آلِهَتِنا","لتصرفنا عنها."]]},"24":{"siraj":[["عَارِضًا","سَحَابًا عَرَضًا فِي أُفُقِ السَّمَاءِ."]],"tibyan":[["عارِضٌ مُمْطِرُنا","أي سحاب ممطرنا."]]},"25":{"siraj":[["تُدَمِّرُ","تُهْلِكُ."],["كُلَّ شَيْءٍ","مَرَّتْ بِهِ مِمَّا أُرْسِلَتْ بِهَلَاكِهِ."]]},"26":{"siraj":[["مَكَّنَّاهُمْ","أَقْدَرْنَاهُمْ، وَبَسَطْنَا لَهُمْ."],["فِيمَا إِن مَّكَّنَّاكُمْ فِيهِ","فيِ الَّذِي لَمْ نُمَكِّنْكُمْ فِيهِ."],["وَحَاقَ","نَزَلَ."]],"tibyan":[["وَلَقَدْ مَكَّنَّاهُمْ فِيما إِنْ مَكَّنَّاكُمْ فِيهِ","«إن» في الجحد بمعنى «ما» .وقيل: صلة. وقيل: بمعنى «قد» ."]]},"27":{"siraj":[["وَصَرَّفْنَا الْآيَاتِ","بَيَّنًا لَهُمْ أَنْوَاعَ الحُجَجِ، وَكَرَّرْنَاهَا لَهُمْ."]]},"28":{"siraj":[["فَلَوْلَا","هَلَّا."],["قُرْبَانًا","يَتَقَرَّبُونَ بِهَا إِلَى رَبِّهِمْ."],["إِفْكُهُمْ","كَذِبُهُمْ."],["يَفْتَرُونَ","يَكْذِبُونَ."]]},"29":{"siraj":[["صَرَفْنَا","بَعَثْنَا وَوَجَّهْنَا نَحْوَكَ."],["قُضِيَ","فَرَغَ رَسُولُ اللهِ - صلى الله عليه وسلم - مِنْ تِلَاوَتِهِ."],["مُّنذِرِينَ","مُحَذِّرِينَ مِنْ بَاسِ اللهِ."]]},"31":{"siraj":[["دَاعِيَ اللَّهِ","رَسُولَ اللهِ مُحَمَّدًا - صلى الله عليه وسلم -."],["وَيُجِرْكُم","يُنْقِذْكُمْ."]]},"32":{"siraj":[["بِمُعْجِزٍ","بِفَائِتٍ مِنَ اللهِ بِالهَرَبِ."],["أَولِيَاءُ","أَنْصَارٌ يَمْنَعُونَهُ مِنْ عَذَابِ اللهِ."]]},"33":{"siraj":[["وَلَمْ يَعْيَ بِخَلْقِهِنَّ","لَمْ يَعْجِزْ عَنْ خَلْقِهِنَّ، وَلَمْ يَتْعَبْ بِهِ."]]},"35":{"siraj":[["أُوْلُوا الْعَزْمِ","ذَوُو الثَّبَاتِ وَالصَّبْرِ؛ وَهُمْ: نُوحٌ، وَإِبْرَاهِيمُ، وَمُوسَى، وَعِيسَى، وَمُحَمَّدٌ؛ عَلَيْهِمُ الصَّلَاةُ وَالسَّلَامُ."],["وَلَا تَسْتَعْجِل لَّهُمْ","لَا تَتَعَجَّلْ بِطَلَبِ عُقُوبَتِهِمْ."],["بَلَاغٌ","هَذَا تَبْلِيغٌ مِنَ اللهِ لَهُمْ."]],"tibyan":[["أُولُوا الْعَزْمِ مِنَ الرُّسُلِ","نوح، وإبراهيم، وموسى، وعيسى، ومحمد صلّى الله عليه وسلّم [زه] وفيهم أقوال أخر."]]}}