{"1":{"siraj":[["الْغَاشِيَةِ","القِيَامَةِ تَغْشَى النَّاسَ بِأَهْوَالِهَا."]],"tibyan":[["الْغاشِيَةِ","القيامة لأنها تغشاهم."]]},"2":{"siraj":[["خَاشِعَةٌ","ذَلِيلَةٌ مُنْكَسِرَةٌ."]]},"3":{"siraj":[["عَامِلَةٌ نَّاصِبَةٌ","مُجْهَدَةٌ بِالعَمَلِ وَالتَّعَبِ فِي النَّارِ."]]},"4":{"siraj":[["تَصْلَى نَارًا","تَدْخُلُ نَارًا، وَتُقَاسِي حَرَّهَا."],["حَامِيَةً","شَدِيدَةَ التَّوَهُّجِ."]]},"5":{"siraj":[["آنِيَةٍ","شَدِيدَةِ الحَرَارَةِ."]],"tibyan":[["مِنْ عَيْنٍ آنِيَةٍ","أي قد انتهى حرّها [زه] بلغة بربر ."]]},"6":{"siraj":[["ضَرِيعٍ","نَبْتٍ خَبِيثٍ ذِي شَوْكٍ، لَا تَرْعَاهُ الدَّوَابُّ."]],"tibyan":[["ضَرِيعٍ","هو نبت بالحجاز يقال لرطبه الشّبرق."]]},"9":{"siraj":[["لِسَعْيِهَا","لِعَمَلِهَا بِالطَّاعَةِ فِي الدُّنْيَا."]]},"11":{"siraj":[["لَاغِيَةً","لَا كَلِمَةَ لَغْوٍ وَاحِدَةً، وَلَا نَفْسًا تَلْغُو وَتَهْذِي."]],"tibyan":[["لاغِيَةً","لغو. ويقال: لاغية فاعلة لغوا ."]]},"12":{"siraj":[["جَارِيَةٌ","مُتَدَفِّقَةٌ بِالمَاءِ."]]},"14":{"siraj":[["مَّوْضُوعَةٌ","مُعَدَّةٌ لِلشَّارِبِينَ."]]},"15":{"siraj":[["وَنَمَارِقُ","وَسَائِدُ."]],"tibyan":[["نَمارِقُ","وسائد، واحدها نمرقة ونمرقة."]]},"16":{"siraj":[["وَزَرَابِيُّ مَبْثُوثَةٌ","بُسُطٌ كَثِيرَةٌ مَفْرُوشَةٌ."]],"tibyan":[["زَرابِيُّ","هي الطّنافس المحملة، واحدها زربيّة، بلغة هذيل .والزّرابي: البسط أيضا."],["مَبْثُوثَةٌ","أي مفرقة كثيرة في كل مجالسهم."]]},"20":{"siraj":[["سُطِحَتْ","بُسِطَتْ، وَمُهِّدَتْ."]],"tibyan":[["سُطِحَتْ","بسطت."]]},"22":{"siraj":[["بِمُصَيْطِرٍ","بِمُتَسَلِّطٍ تُكْرِهُهُمْ عَلَى الإِيمَانِ."]],"tibyan":[["بِمُصَيْطِرٍ","أي بمسلّط. وقيل: نزلت الآية قبل أن يؤمر بالقتال ثم نسخه الأمر بالقتال."]]},"23":{"siraj":[["وَأَنَّى لَهُ الذِّكْرَى","لَا يَنْفَعُهُ التَّذَكُّرُ؛ فَقَدْ فَاتَ أَوَانُهُ."]]},"25":{"siraj":[["إِيَابَهُمْ","مَرْجِعَهُمْ بَعْدَ المَوْتِ."]],"tibyan":[["إِيابَهُمْ","رجوعهم."]]}}