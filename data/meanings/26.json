{"3":{"siraj":[["بَاخِعٌ","مُهْلِكٌ."]],"tibyan":[["باخِعٌ نَفْسَكَ","أي قاتلها."]]},"4":{"tibyan":[["فَظَلَّتْ أَعْناقُهُمْ","أي رؤساؤهم. ويقال: أعناقهم: جماعاتهم، كما تقول: أتاني عنق من الناس: أي جماعة. وقيل: أضاف الأعناق إليهم، يريد الرّقاب ثم جعل الخبر عنهم لأن خضوعهم بخضوع الأعناق."]]},"5":{"siraj":[["مُحْدَثٍ","حَدِيثِ النُّزُولِ."]]},"7":{"siraj":[["زَوْجٍ كَرِيمٍ","نَوْعٍ حَسَنٍ نَافِعٍ."]]},"20":{"siraj":[["الضَّالِّينَ","الجَاهِلِينَ، وَذَلِكَ قَبْلَ أَنْ يُوحَى إليَّ."]]},"21":{"siraj":[["حُكْمًا","النُّبُوَّةَ."]]},"22":{"siraj":[["عَبَّدتَّ","جَعَلْتَهُمْ عَبِيدًا."]],"tibyan":[["أَنْ عَبَّدْتَ بَنِي إِسْرائِيلَ","أي اتّخذتهم عبيدا لك."]]},"33":{"siraj":[["وَنَزَعَ يَدَهُ","أَخْرَجَهَا مِنْ جَيْبِهِ."]]},"36":{"siraj":[["أَرْجِهِ","أَخِّرْهُ."],["حَاشِرِينَ","جُنُودًا يَجْمَعُونَ السَّحَرَةَ."]]},"44":{"siraj":[["بِعِزَّةِ فِرْعَوْنَ","أَقْسَمُوا بِعِزَّتِهِ، وَقُوَّتِهِ."]]},"45":{"siraj":[["تَلْقَفُ","تَبْتَلِعُ بِسُرْعَةٍ."],["مَا يَافِكُونَ","مَا يَفْعَلُونَهُ مِنَ الكَذِبِ وَالتَّزْوِيرِ."]]},"49":{"siraj":[["مِّنْ خِلَافٍ","بِقَطْعِ اليَدِ اليُمْنَى وَالرِّجْلِ اليُسْرَى، أَوْ عَكْسَ ذَلِكَ."]]},"50":{"siraj":[["لَا ضَيْرَ","لَا ضَرَرَ."],["مُنقَلِبُونَ","رَاجِعُونَ."]]},"53":{"siraj":[["حَاشِرِينَ","جَامِعِينَ لِلْجَيْشِ مِنَ المَدَائِنِ."]]},"54":{"siraj":[["لَشِرْذِمَةٌ","لَطَائِفَةٌ حَقِيرَةٌ."]],"tibyan":[["لَشِرْذِمَةٌ","أي طائفة قليلة."]]},"58":{"siraj":[["وَكُنُوزٍ","خَزَائِنِ الأَمْوَالِ."],["وَمَقَامٍ كَرِيمٍ","مَنَازِلَ حِسَانٍ."]]},"60":{"siraj":[["مُّشْرِقِينَ","وَقْتَ شُرُوقِ الشَّمْسِ."]]},"61":{"siraj":[["تَرَاءَى الْجَمْعَانِ","رَأَى كُلُّ فَرِيقٍ الآخَرَ."]]},"63":{"siraj":[["فِرْقٍ","قِطْعَةٍ مِنَ البَحْرِ."],["كَالطَّوْدِ","كَالجَبَلِ."]],"tibyan":[["كَالطَّوْدِ","أي كالجبل."]]},"64":{"siraj":[["وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ","قَرَّبْنَا هُنَاكَ، فِرَعْوَنَ، وَقَوْمَهُ."]],"tibyan":[["أَزْلَفْنا ثَمَّ الْآخَرِينَ","أي جمعناهم في البحر حتى غرقوا، ومنه ليلة المزدلفة، أي ليلة الازدلاف، أي الاجتماع. ويقال: أزلفناهم، أي قرّبناهم من البحر حتى أغرقناهم فيه، ومنه: أزلفني كذا عند فلان، أي قرّبني منه."]]},"71":{"siraj":[["عَاكِفِينَ","مُقِيمِينَ عَلَى عِبَادَتِها."]]},"75":{"siraj":[["أَفَرَأَيْتُم","أَبْصَرْتُمْ بِتَدَبُّرٍ."]]},"83":{"siraj":[["حُكْمًا","عِلْمًا وَفَهْمًا."]]},"84":{"siraj":[["لِسَانَ صِدْقٍ","ثَنَاءً حَسَنًا."],["الْآخِرِينَ","مَنْ يَاتُونَ بَعْدِي إِلَى يَوْمِ القِيَامَةِ."]],"tibyan":[["لِسانَ صِدْقٍ","يعني ثناء حسنا."]]},"89":{"siraj":[["سَلِيمٍ","سَالِمٍ مِنَ الشِّرْكِ وَالنِّفَاقِ وَالضَّغِينَةِ."]]},"90":{"siraj":[["وَأُزْلِفَتِ","قُرِّبَتْ."]],"tibyan":[["وَأُزْلِفَتِ الْجَنَّةُ","قرّبت وأدنيت."]]},"91":{"siraj":[["وَبُرِّزَتِ","أُظْهِرَتْ."]]},"94":{"siraj":[["فَكُبْكِبُوا","فَجُمِعُوا، وَأُلْقُوا."]],"tibyan":[["فَكُبْكِبُوا","أصله كبّبوا، أي ألقوا على رؤوسهم في جهنم، من قولك: كببت الإناء إذا قلبته."]]},"101":{"siraj":[["حَمِيمٍ","مُشْفِقٍ يَهْتَمُّ بِأَمْرِنَا."]]},"102":{"siraj":[["كَرَّةً","رَجْعَةً إِلَى الدُّنْيَا."]]},"111":{"siraj":[["الْأَرْذَلُونَ","السَّفَلَةُ مِنَ النَّاسِ."]],"tibyan":[["الْأَرْذَلُونَ","أهل الضّعة والخساسة."]]},"116":{"siraj":[["الْمَرْجُومِينَ","المَقْتُولِينَ رَمْيًا بِالحِجَارَةِ."]],"tibyan":[["الْمَرْجُومِينَ","أي المقتولين. والرّجم: القتل، والرّجم:السّبّ، والرّجم: القذف ."]]},"118":{"siraj":[["فَافْتَحْ","احْكُمْ."]]},"119":{"siraj":[["الْمَشْحُونِ","المَمْلُوءِ بِالنَّاسِ، وَالدَّوَابِّ، وَالمَتَاعِ."]],"tibyan":[["الْمَشْحُونِ","المملوء [زه] بلغة خثعم ."]]},"128":{"siraj":[["رِيعٍ","مَكَانٍ مُرْتَفِعٍ."],["آيَةً","بِنَاءً عَالِيًا."],["تَعْبَثُونَ","تُشْرِفُونَ مِنْهُ فَتَسْخَرُونَ مِنَ المَارَّةِ."]],"tibyan":[["رِيعٍ","أي ارتفاع عن الطّريق والأرض، وجمعه أرياع وريعة."]]},"129":{"siraj":[["مَصَانِعَ","قُصُورًا مَنِيعَةً وَحُصُونًا مُشَيَّدَةً."]],"tibyan":[["مَصانِعَ","أبنية، واحدها مصنعة."]]},"130":{"tibyan":[["جَبَّارِينَ","قتّالين. والجبّار أيضا: الطّويل من النّخل."]]},"132":{"siraj":[["أَمَدَّكُم","أَعْطَاكُمْ وَأَنْعَمَ عَلَيْكُمْ."]]},"136":{"siraj":[["سَوَاءٌ عَلَيْنَا","يَسْتَوِي عِنْدَنَا."],["أَوَعَظْتَ","أَخَوَّفْتَ."]]},"137":{"siraj":[["خُلُقُ","دِينُ، وَعَادَةُ."]],"tibyan":[["خُلُقُ الْأَوَّلِينَ","اختلافهم وكذبهم. وقرئت خلق الأولين أي عاداتهم ."]]},"148":{"siraj":[["طَلْعُهَا هَضِيمٌ","ثَمَرُهَا يَانِعٌ لَيِّنٌ نَضِيجٌ."]],"tibyan":[["طَلْعُها هَضِيمٌ","أي منضمّ قبل أن ينشقّ عنه القشر، وكذلك طَلْعٌ نَضِيدٌ أي منضود، أي نضد بعضه على بعض، وإنما يقال له نضيد ما دام في كفرّاة، فإذا انفتح فليس بنضيد. ويقال: نضيد أي منضود بعضه إلى جنب بعض."]]},"149":{"siraj":[["فَارِهِينَ","مَاهِرِينَ بِنَحْتِهَا أَشِرِينَ بَطِرِينَ."]],"tibyan":[["فرهين وفارِهِينَ","أشرين. وفارِهِينَ أيضا:حاذقين."]]},"151":{"siraj":[["الْمُسْرِفِينَ","المُتَمَادِينَ فيِ مَعْصِيَةِ اللهِ."]]},"153":{"siraj":[["الْمُسَحَّرِينَ","المَغْلُوبِ عَلَى عُقُولِهِمْ بِكَثْرَةِ السِّحْرِ."]],"tibyan":[["مِنَ الْمُسَحَّرِينَ","أي المتعلّلين بالطعام والشراب، أي إنما أنت بشر."]]},"155":{"siraj":[["شِرْبُ","نَصِيبٌ مِنَ المَاءِ."]],"tibyan":[["شِرْبٌ","أي نصيب من الماء."]]},"157":{"siraj":[["فَعَقَرُوهَا","نَحَرُوهَا."]]},"166":{"siraj":[["عَادُونَ","مُتَجَاوِزُونَ مَا أَبَاحَهُ اللهُ لَكُمْ مِنَ الحَلَالِ إِلَى الحَرَامِ."]]},"167":{"siraj":[["الْمُخْرَجِينَ","المَطْرُودِينَ مِنْ بِلَادِنَا."]]},"168":{"siraj":[["الْقَالِينَ","المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا."]],"tibyan":[["مِنَ الْقالِينَ","أي المبغضين، يقال: قليته أقليه قلى، إذا أبغضته."]]},"171":{"siraj":[["الْغَابِرِينَ","البَاقِينَ فيِ العَذَابِ."]]},"173":{"siraj":[["فَسَاءَ","قَبُحَ."]]},"176":{"siraj":[["أَصْحَابُ الْأَيْكَةِ","أَصْحَابُ الأَرْضِ ذَاتِ الشَّجَرِ المُلْتَفِّ؛ وَهُمْ قَوْمُ شُعَيْبٍ."]],"tibyan":[["الْأَيْكَةِ","الغيضة، وهي جماع من الشجر."]]},"181":{"siraj":[["الْمُخْسِرِينَ","النَّاقِصِينَ لِحُقُوقِ النَّاسِ."]]},"182":{"siraj":[["بِالْقِسْطَاسِ","بِالمِيزَانِ."],["الْمُسْتَقِيمِ","العَدْلِ السَّوِيِّ."]],"tibyan":[["بِالْقِسْطاسِ","سبق أنه الميزان بلغة الرّوم ."]]},"183":{"siraj":[["وَلَا تَبْخَسُوا","لَا تَنْقُصُوا."],["وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."]]},"184":{"siraj":[["وَالْجِبِلَّةَ الْأَوَّلِينَ","الخَلِيقَةَ وَالأُمَمَ المَاضِينَ."]],"tibyan":[["وَالْجِبِلَّةَ الْأَوَّلِينَ","خلق الأوّلين."]]},"185":{"siraj":[["الْمُسَحَّرِينَ","مَنْ أَصَابَهُمْ سِحْرٌ شَدِيدٌ، فَذَهَبَ بِعُقُولِهِمْ."]]},"187":{"siraj":[["كِسَفًا","قِطَعًا مِنَ العَذَابِ."]]},"189":{"siraj":[["الظُّلَّةِ","سَحَابَةٍ أَظَلَّتْهُمْ وَجَدُوا تَحْتَهَا بَرْدًا، فَلمَّا اجْتَمَعُوا أَحْرَقَتْهُمْ بِنَارِهَا."]],"tibyan":[["فَأَخَذَهُمْ عَذابُ يَوْمِ الظُّلَّةِ","قيل: إنهم لما كذّبوا شعيبا أصابهمغمّ وحرّ شديد، فرفعت لهم سحابة فخرجوا يستظلّون بها، فسالت عليهم فأهلكتهم.والظّلة: ما غطّى وستر."]]},"193":{"siraj":[["الرُّوحُ الْأَمِينُ","جِبْرِيلُ - عليه السلام -."]],"tibyan":[["الرُّوحُ الْأَمِينُ","جبريل- عليه السلام- سمّي روحا لأن النفوس تحيا به كما تحيا بالأرواح."]]},"196":{"siraj":[["زُبُرِ الْأَوَّلِينَ","كُتُبِ الأَنْبِيَاءِ السَّابِقِينَ."]]},"197":{"siraj":[["آيَةً","عَلَامَةً عَلَى صِحَّةِ نُبُوَّتِكَ."]]},"198":{"siraj":[["الْأَعْجَمِينَ","الَّذِينَ لَا يَتَكَلَّمُونَ العَرَبِيَّةَ."]],"tibyan":[["الْأَعْجَمِينَ","جمع أعجم، وأعجميّ أيضا، إذا كان في لسانه عجمة وإن لم يكن من العجم، ورجل عجميّ: منسوب إلى العجم، ورجل أعرابيّ:إذا كان بدويّا وإن لم يكن من العرب. ورجل عربيّ: منسوب إلى العرب وإن لم يكن بدويّا، قال الفرّاء: الأعجميّ منسوب [إلى] نفسه، من العجمة، كما قالوا للأحمر أحمريّ، وكقوله:والدّهر بالإنسان دوّاريّ إنما هو دوّار."]]},"200":{"siraj":[["سَلَكْنَاهُ","أَدْخَلْنَا التَّكْذِيبَ."]]},"202":{"siraj":[["بَغْتَةً","فَجْأَةً."]]},"203":{"siraj":[["مُنظَرُونَ","مُمْهَلُونَ مُؤَخَّرُونَ."]]},"205":{"siraj":[["أَفَرَأَيْتَ","أَفَعَلِمْتَ؟"]]},"212":{"siraj":[["السَّمْعِ","اسْتِمَاعِ القُرْآنِ مِنَ السَّمَاءِ."],["لَمَعْزُولُونَ","لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ."]]},"215":{"siraj":[["وَاخْفِضْ جَنَاحَكَ","أَلِنْ جَانِبَكَ وَكَلامَكَ تَوَاضُعًا."]]},"218":{"siraj":[["حِينَ تَقُومُ","تُصَلِّي اللَّيْلَ وَحْدَكَ."]]},"222":{"siraj":[["أَفَّاكٍ","كَذَّابٍ."],["أَثِيمٍ","كَثِيرِ الآثَامِ."]]},"223":{"siraj":[["يُلْقُونَ السَّمْعَ","تُلْقِي الشَّيَاطِينُ إِلَى الكُهَّانِ مَا يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلَى."]]},"225":{"siraj":[["وَادٍ","فَنٍّ مِنْ فُنُونِ البَاطِلِ، وَالكَذِبِ."],["يَهِيمُونَ","يَخُوضُونَ."]],"tibyan":[["يَهِيمُونَ","يذهبون على غير قصد، كما يذهب الهائم على وجهه."]]},"227":{"siraj":[["مُنقَلَبٍ","مَرْجِعٍ."]]}}