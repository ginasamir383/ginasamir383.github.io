{"1":{"siraj":[["أَلْهَاكُمُ","شَغَلَكُمْ عَنْ طَاعَةِ اللهِ."],["التَّكَاثُرُ","التَّفَاخُرُ بِكَثْرَةِ الأَمْوَالِ وَالأَوْلَادِ وَالمَتَاعِ."]],"tibyan":[["أَلْهاكُمُ التَّكاثُرُ","شغلكم [زه] والتّكاثر: تفاعل من الكثرة."]]},"2":{"siraj":[["زُرْتُمُ الْمَقَابِرَ","دُفِنْتُمْ فِي القُبُورِ."]]},"5":{"siraj":[["عِلْمَ الْيَقِينِ","حَقَّ العِلْم."]]},"7":{"siraj":[["عَيْنَ الْيَقِينِ","لَتُبْصِرُنَّ جَهَنَّمَ يَقِينًا بِلَا رَيْبٍ."]]},"8":{"siraj":[["النَّعِيمِ","كُلِّ أَنْوَاعِ النِّعَمِ مِنَ الأَمْنِ، وَالأَهْلِ، وَالمَطْعَمِ، وَنَحْوِهَا."]],"tibyan":[["كَلَّا ، ،","أي ليس الأمر كما ظننتم، وهو ردع وزجر."]]}}