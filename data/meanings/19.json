{"3":{"siraj":[["نَادَى","دَعَا."]]},"4":{"siraj":[["وَهَنَ","ضَعُفَ."]],"tibyan":[["وَهَنَ","ضعف."]]},"5":{"siraj":[["الْمَوَالِيَ","أَقَارِبِي وَعَصَبَتِي."],["عَاقِرًا","لَا تَلِدُ."],["وَلِيًّا","وَلَدًا وَارِثًا، وَمُعِينًا يَلِي الأَمْرَ مِنْ بَعْدِي."]],"tibyan":[["عاقِراً","عقيما، أي: لا تلد."]]},"8":{"siraj":[["أَنَّى","كَيْفَ؟"],["عِتِيًّا","النِّهَايَةَ فِي الكِبَرِ، وَاليُبْسِ."]],"tibyan":[["عِتِيًّا","أي يبسا. والعتيّ والعسيّ بمعنى، وكل مبالغ من كبر أو كفر أو فساد فقد عتا وعسا عتيّا وعسيّا وعتوّا وعسوّا ."]]},"10":{"siraj":[["آيَةً","عَلَامَةً عَلَى تَحَقُّقِ مَا بَشَّرَتْنِي بِهِ المَلَائِكَةُ."],["سَوِيًّا","صَحِيحًا، مُعَافًى."]]},"11":{"siraj":[["الْمِحْرَابِ","المُصَلَّى الَّذِي يُتَعَبَّدُ فِيهِ."],["فَأَوْحَى إِلَيْهِمْ","أَشَارَ إِلَيْهِمْ."],["بُكْرَةً وَعَشِيًّا","صَبَاحًا، وَمَسَاءً."]]},"12":{"siraj":[["خُذِ الْكِتَابَ","التَّوْرَاةَ."],["بِقُوَّةٍ","بِجِدٍّ، وَاجْتِهَادٍ؛ حِفْظًا، وَفَهْمًا، وَعَمَلًا."],["الْحُكْمَ","الحِكْمَةَ وَحُسْنَ الفَهْمِ وَالعَمَلِ."]]},"13":{"siraj":[["وَحَنَانًا","رَحْمَةً وَمَحَبَّةً."],["وَزَكَاةً","طَهَارَةً مِنَ الذُّنُوبِ وَبَرَكَةً."]],"tibyan":[["وَحَناناً مِنْ لَدُنَّا","رحمة من عندنا."]]},"14":{"tibyan":[["جَبَّاراً","متكبّرا."]]},"16":{"siraj":[["انتَبَذَتْ","اعْتَزَلَتْ وَابْتَعَدَتْ."]],"tibyan":[["انْتَبَذَتْ مِنْ أَهْلِها","اعتزلتهم ناحية، يقال: قعد نبذة ونبذة أي ناحية ."]]},"17":{"siraj":[["رُوحَنَا","جِبْرِيلَ - عليه السلام -."],["سَوِيًّا","تَامَّ الخَلْقِ."]],"tibyan":[["رُوحَنا","جبريل عليه السلام."]]},"19":{"siraj":[["زَكِيًّا","طَاهِرًا مِنَ الذُّنُوبِ مُبَارَكًا."]]},"20":{"siraj":[["بَغِيًّا","زَانِيَةً."]],"tibyan":[["بَغِيًّا","فاجرة."]]},"22":{"tibyan":[["قَصِيًّا","بعيدا."]]},"23":{"siraj":[["فَأَجَاءَهَا","فَأَلْجَأَهَا طَلْقُ الحَمْلِ."],["الْمَخَاضُ","الحَمْلُ."]],"tibyan":[["فَأَجاءَهَا الْمَخاضُ","جاء بها. والْمَخاضُ: تمخّض الولد في بطن أمّه، أي تحرّكه للخروج."],["نَسْياً","النّسي: الشيء الحقير الذي إذا ألقي نسي ولم يلتفت إليه."]]},"24":{"siraj":[["سَرِيًّا","جَدْوَلَ مَاءٍ."]],"tibyan":[["سَرِيًّا","أي نهرا بلغة توافق السريانية ، وهذا قول الجمهور: إنه النّهر الصغير، وقيل: الرجل الكريم، وهو عيسى عليه السلام."]]},"25":{"siraj":[["جَنِيًّا","غَضًّا جُنِيَ مِنْ سَاعَتِهِ."]],"tibyan":[["جَنِيًّا","غضّا. ويقال: جنيّ: أي مجنيّ: طريّ ."]]},"26":{"siraj":[["وَقَرِّي عَيْنًا","وَطِيبِي نَفْسًا."]],"tibyan":[["صَوْماً","أي صمتا، والصّوم: الإمساك عن الطّعام والكلام ونحوهما."]]},"27":{"siraj":[["فَرِيًّا","أَمْرًا عَظِيمًا مُفْتَرًى."]],"tibyan":[["فَرِيًّا","أي عجبا، ويقال: عظيما."]]},"28":{"siraj":[["بَغِيًّا","زَانِيَةً."]]},"31":{"siraj":[["مُبَارَكًا","عَظِيمَ الخَيْرِ وَالنَّفْعِ."]]},"34":{"siraj":[["يَمْتَرُونَ","يَشُكُّونَ."]]},"37":{"siraj":[["الْأَحْزَابُ","الفِرَقُ مِنْ أَهْلِ الكِتَابِ."],["فَوَيْلٌ","فَهَلَاكٌ."],["مَّشْهَدِ","شُهُودِ."]]},"38":{"siraj":[["أَسْمِعْ بِهِمْ وَأَبْصِرْ","مَا أَشَدَّ سَمْعَهُمْ وَبَصَرَهُمْ!"]],"tibyan":[["أَسْمِعْ بِهِمْ وَأَبْصِرْ","أي ما أسمعهم وأبصرهم. وكذلك قوله:أَبْصِرْ بِهِ وَأَسْمِعْ : ما أبصره وأسمعه."]]},"39":{"siraj":[["الْحَسْرَةِ","النَّدَامَةِ."]]},"41":{"siraj":[["صِدِّيقًا","عَظِيمَ الصِّدْقِ لَا يَكْذِبُ."]]},"43":{"siraj":[["صِرَاطًا سَوِيًّا","طَرِيقًا لَا عِوَجَ فِيهِ."]]},"45":{"siraj":[["وَلِيًّا","قَرِينًا فِي النَّارِ."]]},"46":{"siraj":[["مَلِيًّا","زَمَنًا طَوِيلًا."]],"tibyan":[["وَاهْجُرْنِي مَلِيًّا","أي حينا طويلا."]]},"47":{"siraj":[["حَفِيًّا","رَحِيمًا بِحَالِي يُكْرِمُنِي وَيُجِيبُنِي إِذَا دَعَوْتُهُ."]],"tibyan":[["إِنَّهُ كانَ بِي حَفِيًّا","أي بارّا معنيّا ."]]},"50":{"siraj":[["لِسَانَ صِدْقٍ عَلِيًّا","ذِكْرًا حَسَنًا، وَثَنَاءً بَاقِيًا فِي النَّاسِ."]]},"51":{"siraj":[["مُخْلَصًا","مُصْطَفًى مُخْتَارًا."]]},"52":{"siraj":[["الطُّورِ","جَبَلٌ بِسَيْنَاءَ."],["نَجِيًّا","مُنَاجِيًا لَنَا."]],"tibyan":[["نَجِيًّا","من النّجوى، أي مناجيا، وقيل: من النّجوة وهو الارتفاع."]]},"58":{"siraj":[["وَإِسْرَائِيلَ","يَعْقُوبَ - عليه السلام -."],["وَاجْتَبَيْنَا","اصْطَفَيْنَا."]],"tibyan":[["بُكِيًّا","جمع باك، أصله، «بكوي» على وزن «فعول» .فأدغمت الواو في الياء فصارت «بكيّا» ."]]},"59":{"siraj":[["خَلْفٌ","أَتْبَاعُ سُوءٍ."],["غَيًّا","شَرًّا وَخَيْبَةً فِي جَهَنَّمَ."]]},"61":{"siraj":[["مَاتِيًّا","آتِيًا لَا مَحَالَةَ."]]},"62":{"siraj":[["لَغْوًا","بَاطِلًا."]]},"63":{"siraj":[["نُورِثُ","نُعْطِي."]]},"65":{"siraj":[["وَاصْطَبِرْ","الْزَمِ الصَّبْرَ."],["سَمِيًّا","مَثِيلًا، وَمُضَاهِيًا، فِي ذَاتِهِ، وَصِفَاتِهِ."]]},"68":{"siraj":[["جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ مِنَ الهَوْلِ."]]},"69":{"siraj":[["شِيعَةٍ","طَائِفَةٍ."],["عِتِيًّا","تَمَرُّدًا وَعِصْيَانًا."]]},"70":{"siraj":[["صِلِيًّا","دُخُولًا، وَمُقَاسَاةً لِحَرِّهَا."]]},"71":{"siraj":[["وَارِدُهَا","مَارًّا بِالصِّرَاطِ المَنْصُوبِ عَلَى مَتْنِ جَهَنَّمَ."],["حَتْمًا","مَحْتُومًا لَازِمًا."]]},"72":{"siraj":[["جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ."]]},"73":{"siraj":[["مَّقَامًا","مَنْزِلًا."],["نَدِيًّا","مَجْلِسًا."]]},"74":{"siraj":[["قَرْنٍ","أُمَّةٍ."],["أَثَاثًا","مَتَاعًا."],["وَرِئْيًا","مَنْظَرًا، وَمَرْأًى."]],"tibyan":[["رِءْياً","هو بهمزة ساكنة قبل الياء: ما رأيت عليه من شارة حسنة وهيئة. وهو بغير همز يجوز أن يكون على معنى الأوّل وأن يكون من الرّيّ، أي منظرهم مرتو من النعمة. وزيّا بالزاي يعني هيئة ومنظرا. وقد قرئت بهذه الأوجه الثلاثة ."]]},"75":{"siraj":[["فَلْيَمْدُدْ","فَلْيُمْهِلْهُ، وَلْيُمْلِ لَهُ؛ اسْتِدْرَاجًا."]]},"76":{"siraj":[["وَالْبَاقِيَاتُ","الأَعْمَالُ الصَّالِحَاتُ."],["مَّرَدًّا","مَرْجِعًا، وَعَاقِبَةً."]]},"77":{"siraj":[["أَفَرَأَيْتَ","أَعَلِمْتَ؟"]]},"79":{"siraj":[["وَنَمُدُّ لَهُ","نَزِيدُ لَهُ."]]},"81":{"siraj":[["عِزًّا","شُفَعَاءَ، وَأَنْصَارًا."]]},"83":{"siraj":[["تَؤُزُّهُمْ أَزًّا","تَدْفَعُهُمْ عَنِ الطَّاعَةِ، وَتُغْرِيهِمْ بِالمَعْصِيَةِ."]],"tibyan":[["تَؤُزُّهُمْ أَزًّا","تزعجهم إزعاجا."]]},"85":{"siraj":[["نَحْشُرُ","نَجْمَعُ."],["وَفْدًا","وُفُودًا مُكْرَمِينَ عَلَى الرِّكَابِ وَالرَّوَاحِلِ."]],"tibyan":[["وَفْداً","ركبانا على الإبل، واحدهم وافد."]]},"86":{"siraj":[["وِرْدًا","مُشِاةً عِطَاشًا."]],"tibyan":[["وِرْداً","مصدر: ورد يرد وردا ، وفي التفسير وَنَسُوقُ الْمُجْرِمِينَ إِلى جَهَنَّمَ وِرْداً أي عطاشا."]]},"89":{"siraj":[["إِدًّا","شَيْئًا عَظِيمًا مُنْكَرًا."]],"tibyan":[["إِدًّا","الإدّ: العظيم من الكفر، وأصله الدّاهية. وقيل: أعظم الدواهي، تقول: أدّ الأمر يئدّ إدّا، إذا عظم. وقيل: الإدّ: المنكر."]]},"90":{"siraj":[["يَتَفَطَّرْنَ","يَتَشَقَّقْنَ."],["وَتَخِرُّ الْجِبَالُ هَدًّا","تَسْقُطُ سُقُوطًا شَدِيدًا."]],"tibyan":[["وَتَخِرُّ الْجِبالُ هَدًّا","سقوطا."]]},"92":{"siraj":[["وَمَا يَنبَغِي","مَا يَلِيقُ، وَمَا يَصْلُحُ."]]},"96":{"siraj":[["وُدًّا","مَحَبَّةً فِي قُلُوبِ عِبَادِهِ."]],"tibyan":[["وُدًّا","محبّة في قلوب العباد."]]},"97":{"siraj":[["لُّدًّا","شَدِيدِي الخُصُومَةِ بِالبَاطِلِ."]],"tibyan":[["قَوْماً لُدًّا","جمع ألدّ، وهو الشّديد الخصومة."]]},"98":{"siraj":[["قَرْنٍ","أُمَّةٍ."],["تُحِسُّ","تَرَى، وَتَجِدُ."],["رِكْزًا","صَوْتًا خَفِيًّا."]],"tibyan":[["أَوْ تَسْمَعُ لَهُمْ رِكْزاً","أي صوتا خفيّا."]]}}