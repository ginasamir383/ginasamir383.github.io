{"1":{"siraj":[["سَبَّحَ لِلَّهِ","نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِجَلَالِهِ سُبْحَانَهُ."]]},"3":{"siraj":[["كَبُرَ مَقْتًا","عَظُمَ بُغْضًا."]],"tibyan":[["كَبُرَ مَقْتاً","عظم بغضا."]]},"4":{"siraj":[["صَفًّا","صَافِّينَ صَفًّا."],["مَّرْصُوصٌ","مُتَرَاصٌّ مُحْكَمٌ لَا فُرْجَةَ فِيهِ، وَلَا يَنْفُذُ فِيهِ العَدُوُّ."]],"tibyan":[["بُنْيانٌ مَرْصُوصٌ","لاصق بعضه ببعض لا يغادر شيء منه شيئا."]]},"5":{"siraj":[["زَاغُوا","عَدَلُوا عَنِ الحَقِّ، مَعَ عِلْمِهِمْ بِهِ."],["أَزَاغَ اللَّهُ قُلُوبَهُمْ","صَرَفَهَا عَنْ قَبُولِ الحَقِّ؛ جَزَاءً عَلَى زَيْغِهِمْ."]],"tibyan":[["فَلَمَّا زاغُوا أَزاغَ اللَّهُ قُلُوبَهُمْ","أي فلمّا مالوا عن الحقّ والطاعة، أمال الله قلوبهم عن الخير والإيمان."]]},"6":{"siraj":[["لِّمَا بَيْنَ يَدَيَّ","لِمَا جَاءَ قَبْلِي."],["بِالْبَيِّنَاتِ","بِالآيَاتِ الوَاضِحَاتِ."]]},"7":{"siraj":[["وَمَنْ أَظْلَمُ","لَا أَحَدَ أَشَدُّ ظُلْمًا، وَعُدْوَانًا."],["افْتَرَى","اخْتَلَقَ."],["يُدْعَى إِلَى الْإِسْلَامِ","يُدْعَى إِلَى الدُّخُولِ فِي الإِسْلَامِ."]]},"8":{"siraj":[["نُورَ اللَّهِ","الحَقَّ الَّذِي جَاءَ بِهِ الرَّسُولُ - صلى الله عليه وسلم -."],["بِأَفْوَاهِهِمْ","بِأَقْوَالِهِمُ الكَاذِبَةِ."],["مُتِمُّ نُورِهِ","مُظْهِرٌ الحَقَّ بِإِتْمَامِ دِينِهِ."]]},"9":{"siraj":[["لِيُظْهِرَهُ","لِيُعْلِيَهُ."],["الدِّينِ كُلِّهِ","الأَدْيَانِ المُخَالِفَةِ كُلِّهَا."]]},"13":{"siraj":[["وَأُخْرَى","وَنِعْمَةٌ أُخْرَى لَكُمْ."]]},"14":{"siraj":[["لِلْحَوَارِيِّينَ","أَصْفِيَاءِ عِيسَى - عليه السلام -، وَخَوَاصِّهِ."],["فَأَيَّدْنَا","قَوَّيْنَا، وَنَصَرْنَا."],["ظَاهِرِينَ","غَالِبِينَ."]]}}