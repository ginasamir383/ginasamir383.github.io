{"1":{"siraj":[["فَاطِرِ","خَالِقِ، وَمُبْدِعِ."],["أُولِي","أَصْحَابَ."]],"tibyan":[["فاطِرِ السَّماواتِ وَالْأَرْضِ","خالقهما، قال ابن عيسى: الفطر:الشّقّ عن الشيء بإظهاره للحس ."],["أُولِي أَجْنِحَةٍ مَثْنى وَثُلاثَ وَرُباعَ","أي لبعضهم جناحان ولبعضهم ثلاثة، ولبعضهم أربعة . وأجنحة جمع جناح مشتق من جنح، إذا مال. ومدلول.مثنى: اثنين اثنين. وثلاث: ثلاثة ثلاثة. ورباع: أربعة أربعة، كما سبق في سورة النساء ."]]},"3":{"siraj":[["فَأَنَّى تُؤْفَكُونَ","كَيْفَ تُصْرَفُونَ عَنْ تَوْحِيدِهِ؟!"]]},"5":{"siraj":[["فَلَا تَغُرَّنَّكُمُ","لَا تَخْدَعَنَّكُمْ، وَلَا تُلْهِيَنَّكُمْ."],["الْغَرُورُ","الشَّيْطَانُ."]]},"6":{"siraj":[["حِزْبَهُ","أَتْبَاعَهُ."]]},"8":{"siraj":[["فَلَا تَذْهَبْ نَفْسُكَ","فَلَا تُهْلِكْهَا."],["حَسَرَاتٍ","حُزْنًا عَلَى كُفْرِ هَؤْلَاءِ الضَّالِّينَ."]]},"9":{"siraj":[["فَتُثِيرُ","تُحَرِّكُ."],["مَّيِّتٍ","مُجْدِبٍ."]]},"10":{"siraj":[["الْعِزَّةَ","الشَّرَفَ، وَالمَنَعَةَ."],["الْكَلِمُ الطَّيِّبُ","الكَلَامُ الحَسَنُ؛ وَهُوَ ذِكْرُ اللهِ."],["يَبُورُ","يَفْسُدُ، وَيَبْطُلُ."]]},"11":{"siraj":[["أَزْوَاجًا","ذُكُورًا وَإِنَاثًا."],["مُّعَمَّرٍ","طَوِيلِ العُمُرِ."],["فِي كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]],"tibyan":[["يَسِيرٌ","أي سهل لا يصعب. واليسير أيضا: القليل."]]},"12":{"siraj":[["فُرَاتٌ","شَدِيدُ العُذُوبَةِ."],["سَائِغٌ","سَهْلٌ مُرُورُهُ فِي الحَلْقِ."],["أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],["لَحْمًا طَرِيًّا","هُوَ: السَّمَكُ."],["حِلْيَةً","هِيَ: اللُّؤْلُؤُ، وَالمَرْجَانُ."],["الْفُلْكَ","السُّفُنَ."],["مَوَاخِرَ","تَشُقُّ المِيَاهَ."]],"tibyan":[["مَواخِرَ","فواعل، من مخرت السّفينة، إذا جرت فشقّت الماء بصدرها، ومنه: مخر الأرض إنما هو شقّ الماء لها."]]},"13":{"siraj":[["يُولِجُ","يُدْخِلُ مِنْ سَاعَاِت اللَّيْلِ فيِ النَّهَارِ، وَالعَكْسُ، فَتَحْدُثُ الزِّيَادَةُ وَالنَّقْصُ فِيهِمَا."],["وَسَخَّرَ","ذَلَّلَ."],["لِأَجَلٍ مُّسَمًّى","لِوَقْتٍ مَعْلُومٍ مُقَدَّرٍ."],["قِطْمِيرٍ","هِيَ: القِشْرَةُ الرَّقِيقَةُ البَيْضَاءُ عَلَى النَّوَاةِ."]],"tibyan":[["مِنْ قِطْمِيرٍ","هو لفافة النّواة."]]},"14":{"siraj":[["يَكْفُرُونَ بِشِرْكِكُمْ","يَتَبَرَّؤُونَ مِنْكُمْ."]]},"18":{"siraj":[["وَلَا تَزِرُ","لَا تَحْمِلُ."],["وَازِرَةٌ","نَفْسٌ مُذْنِبَةٌ."],["وِزْرَ أُخْرَى","ذَنْبَ نَفْسٍ أُخْرَى."],["تَدْعُ","تَسْأَلْ."],["مُثْقَلَةٌ","نَفْسٌ مُثْقَلَةٌ بِالخَطَايَا."],["حِمْلِهَا","ذُنُوبِهَا الَّتي أَثْقَلَتْهَا."],["تَزَكَّى","تُطَهُّرَ مِنَ الشِّرْكِ وَالمَعَاصِي."],["الْمَصِيرُ","المَآلُ والمَرْجِعُ."]]},"21":{"siraj":[["الْحَرُورُ","الرِّيحُ الحَارَّةُ."]],"tibyan":[["وَلَا الْحَرُورُ","أي الرّيح الحارّة تهبّ باللّيل، وقد تكون بالنهار.والسّموم بالنهار، وقد تكون بالليل."]]},"25":{"siraj":[["وَبِالزُّبُرِ","الكُتُبِ المَجْمُوعِ فِيهَا كَثِيرٌ مِنَ الأَحْكَامِ."]]},"26":{"siraj":[["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَعُقُوبَتِي لَهُمْ."]],"tibyan":[["نَكِيرِ","إنكاري."]]},"27":{"siraj":[["جُدَدٌ","ذَاتُ طَرَائِقَ وَخُطُوطٍ مُخْتَلِفَةِ الأَلْوَانِ."],["وَغَرَابِيبُ سُودٌ","شَدِيدَةُ السَّوَادِ؛ كَالأَغْرِبَةِ."]],"tibyan":[["جُدَدٌ","خطوط وطرائق، واحدها جدّة."],["غَرابِيبُ سُودٌ","هو مقدّم مؤخّر: معناه: سود غرابيب، يقال:أسود غربيب للشّديد السّواد ."]]},"29":{"siraj":[["لَّن تَبُورَ","لَنْ تَكْسُدَ، وَتَهْلِكَ."]]},"31":{"siraj":[["لِّمَا بَيْنَ يَدَيْهِ","مِنَ الكُتُبِ السَّابِقَةِ."]]},"32":{"siraj":[["أَوْرَثْنَا","أَعْطَيْنَا."],["ظَالِمٌ لِّنَفْسِهِ","بِفِعْلِ بَعْضِ المَعَاصِي."],["مُّقْتَصِدٌ","يُؤَدِّي الوَاجِبَاتِ، ويَجْتَنِبُ المُحَرَّمَاتِ."],["سَابِقٌ بِالْخَيْرَاتِ","مُجْتَهِدٌ فِي عَمَلِ الصَّالِحَاتِ: فَرْضِهَا وَنَفْلِهَا."]]},"33":{"siraj":[["عَدْنٍ","إِقَامَةٍ."]]},"35":{"siraj":[["أَحَلَّنَا","أَنْزَلَنَا."],["دَارَ الْمُقَامَةِ","دَارَ الإِقَامَةِ الدَّائِمَةِ."],["نَصَبٌ","تَعَبٌ، وَمَشَقَّةٌ."],["لُغُوبٌ","إِعْيَاءٌ وَتَعَبٌ."]],"tibyan":[["نَصَبٌ","وجع، وقيل: تعب ."],["لُغُوبٌ","كلال يلحق الجوارح. وقيل: النّصب على القلب، واللّغوب على البدن."]]},"37":{"siraj":[["يَصْطَرِخُونَ","يَصِيحُونَ بِشِدَّةٍ، وَيَسْتَغِيثُونَ."],["النَّذِيرُ","نَبِيُّنَا مُحَمَّدٌ - صلى الله عليه وسلم -."]],"tibyan":[["أَوَلَمْ نُعَمِّرْكُمْ ما يَتَذَكَّرُ فِيهِ مَنْ تَذَكَّرَ وَجاءَكُمُ النَّذِيرُ","قال قتادة:احتج عليهم بطول العمر وبالرسول . وقد قيل: النّذير: الشّيب . وليس هذا القول بشيء لأن الحجّة تلحق كلّ بالغ، وإن لم يشب، وإن كانت العرب تسمّي الشّيب النّذير."]]},"39":{"siraj":[["خَلَائِفَ","يَخْلُفُ بَعْضُكُمْ بَعْضًا فِي الأَرْضِ."],["مَقْتًا","بُغْضًا وَغَضَبًا."]]},"40":{"siraj":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["بَيِّنَةٍ مِّنْهُ","حُجَّةٍ مِنْهُ."],["غُرُورًا","خِدَاعًا وَبَاطِلًا."]]},"42":{"siraj":[["جَهْدَ أَيْمَانِهِمْ","مُجْتَهِدِينَ في الحَلِفِ بِأَغْلَظِ الأَيْمَانِ."],["نَذِيرٌ","رَسُولٌ مِنْ عِنْدِ اللهِ تَعَالَى."]]},"43":{"siraj":[["يَحِيقُ","يُحِيطُ، وَيَنْزِلُ."],["يَنظُرُونَ","يَنْتَظِرُونَ."],["سُنَّتَ الْأَوَّلِينَ","العَذَابَ الَّذِي نَزَلَ بِأَمْثَالِهِمْ."]],"tibyan":[["يَحِيقُ","يحيط."]]},"44":{"tibyan":[["يس","قيل: معناه يا إنسان بلغة طيّئ. وقيل: يا رجل، وقيل:يا محمّد، وقيل: مجازها مجاز سائر الحروف الهجائية في أوائل السّور ."]]}}