{"4":{"siraj":[["يَبُثُّ","يَنْشُرُ، وَيُفَرِّقُ."]]},"5":{"siraj":[["وَتَصْرِيفِ الرِّيَاحِ","تَقْلِيبِهَا فيِ مَهَابِّهَا لِمَنْفَعَتِكُمْ."]]},"7":{"siraj":[["وَيْلٌ","هَلَاكٌ، وَدَمَارٌ."],["أَفَّاكٍ","كَذَّابٍ."],["أَثِيمٍ","كَثِيرِ الإِثْمِ."]],"tibyan":[["أَفَّاكٍ","كثير الكذب ."],["أَثِيمٍ","كثير الإثم."]]},"9":{"siraj":[["هُزُوًا","سُخْرِيَةً."]]},"12":{"siraj":[["الْفُلْكُ","السُّفُنُ."]]},"14":{"siraj":[["لا يَرْجُون أَيَّامَ اللَّهِ","لَا يَتَوَقَّعُونَ وَقَائِعَهُ وَعَذَابَهُ بِأَعْدَائِهِ."]]},"16":{"siraj":[["الْكِتَابَ","التَّوْرَاةَ، وَالإِنْجِيلَ."],["وَالْحُكْمَ","تَحْكِيمَهُمَا."]]},"17":{"siraj":[["بَيِّنَاتٍ مِّنَ الْأَمْرِ","شَرَائِعَ وَاضِحَاتٍ فيِ الحَلَالِ، وَالحَرَامِ، وَدَلَالَاتٍ تُبَيِّنُ الحَقَّ مِنَ البَاطِلِ."],["بَغْيًا بَيْنَهُمْ","حَسَدًا وَعَدَاوَةً بَيْنَهُمْ."]]},"18":{"siraj":[["شَرِيعَةٍ مِّنَ الْأَمْرِ","مِنْهَاجٍ وَاضِحٍ مِنْ أَمْرِ الدِّينِ."]],"tibyan":[["شَرِيعَةٍ مِنَ الْأَمْرِ","أي سنّة وطريقة."]]},"19":{"siraj":[["لَن يُغْنُوا عَنكَ","لَنْ يَدْفَعُوا عَنْكَ."]]},"20":{"siraj":[["بَصَائِرُ","يُبْصِرُ بِهِ النَّاسُ الحَقَّ."]]},"21":{"siraj":[["أمْ حَسِبَ","بَلْ ظَنَّ."],["اجْتَرَحُوا","اكْتَسَبُوا."]],"tibyan":[["اجْتَرَحُوا","اكتسبوا."]]},"23":{"siraj":[["أَفَرَأَيْتَ","أَخْبِرْنِي."],["وَخَتَمَ","طَبَعَ."],["غِشَاوَةً","غِطَاءً."]],"tibyan":[["اتَّخَذَ إِلهَهُ هَواهُ","أي ما تميل نفسه إليه فأطاعه. وكذلك الهوى في المحبة إنما هو ميل النّفس إلى من تحبّه ."]]},"24":{"tibyan":[["وَما يُهْلِكُنا إِلَّا الدَّهْرُ","أي السنين والأيام."]]},"26":{"siraj":[["لَا رَيبَ فِيهِ","لَا شَكَّ فِيهِ."]]},"28":{"tibyan":[["جاثِيَةً","باركة على الرّكب، وتلك جلسة المخاصم والمجادل، ومنه قول علي- رضي الله عنه-: «أنا أوّل من يجثو للخصومة» ."]]},"29":{"tibyan":[["نَسْتَنْسِخُ","نثبت. ونستنسخ: نأخذ نسخته وذلك أن الملكين يرفعان عمل الإنسان صغيره وكبيره ليثبت الله منه ما كان له ثواب وعقاب، ويطرح اللغو نحو قولهم: هلمّ، واذهب، وتعال."]]},"32":{"siraj":[["إِن نَّظُنُّ إِلَّا ظَنًّا","مَا نَتَوَقَّعُ وُقُوعَهَا إِلَّا تَوَهُّمًا."]],"tibyan":[["إِنْ نَظُنُّ إِلَّا ظَنًّا","ما نظن إلا ظنّا لا يؤدي إلى يقين، إنما يخرجنا إلى ظن مثله."]]},"33":{"siraj":[["وَحَاقَ بِهِم","نَزَلَ بِهِمْ."]]},"34":{"siraj":[["نَنسَاكُمْ","نَتْرُكُكُمْ فِي العَذَابِ."],["وَمَاوَاكُمْ","مَنْزِلُكُمْ وَمَقرُّكُمْ."]]},"35":{"siraj":[["وَغَرَّتْكُمُ","خَدَعَتْكُمْ."],["وَلَا هُمْ يُسْتَعْتَبُونَ","لَا يُطْلَبُ مِنْهُمْ أَنْ يُرْضُوا رَبَّهُمْ بِالتَّوْبَةِ، وَالطَّاعَةِ."]],"tibyan":[["يُسْتَعْتَبُونَ","يطلب منهم العتبى."]]},"37":{"siraj":[["الْكِبْرِيَاءُ","العَظَمَةُ، وَالسُّلْطَانُ، وَالقُدْرَةُ."]],"tibyan":[["الْكِبْرِياءُ","أي العظمة والملك."]]}}